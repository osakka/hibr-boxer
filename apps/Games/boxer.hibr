#!/usr/bin/env hibr
#
# boxer -- DOS games, one folder to a game, in the way Boxer keeps them on a
# Mac. A game lives in a folder of its own, NAME.boxer, holding the game's
# drive C, its box art (.cover.png), the person's DOSBox settings and the
# game's saves. The games folder is ~/Dos Games, and Control Panel > Boxer (or
# BX_SHELF) names another. Files shows the folders, and a double click on one
# plays it, in a window of its own (boxerplay); a right click offers Get Info,
# where the program, sound card, MIDI, graphics and the game's name are set.
#
# This window is for getting a game in. Drop a folder, a zip, a disc image or a
# program on it, or choose one with Import, and it is made into a NAME.boxer the
# way Boxer does it: an installer is run first, from the game's disc as D:.
#
# A tribute to Boxer, by Alun Bestor (https://boxerapp.com).

strict


app boxer "DOS games, one folder to a game" 1.13
# modules: img retro
# part: apps/boxerplay.hibr
# part: control-panel/boxerset.hibr
command -v dt_app > /dev/null && dt_app boxer "Boxer" 21 72 "" "▣" fixed
command -v dt_app > /dev/null && dt_app boxerabout "About Boxer" 24 78 "" "" fixed hidden
command -v dt_app > /dev/null && dt_app boxercover "Fetch Cover" 10 66 "" "" fixed hidden
command -v dt_app > /dev/null && dt_app boxerdone "Game Is Already Installed" 10 66 "" "" fixed hidden
command -v dt_app > /dev/null && dt_app boxerinfo "Game Settings" 20 60 "" "" fixed hidden
command -v dt_keepstate > /dev/null && dt_keepstate boxer BX
command -v dt_opener > /dev/null && dt_opener boxerplay "Boxer" "boxer" app boxerplay dir
command -v dt_openerverb > /dev/null && dt_openerverb boxer "Get Info..." boxerinfo
command -v dt_openerverb > /dev/null && dt_openerverb boxer "Fetch Cover..." boxercover
command -v dt_openerverb > /dev/null && dt_openerverb boxer "Game Is Already Installed..." boxerdone

declare -gA BX BXJ
BX_TO=
# The default shelf is a folder called Dos Games in the person's home -- unless
# a shelf from before it was called that is there and the new one is not, in
# which case that one is kept, so nothing goes missing. Control Panel > Boxer
# changes it.
fn bx_defshelf() {
	local old="${XDG_DATA_HOME:-$HOME/.local/share}/hibr/shelf"

	if [ ! -d "$HOME/Dos Games" ] && [ -d "$old" ]; then
		ret "$old"
	else
		ret "$HOME/Dos Games"
	fi
}
[ -n "${BX_SHELF-}" ] || { BX_SHELF := bx_defshelf; }
command -v dt_keep > /dev/null && dt_keep BX_SHELF


# A box's own title, from the document just parsed, else the folder's name.
fn bx_title(def) {
	local v

	v := json get BXJ .title 2> /dev/null || v=
	[ -n "$v" ] && ret "$v" || ret "$def"
}

# A name for a new box that is not on the shelf yet.
fn bx_unique(name) {
	local n=$name k=2

	while [ -e "${BX_TO:-$BX_SHELF}/$n.boxer" ] || [ -e "${BX_TO:-$BX_SHELF}/$n.gamebox" ]; do
		n="$name $k"
		k=$((k + 1))
	done
	ret "$n"
}

# Whether a name is one DOS can hold as it is: eight characters, a dot and
# three, of the letters DOS allows.
fn bx_is8(name) {
	match "$name" '^[A-Za-z0-9_$~!#%&()@^{}`-]{1,8}(\.[A-Za-z0-9_$~!#%&()@^{}`-]{1,3})?$'
}

# A name DOS can hold, made from one it cannot: the letters it allows, eight
# of them and three after the last dot, and a ~N in place of the end of the
# base when another name in the folder already has it.
fn bx_dosname(dir, name) {
	local base=$name ext= cand n=0 stem

	case $name in
	*.*) base=${name%.*}; ext=${name##*.} ;;
	esac
	base=${base//[^A-Za-z0-9_\$~!#%&()@^\{\}\`-]/}
	ext=${ext//[^A-Za-z0-9_\$~!#%&()@^\{\}\`-]/}
	[ -n "$base" ] || base=GAME
	stem=${base:0:8}
	cand=$stem${ext:+.${ext:0:3}}
	while [ -n "$(find "$dir" -maxdepth 1 -iname "$cand" 2> /dev/null)" ]; do
		n=$((n + 1))
		cand=${base:0:6}~$n${ext:+.${ext:0:3}}
	done
	ret "$cand"
}

# A game packaged for DOSBox often keeps its files in a folder that is the
# drive itself -- C.harddisk, harddisk, drive_c -- to be mounted as C:. When
# the box has exactly one such folder, its contents are the drive: moved up,
# so the DOS path is C:\PRICEOF\ and not C:\C.HARDDISK\PRICEOF\.
fn bx_hoist(root) {
	local d n lo hit= k=0

	for d in "$root"/*/; do
		d=${d%/}
		[ -d "$d" ] || continue
		n=${d##*/}
		lo=${n,,}
		case $lo in
		c | c.harddisk | harddisk | drive_c | drivec | c_drive | c-drive | cdrive) hit=$d; k=$((k + 1)) ;;
		esac
	done
	[ "$k" = 1 ] || return 0
	for d in "$hit"/* "$hit"/.[!.]*; do
		[ -e "$d" ] || continue
		[ -e "$root/${d##*/}" ] && return 0
	done
	for d in "$hit"/* "$hit"/.[!.]*; do
		[ -e "$d" ] && command mv -- "$d" "$root/"
	done
	command rmdir "$hit" 2> /dev/null
	return 0
}

# Rename what DOS cannot hold as it is, from the bottom up, so the DOS path
# to a program is the real one: a game's folder with a dot or a space in its
# name was shown by DOSBox as C~1.HAR and the program was not found where its
# own name said. A DOS program cannot ask for a longer name, so nothing it
# uses is touched; what changes is the wrapper folders a modern download
# arrives in.
fn bx_dosify(root) {
	local f d n new

	find "$root" -depth -mindepth 1 2> /dev/null | while IFS= read -r f; do
		d=${f%/*}
		n=${f##*/}
		bx_is8 "$n" && continue
		new := bx_dosname "$d" "$n"
		command mv -- "$f" "$d/$new"
	done
	return 0
}

# --- box art --------------------------------------------------------------------
#
# A box's cover is .cover.png in it (cover.png is read too): the person's own
# when they put one there, else, when Control Panel > Boxer says to fetch
# box art, the libretro thumbnails project's picture for the game's name
# (https://thumbnails.libretro.com/DOS/Named_Boxarts/). Fetching sends the
# game's name to that server, so it is off until it is turned on; a cover that
# is already there is never replaced. What comes back is checked to be a
# PNG of a sane size before it is kept (a real cover is tens of KB; 60 bytes is
# only less than the smallest PNG there is). Fetching waits on the network, up
# to half a minute a download, as an import waits on its copying.

declare -gA BCJ
BX_ART="${BX_ART-off}"
command -v dt_keep > /dev/null && dt_keep BX_ART

# The cover a box has, or nothing.
fn bc_path(box) {
	local f

	for f in "$box/.cover.png" "$box/cover.png"; do
		[ -r "$f" ] && { ret "$f"; return 0; }
	done
	return 1
}

# Where the list of names is kept, and where it is fetched from.
fn bc_cache() {
	ret "${XDG_CACHE_HOME:-$HOME/.cache}/hibr/boxer"
}

fn bc_url() {
	ret "${BX_ART_URL:-https://thumbnails.libretro.com/DOS/Named_Boxarts/}"
}

# The server's list of covers as a file of "name<TAB>encoded name" lines, made
# when there is none or the one there is over a month old.
fn bc_list() {
	local dir lst raw f n url

	dir := bc_cache
	url := bc_url
	lst="$dir/dos-boxarts.lst"
	if [ -s "$lst" ] && [ -z "$(find "$lst" -mtime +30 2> /dev/null)" ]; then
		ret "$lst"
		return 0
	fi
	mkdir -p "$dir" || return 1
	raw="$lst.part"
	bc_get "$url" "$raw" 4000000 || { command rm -f -- "$raw"; return 1; }
	grep -o 'href="[^"]*\.png"' "$raw" | sed -e 's/^href="//' -e 's/"$//' -e 's/&amp;/\&/g' > "$raw.enc"
	[ -s "$raw.enc" ] || { command rm -f -- "$raw" "$raw.enc"; return 1; }
	: > "$raw.dec"
	while IFS= read -r f; do
		n=${f//\\/%5C}
		printf '%b\n' "${n//%/\\x}" >> "$raw.dec"
	done < "$raw.enc"
	paste -d '\t' "$raw.dec" "$raw.enc" > "$lst"
	command rm -f -- "$raw" "$raw.enc" "$raw.dec"
	ret "$lst"
}

# One download, to a file, from a server over https (http only when the place
# to fetch from was named by hand), no bigger than max bytes.
fn bc_get(url, out, int max) {
	local pr='=https'

	[ -n "${BX_ART_URL-}" ] && pr='=http,https'
	command -v curl > /dev/null || return 1
	curl -fsSL --proto "$pr" --proto-redir "$pr" --max-time 30 --max-filesize "$max" -o "$out" -- "$url" 2> /dev/null
}

# Which of the listed covers is the game's: the names are compared lower case,
# without the (year), the punctuation, or a ", The" at the end. The same name
# wins; failing that, for a game whose name ends in a number ("Larry 2"), the
# shortest name that starts with it, which is the one with its subtitle. A
# series name alone is not guessed at, a wrong cover being worse than none.
# Gives the encoded file name, or nothing.
fn bc_match(title, lst) {
	local r

	r=$(awk -F '\t' -v t="$title" '
	function norm(s,   x) {
		x = tolower(s)
		sub(/\.png$/, "", x)
		gsub(/\([^)]*\)/, " ", x)
		gsub(/\[[^]]*\]/, " ", x)
		gsub(/[ \t]+$/, "", x)
		if (match(x, /, (the|a|an)$/)) x = substr(x, RSTART + 2) " " substr(x, 1, RSTART - 1)
		gsub(/[^a-z0-9]+/, " ", x)
		gsub(/^ +| +$/, "", x)
		return x
	}
	BEGIN { q = norm(t); best = ""; bs = 1e9; numbered = (q ~ / ([0-9]+|[ivx]+)$/) }
	q == "" || length(q) < 3 { next }
	{
		n = norm($1)
		if (n == q) s = 0
		else if (numbered && index(n, q " ") == 1) s = 1 + length(n)
		else next
		if ($1 ~ /\(1[0-9][0-9][0-9]\)|\(20[0-9][0-9]\)/) s -= 0.5
		if (s < bs) { bs = s; best = $2 }
	}
	END { if (best != "") print best }' "$lst")
	ret "$r"
}

# Fetch a box's cover into it as .cover.png, whatever BX_ART says. Status 1
# when there is none to be had, 2 when one came back that was not a PNG.
fn bc_fetch(box) {
	local lst title enc tmp magic url

	bm_up "$box"
	lst := bc_list || return 1
	url := bc_url
	json parse BCJ "$(< "$box/boxer.json")" 2> /dev/null || return 1
	title := bp_get BCJ .title "${box##*/}"
	title=${title%.boxer}
	enc := bc_match "$title" "$lst"
	[ -n "$enc" ] || return 1
	tmp="$box/.cover.png.part"
	bc_get "$url$enc" "$tmp" 8000000 || { command rm -f -- "$tmp"; return 1; }
	magic=$(head -c 8 "$tmp" | od -An -tx1 | tr -d ' \n')
	if [ "$magic" != 89504e470d0a1a0a ] || [ "$(stat -c %s "$tmp")" -lt 60 ]; then
		command rm -f -- "$tmp"
		return 2
	fi
	command mv -f -- "$tmp" "$box/.cover.png"
	return 0
}

# Put a picture of the person's own in as a box's cover. A PNG only.
fn bc_set(box, pic) {
	local magic

	[ -r "$pic" ] || { echo "boxer: no such file: $pic" >&2; return 1; }
	magic=$(head -c 8 "$pic" | od -An -tx1 | tr -d ' \n')
	[ "$magic" = 89504e470d0a1a0a ] || { echo "boxer: a cover must be a PNG: $pic" >&2; return 1; }
	command cp -f -- "$pic" "$box/.cover.png"
}

# After an import: a cover the game came with or sat beside, else, when it is
# switched on, the one fetched. src is what was imported.
fn bc_auto(box, src) {
	local d f n

	[ -n "$(bc_path "$box")" ] && return 0
	d=${src%/}
	[ -d "$d" ] || d=${d%/*}
	n=${src%/}
	n=${n##*/}
	n=${n%.*}
	for f in "$d/.cover.png" "$d/cover.png" "$d/$n.png" "$src/cover.png"; do
		[ -f "$f" ] && bc_set "$box" "$f" 2> /dev/null && return 0
	done
	[ "$BX_ART" = on ] && bc_fetch "$box"
	return 0
}

# Make a gamebox, then give it its cover.
fn bx_import(src, title = "", mode = auto) {
	local box

	box := bx_import_box "$src" "$title" "$mode" || return 1
	bc_auto "$box" "$src"
	ret "$box"
}

# Make a gamebox on the shelf from src -- a folder, an archive, a CD image or
# a lone program -- the way Boxer does, and say where it is.
#
# What the files are decides it: a game with an installer and nothing to say it
# is installed already is set up to run the installer, with the folder as a CD
# in D:; the person plays through it, and when the window closes what it put
# on C: is the game and the CD is kept. A game with no installer, or one that
# says it is installed, is copied into C:. mode is auto, install or installed
# to say which.
fn bx_import_box(src, title = "", mode = auto) {
	local base name box work tmp= iso=0 found

	[ -e "$src" ] || { echo "boxer: no such file or folder: $src" >&2; return 1; }
	base=${src%/}
	base=${base##*/}
	base=${base%.*}
	work=$src
	case ${src,,} in
	*.iso | *.cue | *.img | *.bin) iso=1 ;;
	*.zip)
		command -v unzip > /dev/null || { echo "boxer: unzip is needed to open a zip" >&2; return 1; }
		tmp=$(mktemp -d) || return 1
		unzip -q -o -d "$tmp" "$src" > /dev/null || { command rm -rf -- "$tmp"; return 1; }
		work=$tmp ;;
	*.tar | *.tar.gz | *.tgz | *.tar.xz | *.tar.bz2)
		tmp=$(mktemp -d) || return 1
		tar -xf "$src" -C "$tmp" || { command rm -rf -- "$tmp"; return 1; }
		work=$tmp ;;
	*.exe | *.com | *.bat)
		tmp=$(mktemp -d) || return 1
		command cp -- "$src" "$tmp/" || { command rm -rf -- "$tmp"; return 1; }
		work=$tmp ;;
	*) [ -d "$src" ] || { echo "boxer: not a folder, archive, disc image or program: $src" >&2; return 1; } ;;
	esac
	name := bx_unique "${title:-$base}"
	box="${BX_TO:-$BX_SHELF}/$name.boxer"
	mkdir -p "$box/engine" "$box/drives/c" "$box/drives/d" "$box/saves" "$box/extras" || return 1
	if [ "$iso" = 1 ]; then
		command cp -- "$src" "$box/drives/d/" || { command rm -rf -- "$box" "$tmp"; return 1; }
		[ -e "${src%.*}.bin" ] && [ "${src##*.}" = cue ] && command cp -- "${src%.*}.bin" "$box/drives/d/"
		[ -e "${src%.*}.BIN" ] && [ "${src##*.}" = CUE ] && command cp -- "${src%.*}.BIN" "$box/drives/d/"
		tmp=$(mktemp -d)
		if bd_extract "$box/drives/d/${src##*/}" "$tmp"; then
			bx_discplan "$box" "$name" "$tmp" "$mode"
		else
			echo "boxer: $base added with its disc in D:; nothing here can read inside a disc image (xorriso, 7z or bsdtar), so it starts at the DOS prompt" >&2
			bd_describe "$box" "$name" installed
		fi
		command rm -rf -- "$tmp"
		ret "$box"
		return 0
	fi
	bd_scan "$work"
	if [ "$BD_WINN" -gt 0 ] && ! printf '%s\n' "$BD_DOS" | grep -vi '\.bat$' | grep -q .; then
		echo "boxer: $base is a Windows game, and Boxer plays DOS games" >&2
		command rm -rf -- "$box" "$tmp"
		return 1
	fi
	if [ -z "$BD_DOS" ] && [ "$BD_TELLY" = 0 ] && [ "$BD_CONFN" = 0 ]; then
		echo "boxer: no DOS programs in $base" >&2
		command rm -rf -- "$box" "$tmp"
		return 1
	fi
	found=$BD_INST
	if [ "$mode" = auto ]; then
		mode=installed
		[ -n "$found" ] && [ "$BD_TELLY" = 0 ] && mode=install
	fi
	if [ "$mode" = install ] && [ -n "$found" ]; then
		bx_disc "$work" "$box" || { command rm -rf -- "$box" "$tmp"; return 1; }
		bd_describe "$box" "$name" installing
		BD_DINST=
	else
		command rmdir "$box/drives/d" 2> /dev/null
		bx_copyin "$work" "$box" "$name"
		bd_describe "$box" "$name" installed
	fi
	[ -n "$tmp" ] && command rm -rf -- "$tmp"
	ret "$box"
}

# Put the disc a game installs from into D:: as a disc image when a tool here
# can make one, so that DOS sees a CD-ROM, else as a folder.
fn bx_disc(work, box) {
	local stage

	stage=$(mktemp -d) || return 1
	command cp -R -- "$work"/. "$stage/" || { command rm -rf -- "$stage"; return 1; }
	bx_hoist "$stage"
	bx_dosify "$stage"
	bd_scan "$stage"
	BD_DINST=$BD_INST
	if bd_mkiso "$stage" "$box/drives/d/disc.iso"; then
		command rm -rf -- "$stage"
	else
		command cp -R -- "$stage"/. "$box/drives/d/" || { command rm -rf -- "$stage"; return 1; }
		command rm -rf -- "$stage"
	fi
	return 0
}

# What a game's disc image holds decides what to do with it, as a folder's files
# do: Windows only, or nothing DOS, is turned away; an installer is run first,
# from the image as D:; a game that runs from its disc lists its programs on D:.
fn bx_discplan(box, name, tree, mode) {
	local prog list=

	bd_scan "$tree"
	if [ "$BD_WINN" -gt 0 ] && ! printf '%s\n' "$BD_DOS" | grep -vi '\.bat$' | grep -q .; then
		echo "boxer: $name is a Windows game, and Boxer plays DOS games" >&2
	fi
	if [ "$mode" = auto ]; then
		mode=installed
		[ -n "$BD_INST" ] && [ "$BD_TELLY" = 0 ] && mode=install
	fi
	if [ "$mode" = install ] && [ -n "$BD_INST" ]; then
		BD_DINST=$BD_INST
		bd_describe "$box" "$name" installing
		BD_DINST=
		return 0
	fi
	list=$(bd_programs "$tree" D)
	BD_DPROGS=$list
	bd_describe "$box" "$name" installed
	BD_DPROGS=
	return 0
}

# Copy an installed game into drive C: of the box, in a folder of its own when
# it would otherwise be loose in the root, with names DOS can hold.
fn bx_copyin(work, box, name) {
	local sub

	if bd_wantsfolder "$work"; then
		sub := bd_dosname "$name"
		mkdir -p "$box/drives/c/$sub"
		command cp -R -- "$work"/. "$box/drives/c/$sub/" || return 1
	else
		command cp -R -- "$work"/. "$box/drives/c/" || return 1
	fi
	bx_hoist "$box/drives/c"
	bx_dosify "$box/drives/c"
	return 0
}

# A box made before its names were made DOS-sized, or by hand: the same
# treatment, what the person set kept.
fn bx_fix(box) {
	local new

	case $box in
	*.gamebox)
		new=${box%.gamebox}.boxer
		[ -e "$new" ] || { command mv -- "$box" "$new" && box=$new; }
		;;
	esac
	bm_up "$box"
	[ -r "$box/boxer.json" ] || { echo "boxer: not a box: $box" >&2; return 1; }
	json parse BXJ "$(< "$box/boxer.json")" || return 1
	bx_hoist "$box/drives/c"
	bx_dosify "$box/drives/c"
	[ -d "$box/drives/d" ] && bx_dosify "$box/drives/d"
	bd_describe "$box" "${box##*/}" ""
	ret "$box"
}

# --- a game's settings ----------------------------------------------------------
#
# Boxer's own way of changing one game's settings, in the Game Settings window.
# What is chosen is written into the game's boxer.json, so it goes with the box wherever the box goes, and wins
# over what Control Panel > Boxer says for every game ("default" means that).

BXI_FIELDS=(prog render aspect cycles machine voodoo vspeed sound irq dma port midi mouse capture)
BXI_LABELS=("Program" "Rendering" "Shape" "Speed" "Graphics" "3D (Voodoo)" "3D Speed" "Sound Card" "Sound IRQ" "Sound DMA" "Sound Port" "MIDI" "Mouse" "Capture")
BXI_IRQ=(default 3 5 7 9 10 11 12)
BXI_DMA=(default 0 1 3 5 6 7)
BXI_PORT=(default 210 220 230 240 250 260 280)
BXI_RENDER=(default follow pixels half)
BXI_ASPECT=(default 4:3 auto 16:10 16:9 1:1)
BXI_CYCLES=(default auto max 3000 8000 20000 50000)
BXI_MACHINE=(default svga_s3 vgaonly ega cga tandy hercules)
BXI_VOODOO=(default 8mb 12mb 4mb off)
BXI_VSPEED=(default multi multi-low single single-low)
BXI_SOUND=(default sb16 sbpro2 sb1 none)
BXI_MOUSE=(default direct relative off)
BXI_CAPTURE=(default seamless click)

# Where in the box's document a field lives.
fn bxi_path(field) {
	case $field in
	prog) ret .launch.program ;;
	render) ret .display.render ;;
	aspect) ret .display.aspect ;;
	cycles) ret .cpu.cycles ;;
	machine) ret .machine ;;
	voodoo) ret .voodoo ;;
	vspeed) ret .voodoospeed ;;
	sound) ret .sound.card ;;
	irq) ret .sound.irq ;;
	dma) ret .sound.dma ;;
	port) ret .sound.port ;;
	midi) ret .midi ;;
	mouse) ret .mouse ;;
	capture) ret .capture ;;
	esac
}

# The same, for the box at this path: the settings dialog has no shelf.
fn bx_info_loadbox(int id, box) {
	local f v n i p

	bm_up "$box"
	BX[$id]["ibox"]=$box
	BX[$id]["iprogs"]=
	for f in "${BXI_FIELDS[@]}"; do BX[$id]["i_$f"]=default; done
	[ -r "$box/boxer.json" ] || return 0
	json parse BXJ "$(< "$box/boxer.json")" 2> /dev/null || return 0
	for f in "${BXI_FIELDS[@]}"; do
		p := bxi_path "$f"
		v := json get BXJ "$p" 2> /dev/null || v=
		[ -n "$v" ] && BX[$id]["i_$f"]=$v
	done
	n := json len BXJ .programs 2> /dev/null || n=0
	for ((i = 0; i < n; i++)); do
		v := json get BXJ ".programs[$i]" 2> /dev/null || continue
		BX[$id]["iprogs"]="${BX[$id]["iprogs"]}${BX[$id]["iprogs"]:+ }$v"
	done
	return 0
}

# Write one setting into the box, and show it.
fn bx_info_set(int id, field, value) {
	local box=${BX[$id]["ibox"]-} p

	bm_up "$box"
	[ -r "$box/boxer.json" ] || return 0
	json parse BXJ "$(< "$box/boxer.json")" 2> /dev/null || return 0
	p := bxi_path "$field"
	json set BXJ "$p" "$value" -s
	[ "$field" = prog ] && json set BXJ .installer false
	json emit BXJ -p > "$box/boxer.json"
	BX[$id]["i_$field"]=$value
	return 0
}

# A drop-down's choice comes back as "id value"; which field it was for is
# remembered in the window's state.
fn bxi_pick(int id, value = "") {
	bx_info_set "$id" "${BX[$id]["pick"]}" "$value"
}

# The choices for a field.
fn bxi_choices(int id, field) {
	local l f

	case $field in
	prog) ret "${BX[$id]["iprogs"]}" ;;
	render) ret "${BXI_RENDER[*]}" ;;
	aspect) ret "${BXI_ASPECT[*]}" ;;
	cycles) ret "${BXI_CYCLES[*]}" ;;
	machine) ret "${BXI_MACHINE[*]}" ;;
	voodoo) ret "${BXI_VOODOO[*]}" ;;
	vspeed) ret "${BXI_VSPEED[*]}" ;;
	sound) ret "${BXI_SOUND[*]}" ;;
	irq) ret "${BXI_IRQ[*]}" ;;
	dma) ret "${BXI_DMA[*]}" ;;
	port) ret "${BXI_PORT[*]}" ;;
	midi) l="default disabled"; if dt_has bp_midilist; then while IFS= read -r f; do [ -n "$f" ] && l="$l $f"; done <<< "$(bp_midilist)"; fi; ret "$l" ;;
	mouse) ret "${BXI_MOUSE[*]}" ;;
	capture) ret "${BXI_CAPTURE[*]}" ;;
	esac
}

# Open a field's choices under it.
fn bxi_open(int id, field, int r, int c) {
	local ch
	local -a o

	ch := bxi_choices "$id" "$field"
	read -ra o <<< "$ch"
	[ "${#o[@]}" -gt 0 ] || return 0
	BX[$id]["pick"]=$field
	dt_droplist "$id" "$r" "$c" bxi_pick "${o[@]}"
}

# Step a field on or back by one choice.
fn bxi_step(int id, field, int dir) {
	local ch cur=${BX[$id]["i_$field"]} i n=0 k=0
	local -a o

	ch := bxi_choices "$id" "$field"
	read -ra o <<< "$ch"
	n=${#o[@]}
	[ "$n" -gt 0 ] || return 0
	for ((i = 0; i < n; i++)); do
		[ "${o[$i]}" = "$cur" ] && k=$i
	done
	k=$(((k + dir + n) % n))
	bx_info_set "$id" "$field" "${o[$k]}"
}

# The fields, a row each from row r0: the name, then its choice as a drop-down.
fn bx_info_fields(int id, int r0, int c0, int w, focused) {
	local i f r on

	for i in "${!BXI_FIELDS[@]}"; do
		f=${BXI_FIELDS[$i]}
		r=$((r0 + i))
		on=0
		[ "$focused" = 1 ] && [ "${BX[$id]["ifield"]:-0}" = "$i" ] && on=1
		if [ "$on" = 1 ]; then console pen "$DT_SELINK" "$DT_ACTIVE"; else console pen "$DT_INK" "$DT_FACE"; fi
		dt_tput "$id" "$r" "$c0" "${BXI_LABELS[$i]}"
		console pen "$DT_INK" "$DT_FACE"
		dt_wdrop "$id" "$r" $((c0 + 12)) $((w - 12)) "${BX[$id]["i_$f"]:-default}" "$f"
	done
	return 0
}

# A key for the fields: up and down choose one, left and right step its
# value, Enter opens its choices. Status 1 when it was not one of those.
fn bxi_key(int id, key, int r0, int c0) {
	local i=${BX[$id]["ifield"]:-0} nf=${#BXI_FIELDS[@]} f

	f=${BXI_FIELDS[$i]}
	case $key in
	up) BX[$id]["ifield"]=$(((i + nf - 1) % nf)) ;;
	down) BX[$id]["ifield"]=$(((i + 1) % nf)) ;;
	left) bxi_step "$id" "$f" -1 ;;
	right | " ") bxi_step "$id" "$f" 1 ;;
	enter) bxi_open "$id" "$f" $((r0 + i)) $((c0 + 12)) ;;
	*) return 1 ;;
	esac
	return 0
}

# A click on a field: it becomes the chosen one and its choices open.
fn bxi_click(int id, int r, int c) {
	local tag i f

	tag := dt_hit "$id" "$r" "$c" || return 1
	for i in "${!BXI_FIELDS[@]}"; do
		[ "${BXI_FIELDS[$i]}" = "$tag" ] && { BX[$id]["ifield"]=$i; f=$tag; }
	done
	[ -n "${f-}" ] || return 1
	bxi_open "$id" "$f" "$r" "$c"
	return 0
}

# Import each path given. The copy is done here, in the desktop's own time, so
# a very large game holds the window still.
fn bx_import_all(int id, ...paths) {
	local p b n=0 names=

	BX_TO=$BX_SHELF
	mkdir -p "$BX_TO" 2> /dev/null

	for p in "${paths[@]}"; do
		if b := bx_import "$p"; then
			n=$((n + 1))
			b=${b##*/}
			names="$names${names:+, }${b%.boxer}"
		fi
	done
	BX_TO=
	if [ "$n" -gt 0 ]; then
		BX[$id]["status"]="Added $names"
	else
		BX[$id]["status"]="Boxer could not import that"
	fi
	return 0
}

# A folder, archive, CD image or program dropped from Files: made into a game.
fn boxer_drop(int id, int r, int c, op, ...paths) {
	bx_import_all "$id" "${paths[@]}"
}

fn bx_picked(int id, path, type = "") {
	bx_import_all "$id" "$path"
}

fn bx_pick(int id) {
	dt_filepick open "Import a Game" \
		"Games:*.zip *.tar *.tar.gz *.tgz *.exe *.com *.bat *.iso *.cue|All files:*" \
		"$HOME" "" bx_picked "$id"
}

fn bx_folder(int id) {
	mkdir -p "$BX_SHELF" 2> /dev/null
	dt_launch files "$BX_SHELF" > /dev/null
	return 0
}

# --- the import window ----------------------------------------------------------
#
# A diskette and a CD, drawn in half blocks so that any terminal shows them, and
# what to do with them.

declare -gA BXA=([k]="#1b1b2f" [b]="#3b5bdb" [m]="#ced4da" [M]="#868e96" [w]="#f8f9fa" [r]="#e03131"
	[S]="#f1f3f5" [s]="#adb5bd" [p]="#845ef7" [c]="#22b8cf")
BXA_DISK=("kkkkkkkkkkkkkkk." "kbbbmmmmmmmbbbbk" "kbbbmmmMMmmbbbbk" "kbbbmmmMMmmbbbbk" "kbbbmmmmmmmbbbbk" "kbbbbbbbbbbbbbbk" "kbbbbbbbbbbbbbbk" "kbwwwwwwwwwwwwbk" "kbwrrrrrrrrrrwbk" "kbwwwwwwwwwwwwbk" "kbwrrrrrrrwwwwbk" "kbwwwwwwwwwwwwbk" "kbwwwwwwwwwwwwbk" "kbbbbbbbbbbbbbbk" "kbbbbbbbbbbbbbbk" "kkkkkkkkkkkkkkkk")
BXA_CD=("......kkkk......" "....kkssSSkk...." "..kkccsSSSsskk.." "..kcccSSSssssk.." ".kccccSSSSssssk." ".kcccSSkkSSsssk." "kssSSSk..kSSsssk" "ksSSSk....kSsssk" "kSSSSk....kSsssk" "kSSsSSk..kSSsssk" ".ksssSSkkSSpppk." ".kssssSSSSppppk." "..kssssssspppk.." "..kkssssssppkk.." "....kksssskk...." "......kkkk......")

# A 16 by 16 picture of letters, one half block to a pixel, at row r0, column c0.
fn bx_pix(int id, int r0, int c0, ...rows) {
	local y x t b run glyph fg bg rs

	for ((y = 0; y < 16; y += 2)); do
		x=0
		while [ "$x" -lt 16 ]; do
			t=${rows[$y]:$x:1}
			b=${rows[$((y + 1))]:$x:1}
			run=1
			while [ $((x + run)) -lt 16 ] && [ "${rows[$y]:$((x + run)):1}" = "$t" ] &&
			      [ "${rows[$((y + 1))]:$((x + run)):1}" = "$b" ]; do
				run=$((run + 1))
			done
			if [ "$t" != . ] || [ "$b" != . ]; then
				if [ "$t" = . ]; then glyph="▄"; fg=${BXA[$b]}; bg=$DT_FACE
				elif [ "$b" = . ]; then glyph="▀"; fg=${BXA[$t]}; bg=$DT_FACE
				else glyph="▀"; fg=${BXA[$t]}; bg=${BXA[$b]}; fi
				console pen "$fg" "$bg"
				printf -v rs '%*s' "$run" ""
				console put -p "w$id" $((r0 + y / 2)) $((c0 + x)) "${rs// /$glyph}"
			fi
			x=$((x + run))
		done
	done
	return 0
}

fn boxer_open(int id, arg = "") {
	BX[$id]["status"]=
	BX[$id]["focus"]=import
	[ -n "$arg" ] && bx_import_all "$id" "$arg"
	return 0
}

fn boxer_draw(int id, int h, int w, int row, int col) {
	local f=${BX[$id]["focus"]:-import} l

	dt_wclear "$id"
	console pen "$DT_INK" "$DT_FACE"
	console fill -p "w$id" 1 1 $((h - 2)) $((w - 2)) " "
	bx_pix "$id" 2 5 "${BXA_DISK[@]}"
	bx_pix "$id" 2 27 "${BXA_CD[@]}"
	console pen "$DT_INK" "$DT_FACE" bold
	dt_tput "$id" 3 47 "Drop a game here"
	console pen "$DT_INK" "$DT_FACE"
	dt_tput "$id" 5 47 "a folder, a zip,"
	dt_tput "$id" 6 47 "a disc image or"
	dt_tput "$id" 7 47 "a program"
	console pen "$DT_DIM" "$DT_FACE"
	dt_tput "$id" 11 3 "Games are kept in"
	console pen "$DT_INK" "$DT_FACE"
	dt_tput "$id" 12 3 "${BX_SHELF:0:$((w - 6))}"
	console pen "$DT_DIM" "$DT_FACE"
	dt_tput "$id" 14 3 "Double-click a game in Files to play it."
	l=${BX[$id]["status"]-}
	if [ -n "$l" ]; then
		console pen "$DT_ACTIVE" "$DT_FACE" bold
		dt_tput "$id" 16 3 "${l:0:$((w - 6))}"
	fi
	dt_dlgbtns "$id" "$h" "$w" "$f" import "Import${GL[ellipsis]}" folder "Open Games Folder"
	return 0
}

fn boxer_key(int id, key) {
	local f=${BX[$id]["focus"]:-import} d
	local -a o=(import folder)

	if d := dt_focuskey "$key" 1; then
		BX[$id]["focus"] := dt_focus "$f" "$d" "${o[@]}"
		return 0
	fi
	case $key in
	enter) if [ "$f" = folder ]; then bx_folder "$id"; else bx_pick "$id"; fi ;;
	i) bx_pick "$id" ;;
	f) bx_folder "$id" ;;
	esac
	return 0
}

fn boxer_click(int id, int r, int c, btn = "") {
	local tag

	tag := dt_hit "$id" "$r" "$c" || return 0
	case $tag in
	import) bx_pick "$id" ;;
	folder) bx_folder "$id" ;;
	esac
	return 0
}

fn boxer_close(int id) {
	unset "BX[$id]"
}

# --- Fetch Cover and Game Is Already Installed, from a game's right-click menu in
# Files: each a small window that asks first and says what happened.

fn bx_askopen(int id, box) {
	local t

	bm_up "$box"
	BX[$id]["ibox"]=$box
	t=${box##*/}
	t=${t%.*}
	if [ -r "$box/boxer.json" ] && json parse BXJ "$(< "$box/boxer.json")" 2> /dev/null; then
		t := bx_title "$t"
	fi
	BX[$id]["name"]=$t
	BX[$id]["said"]=
	BX[$id]["focus"]=ok
	return 0
}

fn bx_askdraw(int id, int h, int w, ...lines) {
	local i=2 l

	dt_wclear "$id"
	console pen "$DT_INK" "$DT_FACE"
	console fill -p "w$id" 1 1 $((h - 2)) $((w - 2)) " "
	for l in "${lines[@]}"; do
		dt_tput "$id" "$i" 3 "${l:0:$((w - 6))}"
		i=$((i + 1))
	done
	return 0
}

fn boxercover_open(int id, arg = "") {
	bx_askopen "$id" "$arg"
}

fn boxercover_draw(int id, int h, int w, int row, int col) {
	local n=${BX[$id]["name"]}

	if [ -n "${BX[$id]["said"]}" ]; then
		bx_askdraw "$id" "$h" "$w" "${BX[$id]["said"]}"
		dt_dlgbtns "$id" "$h" "$w" ok ok OK
		return 0
	fi
	bx_askdraw "$id" "$h" "$w" "Fetch the box art for $n from the internet?" "" \
		"This sends the game's name to thumbnails.libretro.com."
	dt_dlgbtns "$id" "$h" "$w" "${BX[$id]["focus"]}" ok Fetch cancel Cancel
}

fn bx_coverdo(int id) {
	local st

	if [ -n "${BX[$id]["said"]}" ]; then
		dt_del "$id"
		return 0
	fi
	bc_fetch "${BX[$id]["ibox"]}"
	st=$?
	case $st in
	0) BX[$id]["said"]="Found a cover for ${BX[$id]["name"]}." ;;
	2) BX[$id]["said"]="What came back was not a PNG, so it was not kept." ;;
	*) BX[$id]["said"]="No cover found for ${BX[$id]["name"]}, or it could not be fetched." ;;
	esac
	return 0
}

fn boxercover_key(int id, key) {
	local f=${BX[$id]["focus"]} d
	local -a o=(ok cancel)

	if d := dt_focuskey "$key" 1; then
		BX[$id]["focus"] := dt_focus "$f" "$d" "${o[@]}"
		return 0
	fi
	case $key in
	escape) dt_del "$id" ;;
	enter) if [ "$f" = cancel ]; then dt_del "$id"; else bx_coverdo "$id"; fi ;;
	esac
	return 0
}

fn boxercover_click(int id, int r, int c, btn = "") {
	local tag

	tag := dt_hit "$id" "$r" "$c" || return 0
	case $tag in ok) bx_coverdo "$id" ;; cancel) dt_del "$id" ;; esac
	return 0
}

fn boxercover_close(int id) {
	unset "BX[$id]"
}

fn boxerdone_open(int id, arg = "") {
	bx_askopen "$id" "$arg"
	BX[$id]["waiting"]=0
	[ "$(bp_state_of "$arg")" = installing ] && BX[$id]["waiting"]=1
	return 0
}

fn boxerdone_draw(int id, int h, int w, int row, int col) {
	local n=${BX[$id]["name"]}

	if [ "${BX[$id]["waiting"]}" != 1 ] || [ -n "${BX[$id]["said"]}" ]; then
		if [ -n "${BX[$id]["said"]}" ]; then
			bx_askdraw "$id" "$h" "$w" "${BX[$id]["said"]}"
		else
			bx_askdraw "$id" "$h" "$w" "$n is not waiting to be installed."
		fi
		dt_dlgbtns "$id" "$h" "$w" ok ok OK
		return 0
	fi
	bx_askdraw "$id" "$h" "$w" "Is $n already installed?" "" \
		"Its disc's files will be the game, and the disc is let go."
	dt_dlgbtns "$id" "$h" "$w" "${BX[$id]["focus"]}" ok Yes cancel Cancel
}

fn bx_donedo(int id) {
	if [ "${BX[$id]["waiting"]}" != 1 ] || [ -n "${BX[$id]["said"]}" ]; then
		dt_del "$id"
		return 0
	fi
	bd_finish "${BX[$id]["ibox"]}" 1
	BX[$id]["said"]="Done: ${BX[$id]["name"]} plays from its files now."
	return 0
}

fn boxerdone_key(int id, key) {
	local f=${BX[$id]["focus"]} d
	local -a o=(ok cancel)

	if d := dt_focuskey "$key" 1; then
		BX[$id]["focus"] := dt_focus "$f" "$d" "${o[@]}"
		return 0
	fi
	case $key in
	escape) dt_del "$id" ;;
	enter) if [ "$f" = cancel ]; then dt_del "$id"; else bx_donedo "$id"; fi ;;
	esac
	return 0
}

fn boxerdone_click(int id, int r, int c, btn = "") {
	local tag

	tag := dt_hit "$id" "$r" "$c" || return 0
	case $tag in ok) bx_donedo "$id" ;; cancel) dt_del "$id" ;; esac
	return 0
}

fn boxerdone_close(int id) {
	unset "BX[$id]"
}

# --- About -----------------------------------------------------------------------

# About Boxer: what this is a tribute to, and whose work it runs on.
fn boxer_about() {
	local h=24 w=78 rid

	dt_dlgat "$h" "$w"
	rid := dt_new "About Boxer" "$DT_DLGH" "$DT_DLGW" "$DT_DLGR" "$DT_DLGC" boxerabout
	return 0
}

fn boxerabout_draw(int id, int h, int w, int row, int col) {
	local i=2 l n
	local -a lines=(
		"Boxer for hibr"
		""
		"A tribute to Boxer, the DOS game box for the Mac, by Alun Bestor, who made"
		"playing old DOS games as easy as keeping them on a shelf. How a game is"
		"recognised, installed and shelved follows Boxer's own rules, read from its"
		"source (GPL-2.0, Alun Bestor and contributors)."
		"  https://boxerapp.com    https://github.com/alunbestor/Boxer"
		""
		"Games run in DOSBox Pure, a libretro core by Bernhard Schelling, built on"
		"DOSBox by the DOSBox Team; the sound and the look are theirs, and we say so:"
		"  DOSBox Pure   https://codeberg.org/schelling/dosbox-pure"
		"  DOSBox        https://www.dosbox.com"
		"Inside, the MT-32 is Munt (Dean Beeler, Jerome Fisher, Sergey V. Mikayev),"
		"the OPL3 and SC-55 are Nuked (Nuke.YKT). It speaks libretro."
		"GPL-2.0 or later (DOSBox Pure, DOSBox); LGPL-2.1 or later (Munt)."
		""
		"Box art, when fetching is on, is from the libretro thumbnails project."
		"Boxer for hibr is MIT, and runs on hibr."
	)

	# A short terminal drops the blank lines before it drops any credit.
	n=$((h - 5))
	if [ "${#lines[@]}" -gt "$n" ]; then
		local -a keep=()
		for l in "${lines[@]}"; do [ -n "$l" ] && keep+=("$l"); done
		lines=("${keep[@]}")
	fi
	lines=("${lines[@]:0:$n}")

	dt_wclear "$id"
	for l in "${lines[@]}"; do
		if [ "$i" = 2 ]; then console pen "$DT_INK" "$DT_FACE" bold; else console pen "$DT_INK" "$DT_FACE"; fi
		dt_tput "$id" "$i" 2 "$l"
		i=$((i + 1))
	done
	dt_dlgbtns "$id" "$h" "$w" ok ok OK
}

fn boxerabout_key(int id, key) {
	case $key in enter | escape | " ") dt_del "$id" ;; esac
	return 0
}

fn boxerabout_click(int id, int r, int c, btn = "") {
	[ "$(dt_hit "$id" "$r" "$c")" = ok ] && dt_del "$id"
	return 0
}

# --- the Game Settings window --------------------------------------------------
#
# The same fields as the drawer, in a window of their own, opened with the path
# of a box: from a right click on a game, and, once Files opens a folder by its
# extension (hibr #318), from the same menu there.

fn boxerinfo_open(int id, arg = "") {
	local t

	bx_info_loadbox "$id" "$arg"
	BX[$id]["ifield"]=0
	BX[$id]["nfocus"]=0
	t=${arg##*/}
	t=${t%.*}
	bm_up "$arg"
	if [ -r "$arg/boxer.json" ] && json parse BXJ "$(< "$arg/boxer.json")" 2> /dev/null; then
		t := bx_title "$t"
	fi
	BX[$id]["name"]=$t
	BX[$id]["ntext"]=$t
	BX[$id]["ncur"]=${#t}
	dt_retitle "$id" "$t Settings"
}

# Give the game the name typed, in its boxer.json and as its folder, which
# are kept the same. A name another game has is refused.
fn bx_rename(int id) {
	local box=${BX[$id]["ibox"]-} new=${BX[$id]["ntext"]-} dest

	new=${new//[$'\t\n']/ }
	new=${new#"${new%%[! ]*}"}
	new=${new%"${new##*[! ]}"}
	if [ -z "$new" ] || [ "${new//\//}" != "$new" ] || [ "${new:0:1}" = . ]; then
		dt_notep high "A name needs letters, and no slash or leading dot"
		return 0
	fi
	dest="${box%/*}/$new.boxer"
	if [ "$dest" != "$box" ] && [ -e "$dest" ]; then
		dt_notep high "There is already a game called $new"
		return 0
	fi
	bm_up "$box"
	[ -r "$box/boxer.json" ] || return 0
	json parse BXJ "$(< "$box/boxer.json")" 2> /dev/null || return 0
	json set BXJ .title "$new" -s
	json emit BXJ -p > "$box/boxer.json"
	if [ "$dest" != "$box" ]; then
		command mv -- "$box" "$dest" || { dt_notep high "Cannot rename the folder"; return 0; }
		BX[$id]["ibox"]=$dest
	fi
	BX[$id]["name"]=$new
	BX[$id]["ntext"]=$new
	BX[$id]["ncur"]=${#new}
	BX[$id]["nfocus"]=0
	dt_retitle "$id" "$new Settings"
	return 0
}

fn boxerinfo_draw(int id, int h, int w, int row, int col) {
	local on=${BX[$id]["nfocus"]:-0} cur=0

	dt_wclear "$id"
	console pen "$DT_INK" "$DT_FACE"
	console fill -p "w$id" 1 1 $((h - 2)) $((w - 2)) " "
	console pen "$DT_INK" "$DT_FACE" bold
	dt_tput "$id" 1 2 "Name"
	console pen "$DT_INK" "$DT_FACE"
	[ "$on" = 1 ] && cur=${BX[$id]["ncur"]}
	dt_textdraw "$id" 1 12 $((w - 14)) "${BX[$id]["ntext"]}" "$cur" "$on"
	dt_wreg "$id" 1 12 $((w - 14)) name
	bx_info_fields "$id" 3 2 $((w - 4)) "$((1 - on))"
	console pen "$DT_DIM" "$DT_FACE"
	dt_tput "$id" $((4 + ${#BXI_FIELDS[@]})) 2 "default: as Control Panel > Boxer. Up, down, left, right, enter."
	return 0
}

fn boxerinfo_key(int id, key) {
	local res

	if [ "${BX[$id]["nfocus"]:-0}" = 1 ]; then
		case $key in
		escape) BX[$id]["ntext"]=${BX[$id]["name"]}; BX[$id]["nfocus"]=0; return 0 ;;
		enter) bx_rename "$id"; return 0 ;;
		tab | down) BX[$id]["nfocus"]=0; return 0 ;;
		esac
		res := dt_textkey "${BX[$id]["ntext"]}" "${BX[$id]["ncur"]}" "$key" || return 0
		BX[$id]["ntext"]=${res% *}
		BX[$id]["ncur"]=${res##* }
		return 0
	fi
	case $key in
	escape) dt_del "$id"; return 0 ;;
	tab) BX[$id]["nfocus"]=1; BX[$id]["ncur"]=${#BX[$id]["ntext"]}; return 0 ;;
	up)
		if [ "${BX[$id]["ifield"]:-0}" = 0 ]; then
			BX[$id]["nfocus"]=1
			BX[$id]["ncur"]=${#BX[$id]["ntext"]}
			return 0
		fi
		;;
	esac
	bxi_key "$id" "$key" 3 2
	return 0
}

fn boxerinfo_click(int id, int r, int c, btn = "") {
	local tag

	tag := dt_hit "$id" "$r" "$c" || tag=
	if [ "$tag" = name ]; then
		BX[$id]["nfocus"]=1
		BX[$id]["ncur"]=${#BX[$id]["ntext"]}
		return 0
	fi
	BX[$id]["nfocus"]=0
	bxi_click "$id" "$r" "$c"
	return 0
}

fn boxerinfo_close(int id) {
	unset "BX[$id]"
}

# From a shell: boxer.hibr import PATH... puts each on the shelf and says where.
if [ -z "${DT_ROWS-}" ]; then
	# The detection and the box's description are boxerplay's, installed with it.
	dt_has bd_scan || . "${BASH_SOURCE%/*}/../boxerplay.hibr" 2> /dev/null
	case ${1-} in
	import)
		shift
		mkdir -p "$BX_SHELF"
		mode=auto
		for p in "$@"; do
			case $p in
			--install) mode=install; continue ;;
			--installed) mode=installed; continue ;;
			esac
			b := bx_import "$p" "" "$mode" && echo "$b"
		done
		;;
	cover)
		shift
		b=${1-}
		bm_up "$b"
		[ -r "$b/boxer.json" ] || { echo "boxer: cover BOX [PNG|fetch]" >&2; exit 1; }
		case ${2-fetch} in
		fetch) bc_fetch "$b" || { echo "boxer: no cover found for ${b##*/}" >&2; exit 1; } ;;
		*) bc_set "$b" "$2" || exit 1 ;;
		esac
		;;
	covers)
		for b in "$BX_SHELF"/*.boxer; do
			[ -d "$b" ] && [ -z "$(bc_path "$b")" ] && bc_fetch "$b" && echo "$b"
		done
		;;
	fix)
		shift
		for p in "$@"; do
			b := bx_fix "$p" && echo "$b"
		done
		;;
	list)
		for b in "$BX_SHELF"/*.boxer; do
			[ -d "$b" ] && echo "$b"
		done
		;;
	esac
fi
