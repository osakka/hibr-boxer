#!/usr/bin/env hibr
#
# boxer -- DOS games, one folder to a game, in the way Boxer keeps them on a
# Mac. A game lives in a folder of its own, NAME.boxer, holding the game's
# drive C, its box art (.cover.png), the person's DOSBox settings and the
# game's saves. The games folder is ~/Dos Games, and Control Panel > Boxer (or
# BX_SHELF) names another. Files shows the folders, and a double click on one
# plays it, in a window of its own (boxerplay); a right click offers Get Info,
# where the program, sound card, MIDI, graphics and the game's name are set.
#
# This window is for getting a game in. Drop a folder, a zip, a disc image or a
# program on it, or choose one with Import, and it is made into a NAME.boxer the
# way Boxer does it: an installer is run first, from the game's disc as D:.
#
# A tribute to Boxer, by Alun Bestor (https://boxerapp.com).

strict


app boxer "DOS games, one folder to a game" 1.26
# modules: img retro fetch
# part: apps/boxerplay.hibr
# part: control-panel/boxerset.hibr
command -v dt_app > /dev/null && dt_app boxer "Boxer" 21 72 "" "▣" fixed
command -v dt_app > /dev/null && dt_app boxerabout "About Boxer" 24 78 "" "" fixed hidden
command -v dt_app > /dev/null && dt_app boxerpick "Find Cover" 26 80 "" "" fixed hidden
command -v dt_app > /dev/null && dt_app boxerdone "Game Is Already Installed" 10 66 "" "" fixed hidden
command -v dt_app > /dev/null && dt_app boxerinfo "Game Settings" 22 60 "" "" fixed hidden
command -v dt_keepstate > /dev/null && dt_keepstate boxer BX
command -v dt_opener > /dev/null && dt_opener boxerplay "Boxer" "boxer" app boxerplay dir
command -v dt_openerverb > /dev/null && dt_openerverb boxer "Get Info..." boxerinfo
command -v dt_openerverb > /dev/null && dt_openerverb boxer "Find Cover..." boxerpick
command -v dt_openerverb > /dev/null && dt_openerverb boxer "Game Is Already Installed..." boxerdone

declare -gA BX BXJ
BX_TO=
# The default shelf is a folder called Dos Games in the person's home -- unless
# a shelf from before it was called that is there and the new one is not, in
# which case that one is kept, so nothing goes missing. Control Panel > Boxer
# changes it.
fn bx_defshelf() {
	local old="${XDG_DATA_HOME:-$HOME/.local/share}/hibr/shelf"

	if [ ! -d "$HOME/Dos Games" ] && [ -d "$old" ]; then
		ret "$old"
	else
		ret "$HOME/Dos Games"
	fi
}
[ -n "${BX_SHELF-}" ] || { BX_SHELF := bx_defshelf; }
command -v dt_keep > /dev/null && dt_keep BX_SHELF


# A box's own title, from the document just parsed, else the folder's name.
fn bx_title(def) {
	local v

	v := json get BXJ .title 2> /dev/null || v=
	[ -n "$v" ] && ret "$v" || ret "$def"
}

# A name for a new box that is not on the shelf yet.
fn bx_unique(name) {
	local n=$name k=2

	while [ -e "${BX_TO:-$BX_SHELF}/$n.boxer" ] || [ -e "${BX_TO:-$BX_SHELF}/$n.gamebox" ]; do
		n="$name $k"
		k=$((k + 1))
	done
	ret "$n"
}

# Whether a name is one DOS can hold as it is: eight characters, a dot and
# three, of the letters DOS allows.
fn bx_is8(name) {
	match "$name" '^[A-Za-z0-9_$~!#%&()@^{}`-]{1,8}(\.[A-Za-z0-9_$~!#%&()@^{}`-]{1,3})?$'
}

# A name DOS can hold, made from one it cannot: the letters it allows, eight
# of them and three after the last dot, and a ~N in place of the end of the
# base when another name in the folder already has it.
fn bx_dosname(dir, name) {
	local base=$name ext= cand n=0 stem

	case $name in
	*.*) base=${name%.*}; ext=${name##*.} ;;
	esac
	base=${base//[^A-Za-z0-9_\$~!#%&()@^\{\}\`-]/}
	ext=${ext//[^A-Za-z0-9_\$~!#%&()@^\{\}\`-]/}
	[ -n "$base" ] || base=GAME
	stem=${base:0:8}
	cand=$stem${ext:+.${ext:0:3}}
	while [ -n "$(find "$dir" -maxdepth 1 -iname "$cand" 2> /dev/null)" ]; do
		n=$((n + 1))
		cand=${base:0:6}~$n${ext:+.${ext:0:3}}
	done
	ret "$cand"
}

# A game packaged for DOSBox often keeps its files in a folder that is the
# drive itself -- C.harddisk, harddisk, drive_c -- to be mounted as C:. When
# the box has exactly one such folder, its contents are the drive: moved up,
# so the DOS path is C:\PRICEOF\ and not C:\C.HARDDISK\PRICEOF\.
fn bx_hoist(root) {
	local d n lo hit= k=0

	for d in "$root"/*/; do
		d=${d%/}
		[ -d "$d" ] || continue
		n=${d##*/}
		lo=${n,,}
		case $lo in
		c | c.harddisk | harddisk | drive_c | drivec | c_drive | c-drive | cdrive) hit=$d; k=$((k + 1)) ;;
		esac
	done
	[ "$k" = 1 ] || return 0
	for d in "$hit"/* "$hit"/.[!.]*; do
		[ -e "$d" ] || continue
		[ -e "$root/${d##*/}" ] && return 0
	done
	for d in "$hit"/* "$hit"/.[!.]*; do
		[ -e "$d" ] && command mv -- "$d" "$root/"
	done
	command rmdir "$hit" 2> /dev/null
	return 0
}

# Rename what DOS cannot hold as it is, from the bottom up, so the DOS path
# to a program is the real one: a game's folder with a dot or a space in its
# name was shown by DOSBox as C~1.HAR and the program was not found where its
# own name said. A DOS program cannot ask for a longer name, so nothing it
# uses is touched; what changes is the wrapper folders a modern download
# arrives in.
fn bx_dosify(root) {
	local f d n new

	find "$root" -depth -mindepth 1 2> /dev/null | while IFS= read -r f; do
		d=${f%/*}
		n=${f##*/}
		bx_is8 "$n" && continue
		new := bx_dosname "$d" "$n"
		command mv -- "$f" "$d/$new"
	done
	return 0
}

# --- box art --------------------------------------------------------------------
#
# A box's cover is .cover.png in it (cover.png is read too): the person's own
# when they put one there, else the libretro thumbnails project's picture for
# the game's name (https://thumbnails.libretro.com/DOS/): its box art, or, for
# a game with none, its title screen, which is at least never another game's
# box. Fetching sends the game's name to that server, so it is off until it is
# turned on in Control Panel > Boxer; choosing Fetch Cover for one game is the
# person asking for it, and needs no second answer. A cover that is already
# there is never replaced by an import. What comes back is checked to be a PNG
# of a sane size before it is kept (a real cover is tens of KB; 60 bytes is
# only less than the smallest PNG there is). Inside the desktop a fetch is a
# job, one at a time, and says how it went in a note; from a shell it waits.

declare -gA BCJ
BX_ART="${BX_ART-off}"
command -v dt_keep > /dev/null && dt_keep BX_ART

# The cover a box has, or nothing.
fn bc_path(box) {
	local f

	for f in "$box/.cover.png" "$box/cover.png"; do
		[ -r "$f" ] && { ret "$f"; return 0; }
	done
	return 1
}

# Where the list of names is kept, and where it is fetched from.
fn bc_cache() {
	ret "${XDG_CACHE_HOME:-$HOME/.cache}/hibr/boxer"
}

# Where a set of covers is fetched from: boxarts (the default), titles or snaps.
fn bc_url(set = boxarts) {
	local u=${BX_ART_URL:-https://thumbnails.libretro.com/DOS/Named_Boxarts/}

	case $set in
	titles) u=${u/Named_Boxarts/Named_Titles} ;;
	snaps) u=${u/Named_Boxarts/Named_Snaps} ;;
	esac
	ret "$u"
}

# The server's list of covers in a set as a file of "name<TAB>encoded name"
# lines, made when there is none or the one there is over a month old.
fn bc_list(set = boxarts) {
	local dir lst raw f n url

	dir := bc_cache
	url := bc_url "$set"
	lst="$dir/dos-$set.lst"
	if [ -s "$lst" ] && [ -z "$(find "$lst" -mtime +30 2> /dev/null)" ]; then
		ret "$lst"
		return 0
	fi
	mkdir -p "$dir" || return 1
	raw="$lst.part"
	bc_get "$url" "$raw" 6000000 || { command rm -f -- "$raw"; return 1; }
	grep -o 'href="[^"]*\.png"' "$raw" | sed -e 's/^href="//' -e 's/"$//' -e 's/&amp;/\&/g' > "$raw.enc"
	[ -s "$raw.enc" ] || { command rm -f -- "$raw" "$raw.enc"; return 1; }
	: > "$raw.dec"
	while IFS= read -r f; do
		n=${f//\\/%5C}
		printf '%b\n' "${n//%/\\x}" >> "$raw.dec"
	done < "$raw.enc"
	paste -d '\t' "$raw.dec" "$raw.enc" > "$lst"
	command rm -f -- "$raw" "$raw.enc" "$raw.dec"
	ret "$lst"
}

# One download, to a file, from a server over https (http only when the place
# to fetch from was named by hand), no bigger than max bytes.
fn bc_get(url, out, int max) {
	local pr='=https'

	[ -n "${BX_ART_URL-}" ] && pr='=http,https'
	if need fetch 2> /dev/null; then
		case $url in
		https://*) ;;
		http://*) [ -n "${BX_ART_URL-}" ] || return 1 ;;
		*) return 1 ;;
		esac
		fetch "$url" -o "$out" -t 30 > /dev/null 2>&1 || { command rm -f -- "$out"; return 1; }
		if [ "$(stat -c %s "$out" 2> /dev/null || echo 0)" -gt "$max" ]; then
			command rm -f -- "$out"
			return 1
		fi
		return 0
	fi
	command -v curl > /dev/null || return 1
	curl -fsSL --proto "$pr" --proto-redir "$pr" --max-time 30 --max-filesize "$max" -o "$out" -- "$url" 2> /dev/null
}

# The awk both the strict matcher and the loose search are written in, as one text (no single quote in it, so it
# can sit in one): how a name is made alike, the short names DOS folders have, and the strict rules.
BC_AWKF='
function squash(s) { gsub(/ /, "", s); return s }
function words(s,   n, i, a, c, p, o, w) {
	o = ""; p = ""
	for (i = 1; i <= length(s); i++) {
		c = substr(s, i, 1)
		if (p ~ /[a-z]/ && c ~ /[0-9]/) o = o " "
		o = o c; p = c
	}
	n = split(o, a, " ")
	o = ""
	for (i = 1; i <= n; i++) {
		w = a[i]
		if (i > 1) {
			if (w == "ii") w = "2"; else if (w == "iii") w = "3"; else if (w == "iv") w = "4"
			else if (w == "vi") w = "6"; else if (w == "vii") w = "7"; else if (w == "viii") w = "8"; else if (w == "ix") w = "9"
			else if (w == "v" && (i == n || a[i - 1] !~ /^(of|the|a|an|and|in|for|to)$/)) w = "5"
			else if (w == "i" && a[i - 1] !~ /^(of|the|a|an|and|in|for|to|that|what|when|where|how|why|if|as|so|am|do|did|can|will|but|or)$/) w = "1"
		}
		o = o (o == "" ? "" : " ") w
	}
	return o
}
function norm(s,   x) {
	x = tolower(s)
	sub(/\.png$/, "", x)
	gsub(/\([^)]*\)/, " ", x)
	gsub(/\[[^]]*\]/, " ", x)
	gsub(sq, "", x)
	gsub(/[`"]/, "", x)
	gsub(/[ \t]+$/, "", x)
	if (match(x, /, (the|a|an)$/)) x = substr(x, RSTART + 2) " " substr(x, 1, RSTART - 1)
	gsub(/&/, " and ", x)
	gsub(/[^a-z0-9]+/, " ", x)
	gsub(/^ +| +$/, "", x)
	x = words(x)
	if (x ~ /^(the|a|an) /) sub(/^(the|a|an) /, "", x)
	return x
}
function lev1(a, b,   la, lb, i, k, tmp, ch) {
	la = length(a); lb = length(b)
	if (la - lb > 1 || lb - la > 1) return 0
	if (la == lb) {
		k = 0
		for (i = 1; i <= la; i++) if (substr(a, i, 1) != substr(b, i, 1)) { k++; ch = substr(a, i, 1) substr(b, i, 1); if (ch ~ /[0-9]/ || k > 1 || i == la) return 0 }
		return k == 1
	}
	if (la < lb) { tmp = a; a = b; b = tmp; la = length(a); lb = length(b) }
	for (i = 1; i <= lb; i++) if (substr(a, i, 1) != substr(b, i, 1)) break
	if (substr(a, i, 1) ~ /[0-9]/ || i >= la) return 0
	return substr(a, i + 1) == substr(b, i)
}
function alias(q,   d) {
	d = substr(q, length(q), 1)
	if (q ~ /^(prince|pop|pop1)$/) return "prince of persia"
	if (q ~ /^pop ?2$/) return "prince of persia 2"
	if (q ~ /^wolf ?3d$/) return "wolfenstein 3d"
	if (q ~ /^doom ?2$/) return "doom 2"
	if (q ~ /^dott$/) return "day of the tentacle"
	if (q ~ /^sam ?(and|n)? ?max$/) return "sam and max hit the road"
	if (q ~ /^mi ?1$/) return "secret of monkey island"
	if (q ~ /^mi ?2$/) return "monkey island 2"
	if (q ~ /^lsl ?[0-9]$/) return "leisure suit larry " d
	if (q ~ /^kq ?[0-9]$/) return "kings quest " d
	if (q ~ /^sq ?[0-9]$/) return "space quest " d
	if (q ~ /^pq ?[0-9]$/) return "police quest " d
	if (q ~ /^sc ?2000$/ || q ~ /^sc2k$/) return "simcity 2000"
	if (q ~ /^civ$/) return "civilization"
	if (q ~ /^civ ?[0-9]$/) return "civilization " d
	if (q ~ /^xcom$/) return "x com ufo defense"
	if (q ~ /^cnc$/) return "command and conquer"
	if (q ~ /^war ?2$/) return "warcraft 2"
	if (q ~ /^mom$/) return "master of magic"
	if (q ~ /^moo$/) return "master of orion"
	if (q ~ /^moo ?2$/) return "master of orion 2"
	return q
}
function nwords(s,   a) { return split(s, a, " ") }
function score(q, qs, qn, numbered, n, ns,   tail) {
	if (n == q) return 0
	if (ns == qs) return 0.2
	if (numbered && index(n, q " ") == 1) return 1 + length(n) / 100
	tail = substr(q, length(n) + 2)
	if (qn >= 3 && nwords(n) >= 2 && index(q, n " ") == 1 && tail ~ /^(sci|vga|ega|cga|cd|dos|english|en)$/) return 2 + length(q) / 100
	if (numbered && qn >= 2 && index(" " n " ", " " q " ") > 0) return 3 + length(n) / 100
	if (length(qs) >= 10 && qn == nwords(n) && substr(qs, 1, 3) == substr(ns, 1, 3) && lev1(qs, ns)) return 4
	return -1
}
'

# Which of the listed covers is the game's. Both names are made alike first:
# lower case, without the (year) or [tags], the apostrophes, the leading or
# trailing "the", "&" as "and", the punctuation, a number split from the letters
# before it ("keen1") and a Roman numeral as a number. Then, best first: the
# same name; the same but for spaces (Sim City, SimCity); for a game whose name
# ends in a number ("Larry 2"), a name that starts with it, which is the one
# with its subtitle, or has it inside ("Leisure Suit Larry 2: ..."); the name
# with a format suffix (sci, vga, cd); and one slip of a letter in a long
# name, never in a number or the last letter, which is the difference between
# a game and its sequel or its plural. A few short names DOS folders have (PRINCE,
# LSL2, KQ5, WOLF3D) are spelled out first. A demo is the last choice, a (year)
# a little better. A series name alone is not guessed at, nor a sequel taken
# for its first game: a wrong cover is worse than none. Gives the encoded file
# name, or nothing.
fn bc_match(title, lst) {
	local r

	r=$(awk -F '\t' -v title="$title" "$BC_AWKF"'
BEGIN {
	sq = sprintf("%c", 39)
	q = alias(norm(title)); qs = squash(q); best = ""; bs = 1e9
	qn = nwords(q); numbered = (q ~ / [0-9]+$/)
}
q == "" || length(qs) < 3 { next }
{
	n = norm($1); ns = squash(n)
	s = score(q, qs, qn, numbered, n, ns)
	if (s < 0) next
	if (tolower($1) ~ /\((demo|beta|proto|prototype|sample|alpha|preview)/) s += 3
	if ($1 ~ /\(1[0-9][0-9][0-9]\)|\(20[0-9][0-9]\)/) s -= 0.5
	if (s < bs) { bs = s; best = $2 }
}
END { if (best != "") print best }
' "$lst")
	ret "$r"
}

# Fetch a box's cover into it as .cover.png, whatever BX_ART says: its box art,
# else its title screen (or only the one set, named as the second argument).
# Status 1 when there is none to be had, 2 when what came back was not a PNG.
fn bc_fetch(box, only = "") {
	local lst title enc tmp magic url set got=1

	bm_up "$box"
	[ -r "$box/boxer.json" ] || return 1
	json parse BCJ "$(< "$box/boxer.json")" 2> /dev/null || return 1
	title := bp_get BCJ .title "${box##*/}"
	title=${title%.boxer}
	title=${title%.gamebox}
	for set in boxarts titles; do
		[ -n "$only" ] && [ "$only" != "$set" ] && continue
		lst := bc_list "$set" || continue
		enc := bc_match "$title" "$lst"
		[ -n "$enc" ] || continue
		url := bc_url "$set"
		tmp="$box/.cover.png.part"
		bc_get "$url$enc" "$tmp" 8000000 || { command rm -f -- "$tmp"; continue; }
		magic=$(head -c 8 "$tmp" | od -An -tx1 | tr -d ' \n')
		if [ "$magic" != 89504e470d0a1a0a ] || [ "$(stat -c %s "$tmp")" -lt 60 ]; then
			command rm -f -- "$tmp"
			got=2
			continue
		fi
		command mv -f -- "$tmp" "$box/.cover.png"
		bc_kind_set "$box" "$([ "$set" = titles ] && echo title || echo box)"
		return 0
	done
	return $got
}

# A picture's size in pixels from its PNG header, "width height"; status 1 if it is not one.
fn bc_dims(f) {
	local w h

	[ "$(head -c 8 "$f" | od -An -tx1 | tr -d ' \n')" = 89504e470d0a1a0a ] || return 1
	read -r w h <<< "$(tail -c +17 "$f" | head -c 8 | od -An -tu1 | awk '{ print $1 * 16777216 + $2 * 65536 + $3 * 256 + $4, $5 * 16777216 + $6 * 65536 + $7 * 256 + $8 }')"
	[ "${w:-0}" -gt 0 ] && [ "${h:-0}" -gt 0 ] || return 1
	ret "$w $h"
}

# Every cover that could be the game's, best first, as "score<TAB>set<TAB>name<TAB>encoded name": loose where the
# matcher is strict, since a person is going to look. A query word found whole or at the start of a word counts,
# and a number that is in one name and not the other (a sequel) costs a lot. The strict matcher's choice leads.
fn bc_candidates(query, int max = 16) {
	local set lst
	local -a files=()

	for set in boxarts titles snaps; do
		lst := bc_list "$set" || continue
		files+=("$lst")
	done
	[ "${#files[@]}" -gt 0 ] || return 1
	awk -F '\t' -v query="$query" "$BC_AWKF"'
function stopw(w) { return w ~ /^(of|the|and|a|an|in|to|for)$/ }
function loose(q, qs, n, ns,   i, j, m, nq, nn, qt, nt, hit, part, f, s, g) {
	nq = 0; nn = 0
	m = split(q, g, " "); for (i = 1; i <= m; i++) if (!stopw(g[i])) qt[++nq] = g[i]
	m = split(n, g, " "); for (i = 1; i <= m; i++) if (!stopw(g[i])) nt[++nn] = g[i]
	if (nq == 0 || nn == 0) return -1
	hit = 0; part = 0
	for (i = 1; i <= nq; i++) {
		f = 0
		for (j = 1; j <= nn; j++) if (nt[j] == qt[i]) { f = 1; break }
		if (f) { hit++; continue }
		if (length(qt[i]) >= 4 && qt[i] !~ /^[0-9]+$/)
			for (j = 1; j <= nn; j++)
				if (nt[j] !~ /^[0-9]+$/ && (index(nt[j], qt[i]) == 1 || (length(nt[j]) >= 4 && index(qt[i], nt[j]) == 1))) { part++; break }
	}
	if (hit + part == 0) return -1
	if (nq >= 2 && hit + part < nq / 2) return -1
	s = 100 * (hit + 0.5 * part) / nq + 40 * hit / nn
	for (i = 1; i <= nq; i++) if (qt[i] ~ /^[0-9]+$/) { f = 0; for (j = 1; j <= nn; j++) if (nt[j] == qt[i]) f = 1; if (!f) s -= 30 }
	for (j = 1; j <= nn; j++) if (nt[j] ~ /^[0-9]+$/) { f = 0; for (i = 1; i <= nq; i++) if (qt[i] == nt[j]) f = 1; if (!f) s -= 20 }
	if (n == q) s += 100
	else if (ns == qs) s += 80
	return s
}
BEGIN {
	sq = sprintf("%c", 39)
	q = alias(norm(query)); qs = squash(q); qn = nwords(q); numbered = (q ~ / [0-9]+$/)
	if (length(qs) < 2) exit
}
FNR == 1 { set = FILENAME; sub(/^.*dos-/, "", set); sub(/\.lst$/, "", set); pri = (set == "boxarts") ? 3 : (set == "titles" ? 1 : 0) }
{
	n = norm($1); ns = squash(n)
	s = loose(q, qs, n, ns)
	if (s < 0) next
	t = score(q, qs, qn, numbered, n, ns)
	if (t >= 0) s += 150 - 10 * t
	s += pri
	if ($1 ~ /\(1[0-9][0-9][0-9]\)|\(20[0-9][0-9]\)/) s += 1
	if (tolower($1) ~ /\((demo|beta|proto|prototype|sample|alpha|preview)/) s -= 10
	name = $1; sub(/\.png$/, "", name)
	printf "%.1f\t%s\t%s\t%s\n", s, set, name, $2
}
' "${files[@]}" | sort -t "$(printf '\t')" -k1,1nr | head -n "$max"
}

# A cover's picture for the picker, kept in the cache: its path when it is there or can be fetched and is a PNG.
fn bc_thumb(set, enc) {
	local d f tmp u

	d=${XDG_CACHE_HOME:-$HOME/.cache}/hibr/boxer/thumbs/$set
	f="$d/$enc"
	if [ -s "$f" ]; then
		echo "$f"
		return 0
	fi
	mkdir -p "$d" || return 1
	tmp="$f.part"
	u := bc_url "$set"
	bc_get "$u$enc" "$tmp" 8000000 || { command rm -f -- "$tmp"; return 1; }
	if [ "$(head -c 8 "$tmp" | od -An -tx1 | tr -d ' \n')" != 89504e470d0a1a0a ]; then
		command rm -f -- "$tmp"
		return 1
	fi
	command mv -f -- "$tmp" "$f" || return 1
	echo "$f"
}

# The picker's search, run as a job: the candidates for a query with their pictures, as "set<TAB>name<TAB>path".
fn bc_pick(query) {
	local sc set name enc p

	bc_candidates "$query" 16 | while IFS="$(printf '\t')" read -r sc set name enc; do
		p=$(bc_thumb "$set" "$enc") || continue
		printf '%s\t%s\t%s\n' "$set" "$name" "$p"
	done
}

# What a box's cover is: box (the box art), title (a title screen), own (the
# person's), or nothing when it came with the game.
fn bc_kind(box) {
	local k

	json parse BCJ "$(< "$box/boxer.json")" 2> /dev/null || return 1
	k := bp_get BCJ .cover.kind ""
	ret "$k"
}

fn bc_kind_set(box, kind) {
	json parse BCJ "$(< "$box/boxer.json")" 2> /dev/null || return 0
	json set BCJ .cover.kind "$kind" -s
	json emit BCJ -p > "$box/boxer.json"
	return 0
}

# The boxes waiting for a cover to be fetched in the background, one at a time
# so that two do not both fetch the list of names.
BCQ=()

# Fetch a box's cover without holding the desktop up: a job, said in a note
# when it is done. Where there is no desktop it is done here and now.
fn bc_later(box) {
	if ! dt_has dt_job; then
		bc_fetch "$box"
		return 0
	fi
	BCQ+=("$box")
	bc_next
	return 0
}

fn bc_next() {
	local box n

	[ "${#BCQ[@]}" -gt 0 ] || return 0
	dt_jobrunning cover > /dev/null 2>&1 && return 0
	box=${BCQ[0]}
	BCQ=("${BCQ[@]:1}")
	n := dt_job cover "$box" bc_done bc_fetch "$box"
	return 0
}

# A background fetch ended: say how it went, and start the next.
fn bc_done(int n, int st) {
	local box=${DTJ[$n]["tag"]} name

	name=${box##*/}
	name=${name%.*}
	case $st in
	0) dt_notep low "Cover found for $name" ;;
	2) dt_notep low "What came back for $name was not a picture, so it was not kept" ;;
	*) dt_notep low "No cover found for $name" ;;
	esac
	bc_next
	return 0
}

# Put a picture of the person's own in as a box's cover. A PNG only.
fn bc_set(box, pic) {
	local magic

	[ -r "$pic" ] || { echo "boxer: no such file: $pic" >&2; return 1; }
	magic=$(head -c 8 "$pic" | od -An -tx1 | tr -d ' \n')
	[ "$magic" = 89504e470d0a1a0a ] || { echo "boxer: a cover must be a PNG: $pic" >&2; return 1; }
	command cp -f -- "$pic" "$box/.cover.png" || return 1
	bc_kind_set "$box" own
	return 0
}

# After an import: a cover the game came with or sat beside, else, when it is
# switched on, the one fetched. src is what was imported.
fn bc_auto(box, src) {
	local d f n

	[ -n "$(bc_path "$box")" ] && return 0
	d=${src%/}
	[ -d "$d" ] || d=${d%/*}
	n=${src%/}
	n=${n##*/}
	n=${n%.*}
	for f in "$d/.cover.png" "$d/cover.png" "$d/$n.png" "$src/cover.png"; do
		[ -f "$f" ] && bc_set "$box" "$f" 2> /dev/null && return 0
	done
	[ "$BX_ART" = on ] && bc_later "$box"
	return 0
}

# Make a gamebox, then give it its cover.
fn bx_import(src, title = "", mode = auto) {
	local box

	box := bx_import_box "$src" "$title" "$mode" || return 1
	bc_auto "$box" "$src"
	ret "$box"
}

# Make a gamebox on the shelf from src -- a folder, an archive, a CD image or
# a lone program -- the way Boxer does, and say where it is.
#
# What the files are decides it: a game with an installer and nothing to say it
# is installed already is set up to run the installer, with the folder as a CD
# in D:; the person plays through it, and when the window closes what it put
# on C: is the game and the CD is kept. A game with no installer, or one that
# says it is installed, is copied into C:. mode is auto, install or installed
# to say which.
fn bx_import_box(src, title = "", mode = auto) {
	local base name box work tmp= iso=0 found

	[ -e "$src" ] || { echo "boxer: no such file or folder: $src" >&2; return 1; }
	base=${src%/}
	base=${base##*/}
	base=${base%.*}
	work=$src
	case ${src,,} in
	*.iso | *.cue | *.img | *.bin) iso=1 ;;
	*.zip)
		command -v unzip > /dev/null || { echo "boxer: unzip is needed to open a zip" >&2; return 1; }
		tmp=$(mktemp -d) || return 1
		unzip -q -o -d "$tmp" "$src" > /dev/null || { command rm -rf -- "$tmp"; return 1; }
		work=$tmp ;;
	*.tar | *.tar.gz | *.tgz | *.tar.xz | *.tar.bz2)
		tmp=$(mktemp -d) || return 1
		tar -xf "$src" -C "$tmp" || { command rm -rf -- "$tmp"; return 1; }
		work=$tmp ;;
	*.exe | *.com | *.bat)
		tmp=$(mktemp -d) || return 1
		command cp -- "$src" "$tmp/" || { command rm -rf -- "$tmp"; return 1; }
		work=$tmp ;;
	*) [ -d "$src" ] || { echo "boxer: not a folder, archive, disc image or program: $src" >&2; return 1; } ;;
	esac
	name := bx_unique "${title:-$base}"
	box="${BX_TO:-$BX_SHELF}/$name.boxer"
	mkdir -p "$box/engine" "$box/drives/c" "$box/drives/d" "$box/saves" "$box/extras" || return 1
	if [ "$iso" = 1 ]; then
		command cp -- "$src" "$box/drives/d/" || { command rm -rf -- "$box" "$tmp"; return 1; }
		[ -e "${src%.*}.bin" ] && [ "${src##*.}" = cue ] && command cp -- "${src%.*}.bin" "$box/drives/d/"
		[ -e "${src%.*}.BIN" ] && [ "${src##*.}" = CUE ] && command cp -- "${src%.*}.BIN" "$box/drives/d/"
		tmp=$(mktemp -d)
		if bd_extract "$box/drives/d/${src##*/}" "$tmp"; then
			bx_discplan "$box" "$name" "$tmp" "$mode"
		else
			echo "boxer: $base added with its disc in D:; nothing here can read inside a disc image (xorriso, 7z or bsdtar), so it starts at the DOS prompt" >&2
			bd_describe "$box" "$name" installed
		fi
		command rm -rf -- "$tmp"
		ret "$box"
		return 0
	fi
	bd_scan "$work"
	if [ "$BD_WINN" -gt 0 ] && ! printf '%s\n' "$BD_DOS" | grep -vi '\.bat$' | grep -q .; then
		echo "boxer: $base is a Windows game, and Boxer plays DOS games" >&2
		command rm -rf -- "$box" "$tmp"
		return 1
	fi
	if [ -z "$BD_DOS" ] && [ "$BD_TELLY" = 0 ] && [ "$BD_CONFN" = 0 ]; then
		echo "boxer: no DOS programs in $base" >&2
		command rm -rf -- "$box" "$tmp"
		return 1
	fi
	found=$BD_INST
	if [ "$mode" = auto ]; then
		mode=installed
		[ -n "$found" ] && [ "$BD_TELLY" = 0 ] && mode=install
	fi
	if [ "$mode" = install ] && [ -n "$found" ]; then
		bx_disc "$work" "$box" || { command rm -rf -- "$box" "$tmp"; return 1; }
		bd_describe "$box" "$name" installing
		BD_DINST=
	else
		command rmdir "$box/drives/d" 2> /dev/null
		bx_copyin "$work" "$box" "$name"
		bd_describe "$box" "$name" installed
	fi
	[ -n "$tmp" ] && command rm -rf -- "$tmp"
	ret "$box"
}

# Put the disc a game installs from into D:: as a disc image when a tool here
# can make one, so that DOS sees a CD-ROM, else as a folder.
fn bx_disc(work, box) {
	local stage

	stage=$(mktemp -d) || return 1
	command cp -R -- "$work"/. "$stage/" || { command rm -rf -- "$stage"; return 1; }
	bx_hoist "$stage"
	bx_dosify "$stage"
	bd_scan "$stage"
	BD_DINST=$BD_INST
	if bd_mkiso "$stage" "$box/drives/d/disc.iso"; then
		command rm -rf -- "$stage"
	else
		command cp -R -- "$stage"/. "$box/drives/d/" || { command rm -rf -- "$stage"; return 1; }
		command rm -rf -- "$stage"
	fi
	return 0
}

# What a game's disc image holds decides what to do with it, as a folder's files
# do: Windows only, or nothing DOS, is turned away; an installer is run first,
# from the image as D:; a game that runs from its disc lists its programs on D:.
fn bx_discplan(box, name, tree, mode) {
	local prog list=

	bd_scan "$tree"
	if [ "$BD_WINN" -gt 0 ] && ! printf '%s\n' "$BD_DOS" | grep -vi '\.bat$' | grep -q .; then
		echo "boxer: $name is a Windows game, and Boxer plays DOS games" >&2
	fi
	if [ "$mode" = auto ]; then
		mode=installed
		[ -n "$BD_INST" ] && [ "$BD_TELLY" = 0 ] && mode=install
	fi
	if [ "$mode" = install ] && [ -n "$BD_INST" ]; then
		BD_DINST=$BD_INST
		bd_describe "$box" "$name" installing
		BD_DINST=
		return 0
	fi
	list=$(bd_programs "$tree" D)
	BD_DPROGS=$list
	bd_describe "$box" "$name" installed
	BD_DPROGS=
	return 0
}

# Copy an installed game into drive C: of the box, in a folder of its own when
# it would otherwise be loose in the root, with names DOS can hold.
fn bx_copyin(work, box, name) {
	local sub

	if bd_wantsfolder "$work"; then
		sub := bd_dosname "$name"
		mkdir -p "$box/drives/c/$sub"
		command cp -R -- "$work"/. "$box/drives/c/$sub/" || return 1
	else
		command cp -R -- "$work"/. "$box/drives/c/" || return 1
	fi
	bx_hoist "$box/drives/c"
	bx_dosify "$box/drives/c"
	return 0
}

# A box made before its names were made DOS-sized, or by hand: the same
# treatment, what the person set kept.
fn bx_fix(box) {
	local new

	case $box in
	*.gamebox)
		new=${box%.gamebox}.boxer
		[ -e "$new" ] || { command mv -- "$box" "$new" && box=$new; }
		;;
	esac
	bm_up "$box"
	[ -r "$box/boxer.json" ] || { echo "boxer: not a box: $box" >&2; return 1; }
	json parse BXJ "$(< "$box/boxer.json")" || return 1
	bx_hoist "$box/drives/c"
	bx_dosify "$box/drives/c"
	[ -d "$box/drives/d" ] && bx_dosify "$box/drives/d"
	bd_describe "$box" "${box##*/}" ""
	ret "$box"
}

# --- a game's settings ----------------------------------------------------------
#
# Boxer's own way of changing one game's settings, in the Game Settings window.
# What is chosen is written into the game's boxer.json, so it goes with the box wherever the box goes, and wins
# over what Control Panel > Boxer says for every game ("default" means that).

BXI_FIELDS=(prog render aspect cycles machine voodoo vspeed sound irq dma port midi mouse capture limit cpu)
BXI_LABELS=("Program" "Rendering" "Shape" "Speed" "Graphics" "3D (Voodoo)" "3D Speed" "Sound Card" "Sound IRQ" "Sound DMA" "Sound Port" "MIDI" "Mouse" "Capture" "Speed Limit" "CPU")
BXI_IRQ=(default 3 5 7 9 10 11 12)
BXI_DMA=(default 0 1 3 5 6 7)
BXI_PORT=(default 210 220 230 240 250 260 280)
BXI_RENDER=(default follow pixels half)
BXI_ASPECT=(default 4:3 auto 16:10 16:9 1:1)
BXI_CYCLES=(default auto max 3000 8000 20000 50000)
BXI_MACHINE=(default svga_s3 vgaonly ega cga tandy hercules)
BXI_VOODOO=(default 8mb 12mb 4mb off)
BXI_VSPEED=(default multi multi-low single single-low)
BXI_SOUND=(default sb16 sbpro2 sb1 none)
BXI_MOUSE=(default direct relative off)
BXI_CAPTURE=(default seamless click)
BXI_LIMIT=(default unlimited pentium2 pentium 486dx2 486dx 386)
BXI_CPU=(default auto 386 386_slow 386_prefetch 486_slow pentium_slow)

# Where in the box's document a field lives.
fn bxi_path(field) {
	case $field in
	prog) ret .launch.program ;;
	render) ret .display.render ;;
	aspect) ret .display.aspect ;;
	cycles) ret .cpu.cycles ;;
	machine) ret .machine ;;
	voodoo) ret .voodoo ;;
	vspeed) ret .voodoospeed ;;
	sound) ret .sound.card ;;
	irq) ret .sound.irq ;;
	dma) ret .sound.dma ;;
	port) ret .sound.port ;;
	midi) ret .midi ;;
	mouse) ret .mouse ;;
	capture) ret .capture ;;
	limit) ret .cpu.limit ;;
	cpu) ret .cpu.type ;;
	esac
}

# The same, for the box at this path: the settings dialog has no shelf.
fn bx_info_loadbox(int id, box) {
	local f v n i p

	bm_up "$box"
	BX[$id]["ibox"]=$box
	BX[$id]["iprogs"]=
	for f in "${BXI_FIELDS[@]}"; do BX[$id]["i_$f"]=default; done
	[ -r "$box/boxer.json" ] || return 0
	json parse BXJ "$(< "$box/boxer.json")" 2> /dev/null || return 0
	for f in "${BXI_FIELDS[@]}"; do
		p := bxi_path "$f"
		v := json get BXJ "$p" 2> /dev/null || v=
		[ -n "$v" ] && BX[$id]["i_$f"]=$v
	done
	n := json len BXJ .programs 2> /dev/null || n=0
	for ((i = 0; i < n; i++)); do
		v := json get BXJ ".programs[$i]" 2> /dev/null || continue
		BX[$id]["iprogs"]="${BX[$id]["iprogs"]}${BX[$id]["iprogs"]:+ }$v"
	done
	return 0
}

# Write one setting into the box, and show it.
fn bx_info_set(int id, field, value) {
	local box=${BX[$id]["ibox"]-} p

	bm_up "$box"
	[ -r "$box/boxer.json" ] || return 0
	json parse BXJ "$(< "$box/boxer.json")" 2> /dev/null || return 0
	p := bxi_path "$field"
	json set BXJ "$p" "$value" -s
	[ "$field" = prog ] && json set BXJ .installer false
	json emit BXJ -p > "$box/boxer.json"
	BX[$id]["i_$field"]=$value
	return 0
}

# A drop-down's choice comes back as "id value"; which field it was for is
# remembered in the window's state.
fn bxi_pick(int id, value = "") {
	bx_info_set "$id" "${BX[$id]["pick"]}" "$value"
}

# The choices for a field.
fn bxi_choices(int id, field) {
	local l f

	case $field in
	prog) ret "${BX[$id]["iprogs"]}" ;;
	render) ret "${BXI_RENDER[*]}" ;;
	aspect) ret "${BXI_ASPECT[*]}" ;;
	cycles) ret "${BXI_CYCLES[*]}" ;;
	machine) ret "${BXI_MACHINE[*]}" ;;
	voodoo) ret "${BXI_VOODOO[*]}" ;;
	vspeed) ret "${BXI_VSPEED[*]}" ;;
	sound) ret "${BXI_SOUND[*]}" ;;
	irq) ret "${BXI_IRQ[*]}" ;;
	dma) ret "${BXI_DMA[*]}" ;;
	port) ret "${BXI_PORT[*]}" ;;
	midi) l="default disabled"; if dt_has bp_midilist; then while IFS= read -r f; do [ -n "$f" ] && l="$l $f"; done <<< "$(bp_midilist)"; fi; ret "$l" ;;
	mouse) ret "${BXI_MOUSE[*]}" ;;
	capture) ret "${BXI_CAPTURE[*]}" ;;
	limit) ret "${BXI_LIMIT[*]}" ;;
	cpu) ret "${BXI_CPU[*]}" ;;
	esac
}

# Open a field's choices under it.
fn bxi_open(int id, field, int r, int c) {
	local ch
	local -a o

	ch := bxi_choices "$id" "$field"
	read -ra o <<< "$ch"
	[ "${#o[@]}" -gt 0 ] || return 0
	BX[$id]["pick"]=$field
	dt_droplist "$id" "$r" "$c" bxi_pick "${o[@]}"
}

# Step a field on or back by one choice.
fn bxi_step(int id, field, int dir) {
	local ch cur=${BX[$id]["i_$field"]} i n=0 k=0
	local -a o

	ch := bxi_choices "$id" "$field"
	read -ra o <<< "$ch"
	n=${#o[@]}
	[ "$n" -gt 0 ] || return 0
	for ((i = 0; i < n; i++)); do
		[ "${o[$i]}" = "$cur" ] && k=$i
	done
	k=$(((k + dir + n) % n))
	bx_info_set "$id" "$field" "${o[$k]}"
}

# The fields, a row each from row r0: the name, then its choice as a drop-down.
fn bx_info_fields(int id, int r0, int c0, int w, focused) {
	local i f r on

	for i in "${!BXI_FIELDS[@]}"; do
		f=${BXI_FIELDS[$i]}
		r=$((r0 + i))
		on=0
		[ "$focused" = 1 ] && [ "${BX[$id]["ifield"]:-0}" = "$i" ] && on=1
		if [ "$on" = 1 ]; then console pen "$DT_SELINK" "$DT_ACTIVE"; else console pen "$DT_INK" "$DT_FACE"; fi
		dt_tput "$id" "$r" "$c0" "${BXI_LABELS[$i]}"
		console pen "$DT_INK" "$DT_FACE"
		dt_wdrop "$id" "$r" $((c0 + 12)) $((w - 12)) "${BX[$id]["i_$f"]:-default}" "$f"
	done
	return 0
}

# A key for the fields: up and down choose one, left and right step its
# value, Enter opens its choices. Status 1 when it was not one of those.
fn bxi_key(int id, key, int r0, int c0) {
	local i=${BX[$id]["ifield"]:-0} nf=${#BXI_FIELDS[@]} f

	f=${BXI_FIELDS[$i]}
	case $key in
	up) BX[$id]["ifield"]=$(((i + nf - 1) % nf)) ;;
	down) BX[$id]["ifield"]=$(((i + 1) % nf)) ;;
	left) bxi_step "$id" "$f" -1 ;;
	right | " ") bxi_step "$id" "$f" 1 ;;
	enter) bxi_open "$id" "$f" $((r0 + i)) $((c0 + 12)) ;;
	*) return 1 ;;
	esac
	return 0
}

# A click on a field: it becomes the chosen one and its choices open.
fn bxi_click(int id, int r, int c) {
	local tag i f

	tag := dt_hit "$id" "$r" "$c" || return 1
	for i in "${!BXI_FIELDS[@]}"; do
		[ "${BXI_FIELDS[$i]}" = "$tag" ] && { BX[$id]["ifield"]=$i; f=$tag; }
	done
	[ -n "${f-}" ] || return 1
	bxi_open "$id" "$f" "$r" "$c"
	return 0
}

# Import each path given. The copy is done here, in the desktop's own time, so
# a very large game holds the window still.
fn bx_import_all(int id, ...paths) {
	local p b n=0 names=

	BX_TO=$BX_SHELF
	mkdir -p "$BX_TO" 2> /dev/null

	for p in "${paths[@]}"; do
		if b := bx_import "$p"; then
			n=$((n + 1))
			b=${b##*/}
			names="$names${names:+, }${b%.boxer}"
		fi
	done
	BX_TO=
	if [ "$n" -gt 0 ]; then
		BX[$id]["status"]="Added $names"
	else
		BX[$id]["status"]="Boxer could not import that"
	fi
	return 0
}

# A folder, archive, CD image or program dropped from Files: made into a game.
fn boxer_drop(int id, int r, int c, op, ...paths) {
	bx_import_all "$id" "${paths[@]}"
}

fn bx_picked(int id, path, type = "") {
	bx_import_all "$id" "$path"
}

fn bx_pick(int id) {
	dt_filepick open "Import a Game" \
		"Games:*.zip *.tar *.tar.gz *.tgz *.exe *.com *.bat *.iso *.cue|All files:*" \
		"$HOME" "" bx_picked "$id"
}

fn bx_folder(int id) {
	mkdir -p "$BX_SHELF" 2> /dev/null
	dt_launch files "$BX_SHELF" > /dev/null
	return 0
}

# --- the import window ----------------------------------------------------------
#
# A diskette and a CD, drawn in half blocks so that any terminal shows them, and
# what to do with them.

declare -gA BXA=([k]="#1b1b2f" [b]="#3b5bdb" [m]="#ced4da" [M]="#868e96" [w]="#f8f9fa" [r]="#e03131"
	[S]="#f1f3f5" [s]="#adb5bd" [p]="#845ef7" [c]="#22b8cf")
BXA_DISK=("kkkkkkkkkkkkkkk." "kbbbmmmmmmmbbbbk" "kbbbmmmMMmmbbbbk" "kbbbmmmMMmmbbbbk" "kbbbmmmmmmmbbbbk" "kbbbbbbbbbbbbbbk" "kbbbbbbbbbbbbbbk" "kbwwwwwwwwwwwwbk" "kbwrrrrrrrrrrwbk" "kbwwwwwwwwwwwwbk" "kbwrrrrrrrwwwwbk" "kbwwwwwwwwwwwwbk" "kbwwwwwwwwwwwwbk" "kbbbbbbbbbbbbbbk" "kbbbbbbbbbbbbbbk" "kkkkkkkkkkkkkkkk")
BXA_CD=("......kkkk......" "....kkssSSkk...." "..kkccsSSSsskk.." "..kcccSSSssssk.." ".kccccSSSSssssk." ".kcccSSkkSSsssk." "kssSSSk..kSSsssk" "ksSSSk....kSsssk" "kSSSSk....kSsssk" "kSSsSSk..kSSsssk" ".ksssSSkkSSpppk." ".kssssSSSSppppk." "..kssssssspppk.." "..kkssssssppkk.." "....kksssskk...." "......kkkk......")

# A 16 by 16 picture of letters, one half block to a pixel, at row r0, column c0.
fn bx_pix(int id, int r0, int c0, ...rows) {
	local y x t b run glyph fg bg rs

	for ((y = 0; y < 16; y += 2)); do
		x=0
		while [ "$x" -lt 16 ]; do
			t=${rows[$y]:$x:1}
			b=${rows[$((y + 1))]:$x:1}
			run=1
			while [ $((x + run)) -lt 16 ] && [ "${rows[$y]:$((x + run)):1}" = "$t" ] &&
			      [ "${rows[$((y + 1))]:$((x + run)):1}" = "$b" ]; do
				run=$((run + 1))
			done
			if [ "$t" != . ] || [ "$b" != . ]; then
				if [ "$t" = . ]; then glyph="▄"; fg=${BXA[$b]}; bg=$DT_FACE
				elif [ "$b" = . ]; then glyph="▀"; fg=${BXA[$t]}; bg=$DT_FACE
				else glyph="▀"; fg=${BXA[$t]}; bg=${BXA[$b]}; fi
				console pen "$fg" "$bg"
				printf -v rs '%*s' "$run" ""
				console put -p "w$id" $((r0 + y / 2)) $((c0 + x)) "${rs// /$glyph}"
			fi
			x=$((x + run))
		done
	done
	return 0
}

fn boxer_open(int id, arg = "") {
	BX[$id]["status"]=
	BX[$id]["focus"]=import
	[ -n "$arg" ] && bx_import_all "$id" "$arg"
	return 0
}

fn boxer_draw(int id, int h, int w, int row, int col) {
	local f=${BX[$id]["focus"]:-import} l

	dt_wclear "$id"
	console pen "$DT_INK" "$DT_FACE"
	console fill -p "w$id" 1 1 $((h - 2)) $((w - 2)) " "
	bx_pix "$id" 2 5 "${BXA_DISK[@]}"
	bx_pix "$id" 2 27 "${BXA_CD[@]}"
	console pen "$DT_INK" "$DT_FACE" bold
	dt_tput "$id" 3 47 "Drop a game here"
	console pen "$DT_INK" "$DT_FACE"
	dt_tput "$id" 5 47 "a folder, a zip,"
	dt_tput "$id" 6 47 "a disc image or"
	dt_tput "$id" 7 47 "a program"
	console pen "$DT_DIM" "$DT_FACE"
	dt_tput "$id" 11 3 "Games are kept in"
	console pen "$DT_INK" "$DT_FACE"
	dt_tput "$id" 12 3 "${BX_SHELF:0:$((w - 6))}"
	console pen "$DT_DIM" "$DT_FACE"
	dt_tput "$id" 14 3 "Double-click a game in Files to play it."
	l=${BX[$id]["status"]-}
	if [ -n "$l" ]; then
		console pen "$DT_ACTIVE" "$DT_FACE" bold
		dt_tput "$id" 16 3 "${l:0:$((w - 6))}"
	fi
	dt_dlgbtns "$id" "$h" "$w" "$f" import "Import${GL[ellipsis]}" folder "Open Games Folder"
	return 0
}

fn boxer_key(int id, key) {
	local f=${BX[$id]["focus"]:-import} d
	local -a o=(import folder)

	if d := dt_focuskey "$key" 1; then
		BX[$id]["focus"] := dt_focus "$f" "$d" "${o[@]}"
		return 0
	fi
	case $key in
	enter) if [ "$f" = folder ]; then bx_folder "$id"; else bx_pick "$id"; fi ;;
	i) bx_pick "$id" ;;
	f) bx_folder "$id" ;;
	esac
	return 0
}

fn boxer_click(int id, int r, int c, btn = "") {
	local tag

	tag := dt_hit "$id" "$r" "$c" || return 0
	case $tag in
	import) bx_pick "$id" ;;
	folder) bx_folder "$id" ;;
	esac
	return 0
}

fn boxer_close(int id) {
	unset "BX[$id]"
}

# --- Fetch Cover and Game Is Already Installed, from a game's right-click menu in
# Files: each a small window. Fetch Cover looks at once and says what it found;
# Game Is Already Installed asks first, since it lets go of the disc.

fn bx_askopen(int id, box) {
	local t

	bm_up "$box"
	BX[$id]["ibox"]=$box
	t=${box##*/}
	t=${t%.*}
	if [ -r "$box/boxer.json" ] && json parse BXJ "$(< "$box/boxer.json")" 2> /dev/null; then
		t := bx_title "$t"
	fi
	BX[$id]["name"]=$t
	BX[$id]["said"]=
	BX[$id]["focus"]=ok
	return 0
}

fn bx_askdraw(int id, int h, int w, ...lines) {
	local i=2 l

	dt_wclear "$id"
	console pen "$DT_INK" "$DT_FACE"
	console fill -p "w$id" 1 1 $((h - 2)) $((w - 2)) " "
	for l in "${lines[@]}"; do
		dt_tput "$id" "$i" 3 "${l:0:$((w - 6))}"
		i=$((i + 1))
	done
	return 0
}

# --- Find Cover: a search and the candidates side by side, one chosen ----------------
#
# Opened from a game's right-click menu with the game's name already in the search
# and the best match already selected, so Enter is as quick as a blind fetch was. Type
# to change the search (another spelling, a subtitle) and Enter looks again; the arrows
# or a click choose; Enter or Use This keeps it. The candidates are the libretro
# thumbnails project's box art, title screens and screenshots, found loosely (the
# searching is on this machine; only the pictures are fetched). A picture dropped on
# the window is the cover too.

fn boxerpick_open(int id, arg = "") {
	bx_askopen "$id" "$arg"
	BX[$id]["ptext"]=${BX[$id]["name"]}
	BX[$id]["pcur"]=${#BX[$id]["ptext"]}
	BX[$id]["pfocus"]=0
	BX[$id]["pn"]=0
	BX[$id]["psel"]=0
	BX[$id]["ppage"]=0
	bx_picksearch "$id"
	return 0
}

# Look for the covers for what is in the search: a job, whose answer replaces any earlier one.
fn bx_picksearch(int id) {
	local n

	BX[$id]["pmsg"]=
	if dt_has dt_job; then
		BX[$id]["pbusy"]=1
		n := dt_job boxerpick "$id" bx_pickdone bc_pick "${BX[$id]["ptext"]}"
		BX[$id]["pjob"]=$n
		return 0
	fi
	bx_pickfill "$id" "$(bc_pick "${BX[$id]["ptext"]}")"
	return 0
}

# What a search found, one "set<TAB>name<TAB>path" a line, into the window.
fn bx_pickfill(int id, found) {
	local line i=0

	while IFS= read -r line; do
		[ -n "$line" ] || continue
		BX[$id]["r$i"]=$line
		i=$((i + 1))
	done <<< "$found"
	BX[$id]["pn"]=$i
	BX[$id]["psel"]=0
	BX[$id]["ppage"]=0
	BX[$id]["pbusy"]=0
	[ "$i" = 0 ] && BX[$id]["pmsg"]="Nothing found for \"${BX[$id]["ptext"]}\": try another spelling, or a word of the title"
	return 0
}

fn bx_pickdone(int n, int st) {
	local id=${DTJ[$n]["tag"]} f

	[ -n "${BX[$id]["ibox"]+x}" ] || return 0
	[ "${BX[$id]["pjob"]-}" = "$n" ] || return 0
	f := dt_jobfile "$n" out
	bx_pickfill "$id" "$(< "$f")"
	return 0
}

# What a set of covers is called on a tile.
fn bx_pickkind(set) {
	case $set in
	boxarts) ret "box art" ;;
	titles) ret "title screen" ;;
	*) ret "screenshot" ;;
	esac
}

fn boxerpick_draw(int id, int h, int w, int row, int col) {
	local on=${BX[$id]["pfocus"]:-0} cur=0 n=${BX[$id]["pn"]:-0} sel=${BX[$id]["psel"]:-0} per=8
	local tw th pw ph i k r c d w0 h0 rows cols line set name path msg

	dt_wclear "$id"
	console pen "$DT_INK" "$DT_FACE"
	console fill -p "w$id" 1 1 $((h - 2)) $((w - 2)) " "
	console pen "$DT_INK" "$DT_FACE" bold
	dt_tput "$id" 1 2 "Find a cover for ${BX[$id]["name"]}"
	console pen "$DT_INK" "$DT_FACE"
	dt_tput "$id" 2 2 "Search"
	[ "$on" = 1 ] && cur=${BX[$id]["pcur"]}
	dt_textdraw "$id" 2 10 $((w - 12)) "${BX[$id]["ptext"]}" "$cur" "$on"
	dt_wreg "$id" 2 10 $((w - 12)) q
	tw=$(((w - 4) / 4))
	th=$(((h - 8) / 2))
	[ "$th" -lt 5 ] && th=5
	pw=$((tw - 2))
	ph=$((th - 3))
	for ((i = 0; i < per; i++)); do
		k=$((${BX[$id]["ppage"]:-0} * per + i))
		[ "$k" -lt "$n" ] || break
		r=$((4 + (i / 4) * th))
		c=$((2 + (i % 4) * tw))
		line=${BX[$id]["r$k"]}
		path=${line##*$'\t'}
		name=${line#*$'\t'}
		name=${name%$'\t'*}
		set=${line%%$'\t'*}
		if [ "$k" = "$sel" ]; then
			console pen "$DT_INK" "$DT_WELL"
			console fill -p "w$id" "$r" "$c" "$th" "$((tw - 1))" " "
		fi
		d := bc_dims "$path" || d="3 4"
		read -r w0 h0 <<< "$d"
		cols=$pw
		rows=$(((h0 * cols + w0 * 2 - 1) / (w0 * 2)))
		if [ "$rows" -gt "$ph" ]; then
			rows=$ph
			cols=$((w0 * rows * 2 / h0))
		fi
		[ "$cols" -lt 1 ] && cols=1
		[ "$rows" -lt 1 ] && rows=1
		img draw "$path" $((r + 1 + (ph - rows) / 2)) $((c + 1 + (pw - cols) / 2)) "$rows" "$cols" -m auto -p "w$id" 2> /dev/null
		if [ "$k" = "$sel" ]; then console pen "$DT_INK" "$DT_WELL" bold; else console pen "$DT_INK" "$DT_FACE"; fi
		dt_tput "$id" $((r + th - 2)) $((c + 1)) "${name:0:$pw}"
		console pen "$DT_DIM" "$([ "$k" = "$sel" ] && echo "$DT_WELL" || echo "$DT_FACE")"
		d := bx_pickkind "$set"
		dt_tput "$id" $((r + th - 1)) $((c + 1)) "$d"
		console pen "$DT_INK" "$DT_FACE"
		for ((rows = 0; rows < th; rows++)); do
			dt_wreg "$id" $((r + rows)) "$c" $((tw - 1)) "t$i"
		done
	done
	console pen "$DT_DIM" "$DT_FACE"
	if [ "${BX[$id]["pbusy"]:-0}" = 1 ]; then
		msg="Looking..."
	elif [ -n "${BX[$id]["pmsg"]-}" ]; then
		msg=${BX[$id]["pmsg"]}
	else
		msg="$n found. Enter keeps the one with the marker; arrows or a click choose; PgDn for more"
	fi
	dt_tput "$id" $((h - 4)) 2 "${msg:0:$((w - 4))}"
	dt_tput "$id" $((h - 3)) 2 "Type to change the search, Enter looks again. Esc closes. Drop a picture here to use it."
	dt_dlgbtns "$id" "$h" "$w" ok ok "Use This" cancel Cancel
}

# Keep the picture that has the marker as the game's cover.
fn bx_pickuse(int id) {
	local sel=${BX[$id]["psel"]:-0} line path box=${BX[$id]["ibox"]}

	[ "$sel" -lt "${BX[$id]["pn"]:-0}" ] || return 0
	line=${BX[$id]["r$sel"]}
	path=${line##*$'\t'}
	if ! bc_set "$box" "$path" 2> /dev/null; then
		dt_notep high "That picture could not be used"
		return 0
	fi
	bc_kind_set "$box" picked
	dt_notep low "Cover set for ${BX[$id]["name"]}"
	dt_del "$id"
	return 0
}

fn boxerpick_key(int id, key) {
	local res n=${BX[$id]["pn"]:-0} sel=${BX[$id]["psel"]:-0} per=8

	if [ "${BX[$id]["pfocus"]:-0}" = 1 ]; then
		case $key in
		escape | tab | down) BX[$id]["pfocus"]=0; return 0 ;;
		enter) BX[$id]["pfocus"]=0; bx_picksearch "$id"; return 0 ;;
		esac
		res := dt_textkey "${BX[$id]["ptext"]}" "${BX[$id]["pcur"]}" "$key" || return 0
		BX[$id]["ptext"]=${res% *}
		BX[$id]["pcur"]=${res##* }
		return 0
	fi
	case $key in
	escape) dt_del "$id"; return 0 ;;
	enter) bx_pickuse "$id"; return 0 ;;
	tab) BX[$id]["pfocus"]=1; BX[$id]["pcur"]=${#BX[$id]["ptext"]}; return 0 ;;
	left) [ "$sel" -gt 0 ] && sel=$((sel - 1)) ;;
	right) [ $((sel + 1)) -lt "$n" ] && sel=$((sel + 1)) ;;
	up)
		if [ "$sel" -ge 4 ]; then
			sel=$((sel - 4))
		else
			BX[$id]["pfocus"]=1
			BX[$id]["pcur"]=${#BX[$id]["ptext"]}
			return 0
		fi
		;;
	down) [ $((sel + 4)) -lt "$n" ] && sel=$((sel + 4)) ;;
	pagedown | pgdn) sel=$((sel + per)); [ "$sel" -ge "$n" ] && sel=$((n - 1)) ;;
	pageup | pgup) sel=$((sel - per)); [ "$sel" -lt 0 ] && sel=0 ;;
	*)
		if [ "${#key}" = 1 ] || [ "$key" = backspace ]; then
			BX[$id]["pfocus"]=1
			BX[$id]["pcur"]=${#BX[$id]["ptext"]}
			res := dt_textkey "${BX[$id]["ptext"]}" "${BX[$id]["pcur"]}" "$key" || return 0
			BX[$id]["ptext"]=${res% *}
			BX[$id]["pcur"]=${res##* }
		fi
		return 0
		;;
	esac
	[ "$sel" -lt 0 ] && sel=0
	BX[$id]["psel"]=$sel
	BX[$id]["ppage"]=$((sel / per))
	return 0
}

# The mouse comes here and not to _click: a press on a tile chooses it, a second on the same one keeps it.
fn boxerpick_mouse(int id, act, btn, int r, int c, mods = "") {
	local tag k

	case ${act##*-} in press) ;; *) return 0 ;; esac
	tag := dt_hit "$id" "$r" "$c" || return 0
	case $tag in
	t[0-9]*)
		k=$((${BX[$id]["ppage"]:-0} * 8 + ${tag#t}))
		[ "$k" -lt "${BX[$id]["pn"]:-0}" ] || return 0
		if [ "${BX[$id]["psel"]:-0}" = "$k" ]; then
			bx_pickuse "$id"
		else
			BX[$id]["psel"]=$k
		fi
		BX[$id]["pfocus"]=0
		;;
	q) BX[$id]["pfocus"]=1; BX[$id]["pcur"]=${#BX[$id]["ptext"]} ;;
	ok) bx_pickuse "$id" ;;
	cancel) dt_del "$id" ;;
	esac
	return 0
}

# A picture dropped on the window is the cover, as it is.
fn boxerpick_drop(int id, int r, int c, op, ...paths) {
	local box=${BX[$id]["ibox"]}

	[ -n "${paths[0]-}" ] || return 0
	if bc_set "$box" "${paths[0]}" 2> /dev/null; then
		dt_notep low "Cover set for ${BX[$id]["name"]}"
		dt_del "$id"
	else
		dt_notep high "A cover must be a PNG"
	fi
	return 0
}

fn boxerpick_close(int id) {
	unset "BX[$id]"
}

fn boxerdone_open(int id, arg = "") {
	bx_askopen "$id" "$arg"
	BX[$id]["waiting"]=0
	[ "$(bp_state_of "$arg")" = installing ] && BX[$id]["waiting"]=1
	return 0
}

fn boxerdone_draw(int id, int h, int w, int row, int col) {
	local n=${BX[$id]["name"]}

	if [ "${BX[$id]["waiting"]}" != 1 ] || [ -n "${BX[$id]["said"]}" ]; then
		if [ -n "${BX[$id]["said"]}" ]; then
			bx_askdraw "$id" "$h" "$w" "${BX[$id]["said"]}"
		else
			bx_askdraw "$id" "$h" "$w" "$n is not waiting to be installed."
		fi
		dt_dlgbtns "$id" "$h" "$w" ok ok OK
		return 0
	fi
	bx_askdraw "$id" "$h" "$w" "Is $n already installed?" "" \
		"Its disc's files will be the game, and the disc is let go."
	dt_dlgbtns "$id" "$h" "$w" "${BX[$id]["focus"]}" ok Yes cancel Cancel
}

fn bx_donedo(int id) {
	if [ "${BX[$id]["waiting"]}" != 1 ] || [ -n "${BX[$id]["said"]}" ]; then
		dt_del "$id"
		return 0
	fi
	bd_finish "${BX[$id]["ibox"]}" 1
	BX[$id]["said"]="Done: ${BX[$id]["name"]} plays from its files now."
	return 0
}

fn boxerdone_key(int id, key) {
	local f=${BX[$id]["focus"]} d
	local -a o=(ok cancel)

	if d := dt_focuskey "$key" 1; then
		BX[$id]["focus"] := dt_focus "$f" "$d" "${o[@]}"
		return 0
	fi
	case $key in
	escape) dt_del "$id" ;;
	enter) if [ "$f" = cancel ]; then dt_del "$id"; else bx_donedo "$id"; fi ;;
	esac
	return 0
}

fn boxerdone_click(int id, int r, int c, btn = "") {
	local tag

	tag := dt_hit "$id" "$r" "$c" || return 0
	case $tag in ok) bx_donedo "$id" ;; cancel) dt_del "$id" ;; esac
	return 0
}

fn boxerdone_close(int id) {
	unset "BX[$id]"
}

# --- About -----------------------------------------------------------------------

# About Boxer: what this is a tribute to, and whose work it runs on.
fn boxer_about() {
	local h=24 w=78 rid

	dt_dlgat "$h" "$w"
	rid := dt_new "About Boxer" "$DT_DLGH" "$DT_DLGW" "$DT_DLGR" "$DT_DLGC" boxerabout
	return 0
}

fn boxerabout_draw(int id, int h, int w, int row, int col) {
	local i=2 l n
	local -a lines=(
		"Boxer for hibr"
		""
		"A tribute to Boxer, the DOS game box for the Mac, by Alun Bestor, who made"
		"playing old DOS games as easy as keeping them on a shelf. How a game is"
		"recognised, installed and shelved follows Boxer's own rules, read from its"
		"source (GPL-2.0, Alun Bestor and contributors)."
		"  https://boxerapp.com    https://github.com/alunbestor/Boxer"
		""
		"Games run in DOSBox Pure, a libretro core by Bernhard Schelling, built on"
		"DOSBox by the DOSBox Team; the sound and the look are theirs, and we say so:"
		"  DOSBox Pure   https://codeberg.org/schelling/dosbox-pure"
		"  DOSBox        https://www.dosbox.com"
		"Inside, the MT-32 is Munt (Dean Beeler, Jerome Fisher, Sergey V. Mikayev),"
		"the OPL3 and SC-55 are Nuked (Nuke.YKT). It speaks libretro."
		"GPL-2.0 or later (DOSBox Pure, DOSBox); LGPL-2.1 or later (Munt)."
		""
		"Box art, when fetching is on, is from the libretro thumbnails project."
		"Boxer for hibr is MIT, and runs on hibr."
	)

	# A short terminal drops the blank lines before it drops any credit.
	n=$((h - 5))
	if [ "${#lines[@]}" -gt "$n" ]; then
		local -a keep=()
		for l in "${lines[@]}"; do [ -n "$l" ] && keep+=("$l"); done
		lines=("${keep[@]}")
	fi
	lines=("${lines[@]:0:$n}")

	dt_wclear "$id"
	for l in "${lines[@]}"; do
		if [ "$i" = 2 ]; then console pen "$DT_INK" "$DT_FACE" bold; else console pen "$DT_INK" "$DT_FACE"; fi
		dt_tput "$id" "$i" 2 "$l"
		i=$((i + 1))
	done
	dt_dlgbtns "$id" "$h" "$w" ok ok OK
}

fn boxerabout_key(int id, key) {
	case $key in enter | escape | " ") dt_del "$id" ;; esac
	return 0
}

fn boxerabout_click(int id, int r, int c, btn = "") {
	[ "$(dt_hit "$id" "$r" "$c")" = ok ] && dt_del "$id"
	return 0
}

# --- the Game Settings window --------------------------------------------------
#
# The same fields as the drawer, in a window of their own, opened with the path
# of a box: from a right click on a game, and, once Files opens a folder by its
# extension (hibr #318), from the same menu there.

fn boxerinfo_open(int id, arg = "") {
	local t

	bx_info_loadbox "$id" "$arg"
	BX[$id]["ifield"]=0
	BX[$id]["nfocus"]=0
	t=${arg##*/}
	t=${t%.*}
	bm_up "$arg"
	if [ -r "$arg/boxer.json" ] && json parse BXJ "$(< "$arg/boxer.json")" 2> /dev/null; then
		t := bx_title "$t"
	fi
	BX[$id]["name"]=$t
	BX[$id]["ntext"]=$t
	BX[$id]["ncur"]=${#t}
	dt_retitle "$id" "$t Settings"
}

# Give the game the name typed, in its boxer.json and as its folder, which
# are kept the same. A name another game has is refused.
fn bx_rename(int id) {
	local box=${BX[$id]["ibox"]-} new=${BX[$id]["ntext"]-} dest have

	new=${new//[$'\t\n']/ }
	new=${new#"${new%%[! ]*}"}
	new=${new%"${new##*[! ]}"}
	if [ -z "$new" ] || [ "${new//\//}" != "$new" ] || [ "${new:0:1}" = . ]; then
		dt_notep high "A name needs letters, and no slash or leading dot"
		return 0
	fi
	dest="${box%/*}/$new.boxer"
	if [ "$dest" != "$box" ] && [ -e "$dest" ]; then
		dt_notep high "There is already a game called $new"
		return 0
	fi
	bm_up "$box"
	[ -r "$box/boxer.json" ] || return 0
	json parse BXJ "$(< "$box/boxer.json")" 2> /dev/null || return 0
	json set BXJ .title "$new" -s
	json emit BXJ -p > "$box/boxer.json"
	if [ "$dest" != "$box" ]; then
		command mv -- "$box" "$dest" || { dt_notep high "Cannot rename the folder"; return 0; }
		BX[$id]["ibox"]=$dest
	fi
	BX[$id]["name"]=$new
	BX[$id]["ntext"]=$new
	BX[$id]["ncur"]=${#new}
	BX[$id]["nfocus"]=0
	dt_retitle "$id" "$new Settings"
	# A game that has no cover, named properly at last, is looked for by its new name when fetching is on.
	if [ "$BX_ART" = on ]; then
		have := bc_path "${BX[$id]["ibox"]}" || have=
		[ -n "$have" ] || bc_later "${BX[$id]["ibox"]}"
	fi
	return 0
}

fn boxerinfo_draw(int id, int h, int w, int row, int col) {
	local on=${BX[$id]["nfocus"]:-0} cur=0

	dt_wclear "$id"
	console pen "$DT_INK" "$DT_FACE"
	console fill -p "w$id" 1 1 $((h - 2)) $((w - 2)) " "
	console pen "$DT_INK" "$DT_FACE" bold
	dt_tput "$id" 1 2 "Name"
	console pen "$DT_INK" "$DT_FACE"
	[ "$on" = 1 ] && cur=${BX[$id]["ncur"]}
	dt_textdraw "$id" 1 12 $((w - 14)) "${BX[$id]["ntext"]}" "$cur" "$on"
	dt_wreg "$id" 1 12 $((w - 14)) name
	bx_info_fields "$id" 3 2 $((w - 4)) "$((1 - on))"
	console pen "$DT_DIM" "$DT_FACE"
	dt_tput "$id" $((4 + ${#BXI_FIELDS[@]})) 2 "default: as Control Panel > Boxer. Up, down, left, right, enter."
	return 0
}

fn boxerinfo_key(int id, key) {
	local res

	if [ "${BX[$id]["nfocus"]:-0}" = 1 ]; then
		case $key in
		escape) BX[$id]["ntext"]=${BX[$id]["name"]}; BX[$id]["nfocus"]=0; return 0 ;;
		enter) bx_rename "$id"; return 0 ;;
		tab | down) BX[$id]["nfocus"]=0; return 0 ;;
		esac
		res := dt_textkey "${BX[$id]["ntext"]}" "${BX[$id]["ncur"]}" "$key" || return 0
		BX[$id]["ntext"]=${res% *}
		BX[$id]["ncur"]=${res##* }
		return 0
	fi
	case $key in
	escape) dt_del "$id"; return 0 ;;
	tab) BX[$id]["nfocus"]=1; BX[$id]["ncur"]=${#BX[$id]["ntext"]}; return 0 ;;
	up)
		if [ "${BX[$id]["ifield"]:-0}" = 0 ]; then
			BX[$id]["nfocus"]=1
			BX[$id]["ncur"]=${#BX[$id]["ntext"]}
			return 0
		fi
		;;
	esac
	bxi_key "$id" "$key" 3 2
	return 0
}

fn boxerinfo_click(int id, int r, int c, btn = "") {
	local tag

	tag := dt_hit "$id" "$r" "$c" || tag=
	if [ "$tag" = name ]; then
		BX[$id]["nfocus"]=1
		BX[$id]["ncur"]=${#BX[$id]["ntext"]}
		return 0
	fi
	BX[$id]["nfocus"]=0
	bxi_click "$id" "$r" "$c"
	return 0
}

fn boxerinfo_close(int id) {
	unset "BX[$id]"
}

# From a shell: boxer.hibr import PATH... puts each on the shelf and says where.
if [ -z "${DT_ROWS-}" ]; then
	# The detection and the box's description are boxerplay's, installed with it.
	dt_has bd_scan || . "${BASH_SOURCE%/*}/../boxerplay.hibr" 2> /dev/null
	case ${1-} in
	import)
		shift
		mkdir -p "$BX_SHELF"
		mode=auto
		for p in "$@"; do
			case $p in
			--install) mode=install; continue ;;
			--installed) mode=installed; continue ;;
			esac
			b := bx_import "$p" "" "$mode" && echo "$b"
		done
		;;
	cover)
		shift
		b=${1-}
		bm_up "$b"
		[ -r "$b/boxer.json" ] || { echo "boxer: cover BOX [PNG|fetch]" >&2; exit 1; }
		case ${2-fetch} in
		fetch) bc_fetch "$b" || { echo "boxer: no cover found for ${b##*/}" >&2; exit 1; } ;;
		*) bc_set "$b" "$2" || exit 1 ;;
		esac
		;;
	covers)
		for b in "$BX_SHELF"/*.boxer; do
			[ -d "$b" ] || continue
			have := bc_path "$b" || have=
			if [ -z "$have" ]; then
				bc_fetch "$b" && echo "$b"
				continue
			fi
			k := bc_kind "$b" || k=
			[ "$k" = title ] && bc_fetch "$b" boxarts && echo "$b"
		done
		;;
	fix)
		shift
		for p in "$@"; do
			b := bx_fix "$p" && echo "$b"
		done
		;;
	list)
		for b in "$BX_SHELF"/*.boxer; do
			[ -d "$b" ] && echo "$b"
		done
		;;
	esac
fi
