#!/usr/bin/env hibr
#
# boxerplay -- one DOS game from a gamebox, in a window of its own. The
# window is opened by the shelf (Boxer, boxer.hibr) with a gamebox folder
# for its argument; nothing here is meant to be started by hand, so the app
# is hidden. The game runs in DOSBox Pure, a libretro core, driven by the
# retro module on a thread of its own, and the frame it makes is drawn by
# hibr's own renderer: pixels where the terminal takes them, half blocks
# where it does not.
#
# The gamebox says what to run: its boxer.json names a program (and its
# arguments) and any CD or floppy images, and engine/dosbox.conf holds the
# person's own DOSBox settings. At launch they are put together into one
# run.conf in the runtime folder -- the settings first (an [autoexec] of
# their own is dropped: this one is the last word), then an [autoexec]
# that mounts drives/c as C: and starts the program -- and DOSBox Pure is
# given that file as its content, so the game sees a DOS machine set up the
# way the gamebox asks and nothing outside the gamebox is touched. The
# game's own saves are written to drives/c, as they would be on a real
# disk; the core's save states go to saves/.
#
# What it cannot do yet: a key's release (the console reports presses only,
# so a key is held for a short time after each press; hibr #315), and
# the mouse's movement as distance, which a terminal cannot give.

strict


app boxerplay "A DOS game from a gamebox" 0.15
# modules: retro
command -v dt_app > /dev/null &&
	dt_app boxerplay "Boxer Game" 26 90 many "▣" "" hidden
command -v dt_keepstate > /dev/null && dt_keepstate boxerplay BP

declare -gA BP BPJ
BP_QUITID=
BP_CORE="${BP_CORE-dosbox_pure}"
BP_SYS="${BP_SYS-${XDG_DATA_HOME:-$HOME/.local/share}/hibr/retro/system}"

# What Control Panel > Boxer sets, for every game; a game's own settings
# (its Info drawer in the shelf) override the picture, the shape and what
# DOSBox is told. BX_FULLKEY is the key that fills the display and gives it
# back, and is the game's rather than the desktop's.
BX_PIC="${BX_PIC-follow}"
BX_ASPECT="${BX_ASPECT-4:3}"
BX_FULLKEY="${BX_FULLKEY-f11}"
BX_HOLD="${BX_HOLD-120}"
BX_SOUND="${BX_SOUND-on}"
BX_MOUSE="${BX_MOUSE-direct}"
BX_CARD="${BX_CARD-sb16}"
BX_MIDIDIR="${BX_MIDIDIR-}"
BX_MIDI="${BX_MIDI-disabled}"
command -v dt_keep > /dev/null && dt_keep BX_PIC BX_ASPECT BX_FULLKEY BX_HOLD BX_SOUND BX_MOUSE BX_CARD BX_MIDIDIR BX_MIDI

# --- what a folder holds, the way Boxer reckons it -----------------------------
#
# Boxer (the Mac application) decides what to do with a game from its files:
# which are DOS programs, which are an installer, whether the game looks
# already installed. These are its rules (BXInstallerScan, BXImportPolicies,
# BXFileTypes), kept the same, so the same game lands the same way.

# Files that are never the game, and never an installer: matched, in lower
# case, against the path inside the game's folder.
BD_IGN=('(^|/)directx' '(^|/)acrodos' '(^|/)acroread\.exe$' '(^|/)uvconfig\.exe$' '(^|/)univbe'
	'(^|/)unins000\.' '(^|/)graphic mode setup\.exe$' '(^|/)gogwrap\.exe$' '(^|/)dosbox(.*)/'
	'(^|/)autorun' '(^|/)bootdisk\.' '(^|/)readme\.' '(^|/)foo\.bat' '(^|/)vinstall\.bat'
	'(^|/)pkunzip\.' '(^|/)pkunzjr\.' '(^|/)arj\.' '(^|/)lha\.')
# Programs not worth listing as a thing to run.
BD_EXCL=" dos4gw.exe pkunzip.exe lha.com arj.exe deice.exe pkunzjr.exe "
# What marks a folder as a game already installed.
BD_TELLS=" conf iso cue cdr inst harddisk cdrom floppy "
# The installers, best first: the first pattern a name matches wins.
BD_PREF=('^dosinst' '^install\.' '^hdinstal\.' '^setup\.')
BD_DOS=
BD_WINN=0
BD_TELLY=0
BD_CONFN=0
BD_INST=
BD_DINST=
BD_DPROGS=

# Whether a path is one Boxer ignores altogether (the path in lower case).
fn bd_ignored(lo) {
	local re

	for re in "${BD_IGN[@]}"; do
		match "$lo" "$re" && return 0
	done
	return 1
}

# Whether a program runs under DOS: a .COM or .BAT does; an .EXE does unless
# its header says Windows or OS/2 (a "new" header behind a 64-byte DOS one),
# and a DOS extender's large stub counts as DOS.
fn bd_isdos(f) {
	local lo=${f,,} h b0 b1 rel nh nm sz min
	local -a b

	case $lo in *.com | *.bat) return 0 ;; *.exe) ;; *) return 1 ;; esac
	h=$(od -An -v -tu1 -N 64 -- "$f" 2> /dev/null | tr '\n' ' ')
	read -ra b <<< "$h"
	[ "${#b[@]}" -ge 64 ] || return 1
	[ "${b[0]}" = 77 ] && [ "${b[1]}" = 90 ] || return 1
	rel=$((${b[24]} + 256 * ${b[25]}))
	[ "$rel" = 64 ] || return 0
	nh=$((${b[60]} + 256 * ${b[61]} + 65536 * ${b[62]} + 16777216 * ${b[63]}))
	[ "$nh" = 0 ] && return 0
	sz=$(stat -c %s -- "$f")
	[ "$sz" -ge $((nh + 2)) ] || return 0
	h=$(od -An -v -tu1 -j "$nh" -N 2 -- "$f" 2> /dev/null | tr '\n' ' ')
	read -ra b <<< "$h"
	nm=$((${b[0]:-0} + 256 * ${b[1]:-0}))
	case $nm in
	17742 | 17744)
		[ "$nh" -gt 3584 ] && return 0
		min=64
		[ "$nm" = 17744 ] && min=24
		[ "$sz" -lt $((nh + min)) ] && return 0
		return 1 ;;
	17740 | 22604) [ "$nh" -gt 3584 ] && return 0; return 1 ;;
	13143 | 13399) return 1 ;;
	esac
	return 0
}

# Look through a folder: BD_DOS is its DOS programs, a depth and a path a
# line, shallowest first; BD_WINN how many Windows programs; BD_TELLY whether
# it looks installed already; BD_INST its installers, the best first.
fn bd_scan(dir) {
	local f rel lo base ext cand pat inst= first

	BD_DOS=
	BD_WINN=0
	BD_TELLY=0
	BD_CONFN=0
	BD_INST=
	while IFS= read -r f; do
		[ -n "$f" ] || continue
		rel=${f#"$dir"/}
		lo=${rel,,}
		bd_ignored "$lo" && continue
		base=${lo##*/}
		case $base in
		*.*) ext=${base##*.}; case $BD_TELLS in *" $ext "*) BD_TELLY=1 ;; esac ;;
		esac
		[ "$base" = gfw_high.ico ] && BD_TELLY=1
		case $base in *.conf) BD_CONFN=$((BD_CONFN + 1)) ;; esac
		[ -f "$f" ] || continue
		case $base in
		*.exe | *.com | *.bat)
			if bd_isdos "$f"; then
				cand=${rel//[^\/]/}
				BD_DOS="$BD_DOS${#cand}"$'\t'"$rel"$'\n'
			else
				BD_WINN=$((BD_WINN + 1))
			fi ;;
		esac
	done <<< "$(find "$dir" -mindepth 1 2> /dev/null)"
	BD_DOS=$(printf '%s' "$BD_DOS" | sort -t "$(printf '\t')" -k1,1n -k2,2)
	while IFS=$'\t' read -r _ rel; do
		[ -n "$rel" ] || continue
		base=${rel##*/}
		base=${base,,}
		match "$base" 'inst|setup|config' && inst="$inst$rel"$'\n'
	done <<< "$BD_DOS"
	first=
	for pat in "${BD_PREF[@]}"; do
		while IFS= read -r rel; do
			[ -n "$rel" ] || continue
			base=${rel##*/}
			base=${base,,}
			if match "$base" "$pat"; then first=$rel; break; fi
		done <<< "$inst"
		[ -n "$first" ] && break
	done
	[ -n "$first" ] || first=$(printf '%s' "$inst" | head -n 1)
	BD_INST=$first
	[ -n "$first" ] && while IFS= read -r rel; do
		[ -n "$rel" ] && [ "$rel" != "$first" ] && BD_INST="$BD_INST"$'\n'"$rel"
	done <<< "$inst"
	return 0
}

# The programs to offer in a drive's folder, as DOS paths on letter L: a
# line each, shallowest first, without the ones not worth running.
fn bd_programs(dir, letter = C) {
	local rel base

	bd_scan "$dir"
	while IFS=$'\t' read -r _ rel; do
		[ -n "$rel" ] || continue
		base=${rel##*/}
		base=${base,,}
		case $BD_EXCL in *" $base "*) continue ;; esac
		printf '%s\n' "$letter:\\${rel//\//\\}"
	done <<< "$BD_DOS"
}

# A DOS name from a game's name, as Boxer makes one: lower case, letters and
# digits and dots only, eight characters and three after the dot.
fn bd_dosname(name) {
	local lo=${name,,} base ext=

	lo=${lo//[^a-z0-9.]/}
	base=${lo%.*}
	case $lo in *.*) ext=${lo##*.} ;; esac
	base=${base:0:8}
	[ -n "$base" ] || base=game
	ret "$base${ext:+.${ext:0:3}}"
}

# Whether a game's files want a folder to themselves on C: -- they have
# programs at the top and nothing that marks them as already set up -- or sit
# in the root of the drive (GOG and Steam games, a drive someone packaged).
fn bd_wantsfolder(dir) {
	local f lo ext progs=0

	for f in "$dir"/* "$dir"/.[!.]*; do
		[ -e "$f" ] || continue
		lo=${f##*/}
		lo=${lo,,}
		case $lo in
		*.*) ext=${lo##*.}; case $BD_TELLS in *" $ext "*) return 1 ;; esac ;;
		esac
		[ "$lo" = gfw_high.ico ] && return 1
		case $lo in *.exe | *.com | *.bat) progs=1 ;; esac
	done
	[ "$progs" = 1 ]
}

# Unpack a disc image into a folder, to look inside it: with xorriso, 7z or
# bsdtar, whichever is here. A cue sheet is read through its image. Status 1
# when nothing here can read it, and the game goes in unread.
fn bd_extract(img, dest) {
	local f=$img

	case ${img,,} in
	*.cue)
		f=${img%.*}.bin
		[ -e "$f" ] || f=${img%.*}.BIN ;;
	esac
	[ -e "$f" ] || return 1
	if command -v xorriso > /dev/null; then
		xorriso -osirrox on -indev "$f" -extract / "$dest" > /dev/null 2>&1 && { command chmod -R u+rwX "$dest" 2> /dev/null; return 0; }
	fi
	if command -v 7z > /dev/null; then
		7z x -y -o"$dest" "$f" > /dev/null 2>&1 && return 0
	fi
	if command -v bsdtar > /dev/null; then
		bsdtar -xf "$f" -C "$dest" > /dev/null 2>&1 && { command chmod -R u+rwX "$dest" 2> /dev/null; return 0; }
	fi
	return 1
}

# Make a disc image out of a folder, so that DOS sees a CD-ROM in D: and not a
# folder: a game that wants its disc looks for one. Status 1 when no tool here
# makes one.
fn bd_mkiso(dir, out) {
	command -v xorriso > /dev/null || return 1
	xorriso -as mkisofs -quiet -r -iso-level 1 -V GAME -o "$out" "$dir" > /dev/null 2>&1
}

# A box made before the file was called boxer.json has it called gamebox.json:
# renamed, once, whenever a box is touched.
fn bm_up(box) {
	[ -e "$box/boxer.json" ] || [ ! -e "$box/gamebox.json" ] || command mv -f -- "$box/gamebox.json" "$box/boxer.json" 2> /dev/null
	return 0
}

# Write the box's boxer.json from what is in its drives, keeping what the
# person has set: the programs, which one launches, the CD, and where the box
# is in its installing. state is installing, installed, or empty.
fn bd_describe(box, name, state = "") {
	local f p old prev progs line i=0 first n oldn k
	local -A keep
	local -a oldd

	bm_up "$box"
	if [ -r "$box/boxer.json" ] && json parse BPJ "$(< "$box/boxer.json")" 2> /dev/null; then
		for p in .title .display.render .display.aspect .cpu.cycles .machine .voodoo .voodoospeed .sound.card .sound.irq .sound.dma .sound.port .midi .mouse .capture .launch.args .source.imported; do
			old := json get BPJ "$p" 2> /dev/null || old=
			[ -n "$old" ] && keep[$p]=$old
		done
		prev := json get BPJ .launch.program 2> /dev/null || prev=
		oldn := json len BPJ .programs 2> /dev/null || oldn=0
		for ((k = 0; k < oldn; k++)); do
			old := json get BPJ ".programs[$k]" 2> /dev/null || continue
			case $old in D:*) oldd+=("$old") ;; esac
		done
		[ -n "${keep[.title]-}" ] && name=${keep[.title]}
	fi
	json parse BPJ '{"boxer":1,"engine":"dosbox","launch":{},"programs":[],"mounts":[]}'
	json set BPJ .title "$name" -s
	for p in "${!keep[@]}"; do
		[ "$p" = .title ] && continue
		json set BPJ "$p" "${keep[$p]}" -s
	done
	progs=$(bd_programs "$box/drives/c" C)
	first=
	while IFS= read -r line; do
		[ -n "$line" ] || continue
		json set BPJ ".programs[$i]" "$line" -s
		[ "$line" = "$prev" ] && first=$prev
		i=$((i + 1))
	done <<< "$progs"
	# A game that runs from its disc: the programs on it, as D: paths, kept
	# from when the disc was read (or from before).
	if [ -n "${BD_DPROGS-}" ]; then
		while IFS= read -r line; do
			[ -n "$line" ] || continue
			json set BPJ ".programs[$i]" "$line" -s
			[ "$line" = "$prev" ] && first=$prev
			i=$((i + 1))
		done <<< "$BD_DPROGS"
	else
		for line in "${oldd[@]}"; do
			json set BPJ ".programs[$i]" "$line" -s
			[ "$line" = "$prev" ] && first=$prev
			i=$((i + 1))
		done
	fi
	n=$i
	if [ "$state" = installing ]; then
		if [ -n "${BD_DINST-}" ]; then BD_INST=$BD_DINST; else bd_scan "$box/drives/d"; fi
		first=${BD_INST%%$'\n'*}
		[ -n "$first" ] && first="D:\\${first//\//\\}"
		json set BPJ .state installing -s
	else
		[ "$n" = 1 ] && first=$(json get BPJ .programs[0] 2> /dev/null)
		[ -n "$state" ] && json set BPJ .state "$state" -s
	fi
	[ -n "$first" ] && json set BPJ .launch.program "$first" -s
	for f in "$box"/drives/d/*.cue "$box"/drives/d/*.CUE "$box"/drives/d/*.iso "$box"/drives/d/*.ISO "$box"/drives/d/*.img; do
		[ -e "$f" ] || continue
		json set BPJ .mounts[0].drive d -s
		json set BPJ .mounts[0].kind cdrom -s
		json set BPJ .mounts[0].path "drives/d/${f##*/}" -s
		break
	done
	if [ -d "$box/drives/d" ] && [ -n "$(ls -A "$box/drives/d" 2> /dev/null)" ] &&
	   [ -z "$(json type BPJ .mounts[0] 2> /dev/null)" ]; then
		json set BPJ .mounts[0].drive d -s
		json set BPJ .mounts[0].kind cdrom -s
		json set BPJ .mounts[0].path drives/d -s
	fi
	[ -n "${keep[.display.aspect]-}" ] || json set BPJ .display.aspect default -s
	[ -n "${keep[.source.imported]-}" ] || json set BPJ .source.imported "$(date +%F)" -s
	json emit BPJ -p > "$box/boxer.json"
	return 0
}

# The installer has finished, or the game was never to be installed: if it
# put files on C: the game is installed and the disc it came from is kept as
# its CD; if not, the disc's files were the game, and move to C: -- in a folder
# of their own, as Boxer does when they would otherwise be loose in the root.
# asis says the second whatever C: holds.
fn bd_finish(box, asis = 0) {
	local t d sub img stage f

	bm_up "$box"
	[ -r "$box/boxer.json" ] || return 1
	json parse BPJ "$(< "$box/boxer.json")" 2> /dev/null || return 1
	t := bp_get BPJ .title "${box##*/}"
	if [ "$asis" = 1 ] || [ -z "$(ls -A "$box/drives/c" 2> /dev/null)" ]; then
		d="$box/drives/d"
		img=
		for f in "$d"/*.iso "$d"/*.ISO "$d"/*.cue "$d"/*.CUE "$d"/*.img; do
			[ -e "$f" ] && { img=$f; break; }
		done
		if [ -n "$img" ]; then
			# The files are on a disc image: take them off it, into C:, and drop the image.
			stage=$(mktemp -d)
			if bd_extract "$img" "$stage"; then
				if bd_wantsfolder "$stage"; then
					sub := bd_dosname "$t"
					mkdir -p "$box/drives/c/$sub"
					command cp -R -- "$stage"/. "$box/drives/c/$sub/"
				else
					command cp -R -- "$stage"/. "$box/drives/c/"
				fi
				command rm -rf -- "$d"
			fi
			command rm -rf -- "$stage"
		elif [ -d "$d" ] && [ -n "$(ls -A "$d" 2> /dev/null)" ]; then
			if bd_wantsfolder "$d"; then
				sub := bd_dosname "$t"
				mkdir -p "$box/drives/c/$sub"
				command mv -- "$d"/* "$box/drives/c/$sub/" 2> /dev/null
				command mv -- "$d"/.[!.]* "$box/drives/c/$sub/" 2> /dev/null
			else
				command mv -- "$d"/* "$box/drives/c/" 2> /dev/null
				command mv -- "$d"/.[!.]* "$box/drives/c/" 2> /dev/null
			fi
			command rmdir "$d" 2> /dev/null
		fi
	fi
	bd_describe "$box" "$t" installed
	return 0
}

# Where the box is in its installing: installing, or anything else.
fn bp_state_of(box) {
	local v=

	bm_up "$box"
	[ -r "$box/boxer.json" ] && json parse BPJ "$(< "$box/boxer.json")" 2> /dev/null &&
		{ v := json get BPJ .state 2> /dev/null || v=; }
	ret "$v"
}

# The text of one field of a gamebox's boxer.json, or the default.
fn bp_get(doc, path, def = "") {
	local v

	v := json get "$doc" "$path" 2> /dev/null || v=
	[ -n "$v" ] && ret "$v" || ret "$def"
}

# How the mouse reaches DOS, as DOSBox Pure's own setting for it. The
# terminal tells a position with no button down only where the desktop's
# hovering is on, which is Auto on a display that reports the pointer in pixels:
# direct puts DOS's pointer where the terminal's is, which is what a
# point-and-click game wants; relative moves it by the distance between
# presses, for a game that wants that and will do little; off hands DOS none.
fn bp_mousemode(m) {
	case $m in
	relative) ret virtual ;;
	off) ret false ;;
	*) ret direct ;;
	esac
}

# The 3dfx Voodoo settings of a game as DOSBox Pure's options, key=value, one a
# word: none when both are left to the core, which has Voodoo on.
fn bp_voodoo(doc) {
	local v s o=

	v := bp_get "$doc" .voodoo default
	s := bp_get "$doc" .voodoospeed default
	[ "$v" = default ] || o="dosbox_pure_voodoo=$v"
	case $s in
	multi) o="$o dosbox_pure_voodoo_perf=1" ;;
	multi-low) o="$o dosbox_pure_voodoo_perf=3" ;;
	single) o="$o dosbox_pure_voodoo_perf=0" ;;
	single-low) o="$o dosbox_pure_voodoo_perf=2" ;;
	esac
	ret "${o# }"
}

# The MIDI synths in the folder Control Panel > Boxer names, one a line, as
# DOSBox Pure knows them: a SoundFont (.sf2), a Roland MT-32 or CM-32L's control
# ROM (its PCM ROM goes with it), or a Sound Canvas SC-55's ROM1.BIN. Nothing
# else in the folder is listed.
fn bp_midilist() {
	local f n lo

	[ -d "${BX_MIDIDIR-}" ] || return 0
	for f in "$BX_MIDIDIR"/*; do
		[ -f "$f" ] || continue
		n=${f##*/}
		lo=${n,,}
		case $lo in
		*.sf2 | *.sf3 | *_control.rom | rom1.bin) echo "$n" ;;
		esac
	done
	return 0
}

# Make the folder's files the ones DOSBox Pure finds in its system folder:
# symbolic links to every SoundFont and ROM there, so the synth's own files
# stay where the person keeps them. A synth can need more than the file named
# (an MT-32 wants its PCM ROM, an SC-55 its other ROMs), so all of them go.
fn bp_midilink() {
	local f n lo

	[ -d "${BX_MIDIDIR-}" ] || return 0
	for f in "$BX_MIDIDIR"/*; do
		[ -f "$f" ] || continue
		n=${f##*/}
		lo=${n,,}
		case $lo in
		*.sf2 | *.sf3 | *.rom | *.bin) command ln -sf -- "$f" "$BP_SYS/$n" ;;
		esac
	done
	return 0
}

# The mounts a gamebox lists, as DOSBox commands, a line each: a "cdrom" or
# "floppy" image, or a plain "dir", on the drive letter it names. A path is
# the gamebox's own, so it is made whole here.
fn bp_mounts(box) {
	local n i d k p t

	n := json len BPJ .mounts 2> /dev/null || n=0
	for ((i = 0; i < n; i++)); do
		d := json get BPJ ".mounts[$i].drive" 2> /dev/null || continue
		k := json get BPJ ".mounts[$i].kind" 2> /dev/null || k=dir
		p := json get BPJ ".mounts[$i].path" 2> /dev/null || continue
		case $p in /*) ;; *) p="$box/$p" ;; esac
		case $k in
		cdrom) if [ -d "$p" ]; then t="mount $d \"$p\""; else t="imgmount $d \"$p\" -t iso"; fi ;;
		floppy) t="imgmount $d \"$p\" -t floppy" ;;
		*) t="mount $d \"$p\"" ;;
		esac
		echo "$t"
	done
}

# What the game's own settings tell DOSBox, as sections after the person's
# own conf, so they win: the speed (cycles), the graphics card and the sound.
fn bp_tune() {
	local v sb=

	v := bp_get BPJ .cpu.cycles
	[ -n "$v" ] && [ "$v" != default ] && printf '[cpu]\ncycles=%s\n' "$v"
	v := bp_get BPJ .machine
	[ -n "$v" ] && [ "$v" != default ] && printf '[dosbox]\nmachine=%s\n' "$v"
	v := bp_get BPJ .sound.card default
	[ "$v" = default ] && v=$BX_CARD
	[ -n "$v" ] && [ "$v" != sb16 ] && sb="${sb}sbtype=$v\n"
	v := bp_get BPJ .sound.port default
	[ "$v" != default ] && sb="${sb}sbbase=$v\n"
	v := bp_get BPJ .sound.irq default
	[ "$v" != default ] && sb="${sb}irq=$v\n"
	v := bp_get BPJ .sound.dma default
	[ "$v" != default ] && sb="${sb}dma=$v\n"
	[ -n "$sb" ] && printf '[sblaster]\n%b' "$sb"
	return 0
}

# The run.conf of a gamebox, written into dir: its own settings, then the
# autoexec. The program is a DOS path; its folder is entered first.
fn bp_conf(box, dir) {
	local prog args f="$dir/run.conf" d p

	prog := bp_get BPJ .launch.program
	args := bp_get BPJ .launch.args
	{
		echo "# made by Boxer from $box; edit engine/dosbox.conf, not this"
		[ -r "$box/engine/dosbox.conf" ] && awk '
			/^[ \t]*\[/ { skip = (tolower($0) ~ /^[ \t]*\[autoexec\]/) }
			!skip' "$box/engine/dosbox.conf"
		bp_tune
		echo
		echo "[autoexec]"
		echo "@echo off"
		echo "mount c \"$box/drives/c\""
		bp_mounts "$box"
		echo "c:"
		echo "cls"
		if [ -n "$prog" ]; then
			case $prog in [A-Za-z]:*) echo "${prog:0:2}"; prog=${prog:2} ;; esac
			d=${prog%\\*}
			p=${prog##*\\}
			[ "$d" != "$prog" ] && [ -n "$d" ] && echo "cd $d"
			echo "$p $args"
		fi
	} > "$f"
	ret "$f"
}

# Start the game: its run.conf made, and the core given it.
fn bp_start(int id) {
	local box=${BP[$id]["box"]} dir conf mm midi vo kv
	local -A snd
	local -a vw vopt

	BP[$id]["choose"]=
	json parse BPJ "$(< "$box/boxer.json")" 2> /dev/null || return 0
	dir="${XDG_RUNTIME_DIR:-/tmp}/hibr-boxer-$$-$id"
	mkdir -p "$dir" "$box/saves" "$BP_SYS" 2> /dev/null
	conf := bp_conf "$box" "$dir"
	BP[$id]["dir"]=$dir
	BP[$id]["aspect"] := bp_get BPJ .display.aspect default
	[ "${BP[$id]["aspect"]}" = default ] && BP[$id]["aspect"]=$BX_ASPECT
	BP[$id]["pic"] := bp_get BPJ .display.render default
	[ "${BP[$id]["pic"]}" = default ] && BP[$id]["pic"]=$BX_PIC
	if [ "$BX_SOUND" = off ]; then export HIBR_RETRO_AUDIO=none; fi
	midi := bp_get BPJ .midi default
	[ "$midi" = default ] && midi=$BX_MIDI
	[ "$midi" = disabled ] || bp_midilink
	mm := bp_get BPJ .mouse default
	[ "$mm" = default ] && mm=$BX_MOUSE
	mm := bp_mousemode "$mm"
	BP[$id]["capmode"] := bp_get BPJ .capture default
	[ "${BP[$id]["capmode"]}" = default ] && BP[$id]["capmode"]=${BX_CAPTURE-click}
	BP[$id]["cap"]=0
	vo := bp_voodoo BPJ
	read -ra vw <<< "$vo"
	vopt=()
	for kv in "${vw[@]}"; do vopt+=(-o "$kv"); done
	# DOSBox Pure keeps a finished session on a red screen unless told to exit.
	[ "${BX_AUTOCLOSE-on}" = on ] && vopt+=(-o dosbox_pure_menu_time=0)
	BP[$id]["p"] := retro open "$BP_CORE" "$conf" -s "$BP_SYS" -S "$box/saves" \
		-o "dosbox_pure_mouse_input=$mm" -o "dosbox_pure_midi=$midi" "${vopt[@]}" 2>&1 ||
		{
			BP[$id]["err"]="DOSBox Pure would not start: ${BP[$id]["p"]}"
			return 0
		}
	retro aspect "${BP[$id]["p"]}" "${BP[$id]["aspect"]}" 2> /dev/null
	retro hold "${BP[$id]["p"]}" "$BX_HOLD" 2> /dev/null
	BP[$id]["fd"] := retro fd "${BP[$id]["p"]}"
	snd := retro info "${BP[$id]["p"]}"
	if [ "$BX_SOUND" = on ] && [ "${snd[output]-}" = none ]; then
		dt_notep low "Boxer found no sound device, so the game is silent"
	fi
	command -v console > /dev/null && console watch "${BP[$id]["fd"]}"
	BP[$id]["t0"]=$EPOCHSECONDS
	dt_retitle "$id" "${BP[$id]["name"]}"
	[ "${BP[$id]["capmode"]}" = click ] || { dt_has dt_pointer && dt_pointer "$id" none; }
	return 0
}


# Which program to run, asked of the game that has several and none chosen: the
# choice is written into the game, which then starts.
fn bp_chose(int id, v) {
	local box=${BP[$id]["box"]}

	json parse BPJ "$(< "$box/boxer.json")" 2> /dev/null || return 0
	json set BPJ .launch.program "$v" -s
	json set BPJ .installer false
	json emit BPJ -p > "$box/boxer.json"
	bp_start "$id"
	return 0
}

fn bp_choosedraw(int id, int h, int w) {
	local -a o
	local i r

	read -ra o <<< "${BP[$id]["progs"]}"
	dt_wclear "$id"
	console pen "$DT_INK" "$DT_FACE"
	console fill -p "w$id" 1 1 $((h - 2)) $((w - 2)) " "
	console pen "$DT_INK" "$DT_FACE" bold
	dt_tput "$id" 2 3 "Which program should ${BP[$id]["name"]:0:$((w - 30))} run?"
	for i in "${!o[@]}"; do
		r=$((4 + i))
		[ "$r" -lt $((h - 3)) ] || break
		if [ "$i" = "${BP[$id]["choose"]}" ]; then console pen "$DT_SELINK" "$DT_ACTIVE"; else console pen "$DT_INK" "$DT_FACE"; fi
		console fill -p "w$id" "$r" 3 1 $((w - 6)) " "
		dt_tput "$id" "$r" 4 "${o[$i]}"
		dt_wreg "$id" "$r" 3 $((w - 6)) "p$i"
	done
	console pen "$DT_DIM" "$DT_FACE"
	dt_tput "$id" $((h - 2)) 3 "Up, down and enter; the choice is remembered. Settings can change it."
	return 0
}

fn bp_choosekey(int id, key) {
	local -a o
	local n

	read -ra o <<< "${BP[$id]["progs"]}"
	n=${#o[@]}
	case $key in
	up) BP[$id]["choose"]=$(((BP[$id]["choose"] + n - 1) % n)) ;;
	down) BP[$id]["choose"]=$(((BP[$id]["choose"] + 1) % n)) ;;
	enter) bp_chose "$id" "${o[${BP[$id]["choose"]}]}" ;;
	escape) dt_del "$id" ;;
	esac
	return 0
}

fn bp_chooseclick(int id, int r, int c) {
	local -a o
	local tag

	tag := dt_hit "$id" "$r" "$c" || return 0
	read -ra o <<< "${BP[$id]["progs"]}"
	case $tag in p[0-9]*) bp_chose "$id" "${o[${tag#p}]}" ;; esac
	return 0
}

# The game already running in another window, if any: its id. The core is one
# per process, so a second game cannot start beside it.
fn bp_running(int id) {
	local k

	for k in "${!BP[@]}"; do
		[ "$k" = "$id" ] && continue
		[ -n "${BP[$k]["p"]-}" ] && { ret "$k"; return 0; }
	done
	return 1
}

# A game asked for while another plays: say which, bring that one forward and
# let this window go, rather than opening one that can only show an error.
fn bp_busy(int id, int other) {
	local have=${BP[$other]["name"]} want=${BP[$id]["name"]}

	if [ "$have" = "$want" ]; then
		dt_notep low "$have is already running"
	else
		dt_notep high "$have is already running. Boxer plays one game at a time: close it to play $want"
	fi
	dt_raise "$other"
	BP[$id]["gone"]=1
	return 0
}

fn boxerplay_open(int id, arg = "") {
	local box=$arg title prog n i v o

	BP[$id]["err"]=
	BP[$id]["box"]=$box
	bm_up "$box"
	if [ ! -r "$box/boxer.json" ]; then
		BP[$id]["err"]="Not a Boxer game: $box"
		return 0
	fi
	need retro 2> /dev/null || {
		BP[$id]["err"]="The retro module is not installed"
		return 0
	}
	json parse BPJ "$(< "$box/boxer.json")" 2> /dev/null || {
		BP[$id]["err"]="boxer.json is not valid"
		return 0
	}
	title := bp_get BPJ .title "${box##*/}"
	title=${title%.boxer}
	BP[$id]["name"]=${title%.gamebox}
	BP[$id]["progs"]=
	if o := bp_running "$id"; then
		bp_busy "$id" "$o"
		dt_del "$id"
		return 0
	fi
	prog := bp_get BPJ .launch.program
	if [ -z "$prog" ]; then
		n := json len BPJ .programs 2> /dev/null || n=0
		for ((i = 0; i < n; i++)); do
			v := json get BPJ ".programs[$i]" 2> /dev/null || continue
			BP[$id]["progs"]="${BP[$id]["progs"]}${BP[$id]["progs"]:+ }$v"
		done
		if [ -n "${BP[$id]["progs"]}" ]; then
			BP[$id]["choose"]=0
			dt_retitle "$id" "${BP[$id]["name"]}"
			return 0
		fi
	fi
	bp_start "$id"
}

# What a cell is in pixels, for placing the picture: the terminal's own when
# pixels are drawn, 1 by 2 for half blocks. Not needed by the module, which
# keeps the picture's shape itself; the cells it is given are the window's.
fn boxerplay_draw(int id, int h, int w, int row, int col) {
	local p=${BP[$id]["p"]} m

	if [ -n "${BP[$id]["choose"]-}" ]; then
		bp_choosedraw "$id" "$h" "$w"
		return 0
	fi
	console pen "$DT_INK" "$DT_FACE"
	if [ -n "${BP[$id]["err"]}" ]; then
		dt_tput "$id" 2 2 "${BP[$id]["err"]}"
		return 0
	fi
	[ -n "$p" ] || return 0
	m=${BP[$id]["pic"]:-follow}
	[ "$m" = follow ] && m=${DT_IMGMODE:-auto}
	case $m in
	pixels | sixel) m=pixels ;;
	auto) dt_imgwill auto && m=pixels || m=half ;;
	*) m=half ;;
	esac
	retro size "$p" "$w" "$h" "$m"
	retro draw "$p" 1 1 -p "w$id" 2> /dev/null
	BP[$id]["h"]=$h
	BP[$id]["w"]=$w
	BP[$id]["at"] := dt_ms
	return 0
}

# Clean until the core has made a frame, and frames are held DT_TERMMS apart
# as the terminal's own output is: a core at 70 a second is drawn at that
# rate and no faster, the newest frame always.
fn boxerplay_dirty(int id) {
	local p=${BP[$id]["p"]} now left

	[ -n "$p" ] || return 1
	retro wake "$p" 2> /dev/null
	retro frame "$p" 2> /dev/null || { bp_ended "$id"; return 1; }
	now := dt_ms
	left=$((${BP[$id]["at"]:-0} + ${DT_TERMMS:-70} - now))
	if [ "$left" -gt 0 ]; then
		dt_want "$left"
		return 1
	fi
	return 0
}

# A game that has ended (DOS's EXIT, or the core shutting down) closes its
# window, unless Close When Game Ends is off, which leaves the last picture.
# Asked when no new frame came, which is all an ended core ever makes.
fn bp_ended(int id) {
	local p=${BP[$id]["p"]}
	local -A st

	[ -n "$p" ] && [ "${BX_AUTOCLOSE-on}" = on ] || return 0
	st := retro info "$p" 2> /dev/null || return 0
	[ "${st[ended]-0}" = 1 ] && dt_del "$id"
	return 0
}

fn boxerplay_idle(int id) {
	[ -n "${BP[$id]["p"]}" ] || return 0
	retro wake "${BP[$id]["p"]}" 2> /dev/null
	bp_ended "$id"
	return 0
}

# Closing a game that is playing asks first, when Confirm On Exit is on.
fn boxerplay_canclose(int id) {
	[ "${BX_CONFIRM-on}" = on ] || return 0
	[ -n "${BP[$id]["p"]}" ] || return 0
	BP_QUITID=$id
	dt_confirm "Quit ${BP[$id]["name"]}? Unsaved progress is lost." bp_quityes
	return 1
}

bp_quityes() {
	local id=${BP_QUITID-}

	BP_QUITID=
	[ -n "$id" ] && [ -n "${BP[$id]["box"]-}" ] && dt_del "$id"
}

fn boxerplay_key(int id, key) {
	local p=${BP[$id]["p"]}

	if [ -n "${BP[$id]["choose"]-}" ]; then
		bp_choosekey "$id" "$key"
		return 0
	fi
	[ -n "$p" ] || return 1
	if [ "$key" = "$BX_FULLKEY" ]; then
		dt_zoom "$id"
		return 0
	fi
	if [ "$key" = "${BX_RELKEY-f12}" ] && [ "${BP[$id]["cap"]-}" = 1 ]; then
		bp_capture "$id" 0
		return 0
	fi
	if [ "$DT_TERMKEEP" = 1 ] && dt_has dt_keyassigned &&
	   dt_keyassigned "$key"; then
		return 1
	fi
	retro key "$p" "$key" 2> /dev/null
	return 0
}

# Where the pointer is over the window, as the row and column retro mouse takes:
# the cell the desktop named, or, when the terminal told the pointer's pixel and
# the cell's size is known, that cell and the part of it the pointer is over.
fn bp_at(int id, int r, int c) {
	local g gk cw ch wr wc

	if [ -n "${DT_PX-}" ] && g := console gfx 2> /dev/null; then
		read -r gk cw ch <<< "$g"
		wr=${DT[$id]["row"]}
		wc=${DT[$id]["col"]}
		if [ "${cw:-0}" -gt 1 ] && [ "${ch:-0}" -gt 1 ] &&
		   [ "$DT_PX" -ge $((wc * cw)) ] && [ "$DT_PY" -ge $((wr * ch)) ]; then
			r=$(((DT_PY - wr * ch) * 1000 / ch))
			c=$(((DT_PX - wc * cw) * 1000 / cw))
			printf -v r '%d.%03d' $((r / 1000)) $((r % 1000))
			printf -v c '%d.%03d' $((c / 1000)) $((c % 1000))
		fi
	fi
	ret "$r $c"
}

# Take the mouse for the game, or give it back. A game set to capture on click
# leaves the pointer alone until it is clicked in, hides it while it is taken, and
# lets it go on the release key (Control Panel > Boxer, F12 to begin with) or when it leaves the window; seamless has it all the time.
fn bp_capture(int id, int on) {
	[ "${BP[$id]["capmode"]-}" = click ] || return 0
	[ "${BP[$id]["cap"]}" = "$on" ] && return 0
	BP[$id]["cap"]=$on
	if dt_has dt_pointer; then
		if [ "$on" = 1 ]; then dt_pointer "$id" none; else dt_pointer "$id" ""; fi
	fi
	if [ "$on" = 1 ]; then
		dt_notep low "Mouse captured. ${BX_RELKEY-f12} lets it go"
	fi
	return 0
}

# The pointer follows every move the desktop reports: with hovering on that is
# all of them, and without it only those with a button down. A game that
# captures on click hears none of it until it has been clicked in.
fn boxerplay_mouse(int id, act, btn, int r, int c, mods = "") {
	local p=${BP[$id]["p"]} b=1 at ar ac

	[ -n "$p" ] || return 0
	case $btn in middle) b=4 ;; right) b=2 ;; esac
	if [ "${BP[$id]["capmode"]-}" = click ] && [ "${BP[$id]["cap"]}" != 1 ]; then
		case ${act##*-} in press) bp_capture "$id" 1 ;; esac
		return 0
	fi
	at := bp_at "$id" "$r" "$c"
	read -r ar ac <<< "$at"
	case ${act##*-} in
	move | hover) retro mouse "$p" "$ar" "$ac" "${BP[$id]["btn"]:-0}" ;;
	press | drag) BP[$id]["btn"]=$b; retro mouse "$p" "$ar" "$ac" "$b" ;;
	release) BP[$id]["btn"]=0; retro mouse "$p" "$ar" "$ac" 0 ;;
	esac
	return 0
}

# The pointer over the window with no button down, once the desktop has hovering
# on (hibr 0.99.304): DOS's pointer goes where it is. The desktop says -1 -1 when
# the pointer leaves; a captured mouse is let go then, and otherwise DOS's pointer
# stays where it was.
fn boxerplay_hover(int id, int r, int c) {
	local p=${BP[$id]["p"]-} at ar ac

	[ -n "$p" ] || return 0
	if [ "$r" -lt 0 ]; then
		bp_capture "$id" 0
		return 0
	fi
	[ -z "${BP[$id]["choose"]-}" ] || return 0
	if [ "${BP[$id]["capmode"]-}" = click ] && [ "${BP[$id]["cap"]}" != 1 ]; then
		return 0
	fi
	at := bp_at "$id" "$r" "$c"
	read -r ar ac <<< "$at"
	retro mouse "$p" "$ar" "$ac" "${BP[$id]["btn"]:-0}"
	return 0
}

fn boxerplay_click(int id, int r, int c, btn = "") {
	[ -n "${BP[$id]["choose"]-}" ] && bp_chooseclick "$id" "$r" "$c"
	return 0
}

fn boxerplay_wheel(int id, dir, int r, int c) {
	local p=${BP[$id]["p"]} wh=1

	[ -n "$p" ] || return 0
	[ "$dir" = up ] && wh=-1
	retro mouse "$p" "$r" "$c" 0 "$wh"
	return 0
}

# Where the core's state is kept between sessions: the gamebox's saves/.
fn bp_state(int id) {
	ret "${BP[$id]["box"]}/saves/state.sav"
}

fn bp_save(int id) {
	local f

	f := bp_state "$id"
	retro save "${BP[$id]["p"]}" "$f" 2> /dev/null ||
		dt_notify "Boxer" "The game gave no state to save" 2> /dev/null
	return 0
}

fn bp_load(int id) {
	local f

	f := bp_state "$id"
	[ -r "$f" ] && retro load "${BP[$id]["p"]}" "$f" 2> /dev/null
	return 0
}

fn bp_toggle(int id) {
	retro toggle "${BP[$id]["p"]}" 2> /dev/null
	return 0
}

# Game > Capture Mouse: take the mouse or let it go, for a game set to capture on
# click. A seamless game has it already, so say how to change that.
fn bp_grab(int id) {
	if [ "${BP[$id]["capmode"]-}" = click ]; then
		if [ "${BP[$id]["cap"]}" = 1 ]; then bp_capture "$id" 0; else bp_capture "$id" 1; fi
	elif dt_has dt_hoveron && dt_hoveron; then
		dt_notep low "The mouse is seamless here; set Capture to click in the game's Get Info to have to click in first"
	elif [ "${DT_HOVER-auto}" = auto ]; then
		dt_notep low "Hover is Auto, and this terminal does not report the pointer in pixels; set Control Panel > Mouse > Hover to On to try it"
	else
		dt_notep low "Turn on Control Panel > Mouse > Hover and the pointer follows the mouse"
	fi
	return 0
}

fn bp_reset(int id) {
	retro reset "${BP[$id]["p"]}" 2> /dev/null
	return 0
}

fn boxerplay_close(int id) {
	local fd=${BP[$id]["fd"]} st box=${BP[$id]["box"]-}

	[ -n "${BP[$id]["gone"]-}" ] && { unset "BP[$id]"; return 0; }

	# The core goes first: finishing an install can take a while, and a frame
	# nobody reads in the meantime is a descriptor the desktop warns about.
	[ -n "$fd" ] && command -v console > /dev/null && console unwatch "$fd"
	[ -n "${BP[$id]["p"]}" ] && retro close "${BP[$id]["p"]}" 2> /dev/null
	[ -n "${BP[$id]["dir"]}" ] && command rm -rf -- "${BP[$id]["dir"]}"
	st := bp_state_of "$box"
	# An installer that put nothing on C: has not installed anything yet; the
	# box stays as it is, and Game Is Already Installed says otherwise.
	if [ "$st" = installing ] && [ -n "$(ls -A "$box/drives/c" 2> /dev/null)" ]; then
		bd_finish "$box"
	fi
	unset "BP[$id]"
}

# Restart Desktop: the core runs in this process, which the restart ends,
# so the game is started again from its gamebox on the first frame after.
fn boxerplay_stash(int id, dir) {
	BP[$id]["p"]=
	BP[$id]["fd"]=
	return 0
}
fn boxerplay_resume(int id) {
	boxerplay_open "$id" "${BP[$id]["box"]}"
	return 0
}

boxerplay_menus() {
	dt_menu "File"
	dt_item "Save State" s bp_save "$DT_FOCUS"
	dt_item "Load State" l bp_load "$DT_FOCUS"
	dt_sep
	dt_item "Close Window" w dt_close_focused
	dt_editmenu
	dt_menu "Game"
	dt_item "Pause" p bp_toggle "$DT_FOCUS"
	dt_item "Capture Mouse" g bp_grab "$DT_FOCUS"
	dt_item "Restart" r bp_reset "$DT_FOCUS"
}
