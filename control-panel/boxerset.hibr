#!/usr/bin/env hibr
#
# boxerset -- the Control Panel pane for Boxer: where the games are kept,
# how a game is drawn (as pixels, or as half blocks for a slow link), the
# shape of its picture, the key that fills the display, how long a key is
# held, and the sound. These are for every game; a game's own are in the
# Get Info window, and win. Named boxerset, not boxer, because the app
# owns the boxer_ prefix; the dialog is bxfield.

strict

app boxerset "The Control Panel pane for Boxer" 0.13
command -v cp_pane > /dev/null && cp_pane boxerset "Boxer" "▣" app
command -v dt_app > /dev/null &&
	dt_app bxfield "Games Folder" 9 64 "" "" fixed hidden
command -v dt_app > /dev/null &&
	dt_app bxcolour "Full Screen Border" 14 54 "" "" fixed hidden

# The shelf: the person's Dos Games folder in their home, unless a shelf from
# before it was called that is there and the new one is not, which is kept
# in use rather than made to vanish.
fn bxs_defshelf() {
	local old="${XDG_DATA_HOME:-$HOME/.local/share}/hibr/shelf"

	if [ ! -d "$HOME/Dos Games" ] && [ -d "$old" ]; then
		ret "$old"
	else
		ret "$HOME/Dos Games"
	fi
}
BXS_DEF=
[ -n "${BX_SHELF-}" ] || { BXS_DEF := bxs_defshelf; BX_SHELF=$BXS_DEF; }
BX_PIC="${BX_PIC-follow}"
BX_ASPECT="${BX_ASPECT-4:3}"
BX_HOLD="${BX_HOLD-120}"
BX_LIMIT="${BX_LIMIT-pentium}"
BX_SOUND="${BX_SOUND-on}"
BX_MOUSE="${BX_MOUSE-relative}"
# The mouse was direct until BX_MOUSEV 2; a setting still saying direct was the old default, not a choice.
BX_MOUSEV="${BX_MOUSEV-}"
if [ "$BX_MOUSEV" != 2 ]; then
	[ "$BX_MOUSE" = direct ] && BX_MOUSE=relative
	BX_MOUSEV=2
fi
BX_CAPTURE="${BX_CAPTURE-click}"
BX_RELKEY="${BX_RELKEY-f12}"
BX_CONFIRM="${BX_CONFIRM-on}"
BX_AUTOCLOSE="${BX_AUTOCLOSE-on}"
BX_CARD="${BX_CARD-sb16}"
BX_MIDIDIR="${BX_MIDIDIR-}"
BX_MIDI="${BX_MIDI-disabled}"
BX_ART="${BX_ART-off}"
BX_BORDER="${BX_BORDER-#000000}"
BX_SEARCH="${BX_SEARCH-}"
[ -n "$BX_SEARCH" ] || BX_SEARCH="{name} box cover"
BX_ENGINE="${BX_ENGINE-}"
[ -n "$BX_ENGINE" ] || BX_ENGINE="https://duckduckgo.com/?q={q}&iax=images&ia=images"
command -v dt_keep > /dev/null && dt_keep BX_BORDER BX_SEARCH BX_ENGINE BX_ART BX_SHELF BX_PIC BX_ASPECT BX_HOLD BX_SOUND BX_MOUSE BX_MOUSEV BX_CAPTURE BX_RELKEY BX_CONFIRM BX_AUTOCLOSE BX_LIMIT BX_CARD BX_MIDIDIR BX_MIDI

# follow is Control Panel > Pictures, as the wallpaper's and YouTube's are.
BXS_PICS=(follow pixels half)
BXS_COLOURS=("#000000" "#111111" "#222222" "#333333" "#444444" "#555555" "#777777" "#ffffff"
	"#0d1b2a" "#1b263b" "#14213d" "#1a1a40" "#2d1b4e" "#3b1c32" "#4a1f1f" "#3d2b1f"
	"#1f4068" "#1b5e5e" "#2e5e3e" "#556b2f" "#8b6914" "#a0522d" "#8b2f4f" "#5b3f8c"
	"#1e90ff" "#00a8a8" "#2ecc71" "#c8d400" "#ff9f1a" "#ff4d4d" "#ff4fa3" "#a77bff")
BXS_ASPECTS=(4:3 auto 16:10 16:9 1:1)
BXS_HOLDS=(60 120 200 300 500)
BXS_MICE=(direct relative off)
BXS_CAPS=(click seamless)
BXS_LIMITS=(unlimited pentium2 pentium 486dx2 486dx 386)
BXS_RELKEYS=(f12 ctrl-f10 f11 f10)
BXS_CARDS=(sb16 sbpro2 sb1 none)
declare -gA BXF
declare -gA BXC

fn cp_set_bxpic(int? id = "", value = "") { BX_PIC=$value; cp_save; }
fn cp_set_bxaspect(int? id = "", value = "") { BX_ASPECT=$value; cp_save; }
fn cp_set_bxhold(int? id = "", value = "") { BX_HOLD=$value; cp_save; }
fn cp_set_bxmouse(int? id = "", value = "") { BX_MOUSE=$value; cp_save; }
fn cp_set_bxrel(int? id = "", value = "") { BX_RELKEY=$value; cp_save; }
fn cp_set_bxcap(int? id = "", value = "") { BX_CAPTURE=$value; cp_save; }
fn cp_set_bxlimit(int? id = "", value = "") { BX_LIMIT=$value; cp_save; }
fn cp_set_bxcard(int? id = "", value = "") { BX_CARD=$value; cp_save; }
fn cp_set_bxmidi(int? id = "", value = "") { BX_MIDI=$value; cp_save; }

# The MIDI outputs on offer: none, and whatever synths the folder holds.
fn bxs_midis() {
	local f
	local l

	l=disabled
	if dt_has bp_midilist; then
		while IFS= read -r f; do
			[ -n "$f" ] && l="$l $f"
		done <<< "$(bp_midilist)"
	fi
	ret "$l"
}

fn boxerset_rows(int w) {
	local n=0

	CP[$w][$n]["kind"]=head; CP[$w][$n]["text"]="Games"; n=$((n + 1))
	CP[$w][$n]["kind"]=action; CP[$w][$n]["text"]="Folder${GL[ellipsis]}"
	CP[$w][$n]["val"]="$BX_SHELF"; CP[$w][$n]["key"]=shelf
	n=$((n + 1))
	CP[$w][$n]["kind"]=set; CP[$w][$n]["text"]="Fetch Box Art"
	CP[$w][$n]["wtype"]=bool
	CP[$w][$n]["val"]=off; [ "$BX_ART" = on ] && CP[$w][$n]["val"]=on
	CP[$w][$n]["key"]=art; n=$((n + 1))
	CP[$w][$n]["kind"]=head; CP[$w][$n]["text"]="Cover Search"; n=$((n + 1))
	CP[$w][$n]["kind"]=action; CP[$w][$n]["text"]="Search Text${GL[ellipsis]}"
	CP[$w][$n]["val"]="$BX_SEARCH"; CP[$w][$n]["key"]=search
	n=$((n + 1))
	CP[$w][$n]["kind"]=action; CP[$w][$n]["text"]="Search Engine${GL[ellipsis]}"
	CP[$w][$n]["val"]="$BX_ENGINE"; CP[$w][$n]["key"]=engine
	n=$((n + 1))
	CP[$w][$n]["kind"]=head; CP[$w][$n]["text"]="Display"; n=$((n + 1))
	CP[$w][$n]["kind"]=set; CP[$w][$n]["text"]="Rendering"
	CP[$w][$n]["val"]="$BX_PIC"; CP[$w][$n]["key"]=pic
	n=$((n + 1))
	CP[$w][$n]["kind"]=set; CP[$w][$n]["text"]="Shape"
	CP[$w][$n]["val"]="$BX_ASPECT"; CP[$w][$n]["key"]=aspect
	n=$((n + 1))
	CP[$w][$n]["kind"]=action; CP[$w][$n]["text"]="Full Screen Border${GL[ellipsis]}"
	CP[$w][$n]["val"]="$BX_BORDER"; CP[$w][$n]["key"]=border
	n=$((n + 1))
	CP[$w][$n]["kind"]=head; CP[$w][$n]["text"]="Keys"; n=$((n + 1))
	CP[$w][$n]["kind"]=set; CP[$w][$n]["text"]="Release Mouse Key"
	CP[$w][$n]["val"]="$BX_RELKEY"; CP[$w][$n]["key"]=relkey
	n=$((n + 1))
	CP[$w][$n]["kind"]=set; CP[$w][$n]["text"]="Key Held (ms)"
	CP[$w][$n]["val"]="$BX_HOLD"; CP[$w][$n]["key"]=hold
	n=$((n + 1))
	CP[$w][$n]["kind"]=set; CP[$w][$n]["text"]="Mouse"
	CP[$w][$n]["val"]="$BX_MOUSE"; CP[$w][$n]["key"]=mouse
	n=$((n + 1))
	CP[$w][$n]["kind"]=set; CP[$w][$n]["text"]="Mouse Capture"
	CP[$w][$n]["val"]="$BX_CAPTURE"; CP[$w][$n]["key"]=capture
	n=$((n + 1))
	CP[$w][$n]["kind"]=head; CP[$w][$n]["text"]="Speed"; n=$((n + 1))
	CP[$w][$n]["kind"]=set; CP[$w][$n]["text"]="Speed Limit"
	CP[$w][$n]["val"]="$BX_LIMIT"; CP[$w][$n]["key"]=limit
	n=$((n + 1))
	CP[$w][$n]["kind"]=head; CP[$w][$n]["text"]="Quitting"; n=$((n + 1))
	CP[$w][$n]["kind"]=set; CP[$w][$n]["text"]="Confirm On Exit"
	CP[$w][$n]["wtype"]=bool
	CP[$w][$n]["val"]=off; [ "$BX_CONFIRM" = on ] && CP[$w][$n]["val"]=on
	CP[$w][$n]["key"]=confirm; n=$((n + 1))
	CP[$w][$n]["kind"]=set; CP[$w][$n]["text"]="Close When Game Ends"
	CP[$w][$n]["wtype"]=bool
	CP[$w][$n]["val"]=off; [ "$BX_AUTOCLOSE" = on ] && CP[$w][$n]["val"]=on
	CP[$w][$n]["key"]=autoclose; n=$((n + 1))
	CP[$w][$n]["kind"]=head; CP[$w][$n]["text"]="Sound"; n=$((n + 1))
	CP[$w][$n]["kind"]=set; CP[$w][$n]["text"]="Sound"
	CP[$w][$n]["wtype"]=bool
	CP[$w][$n]["val"]=off; [ "$BX_SOUND" = on ] && CP[$w][$n]["val"]=on
	CP[$w][$n]["key"]=sound; n=$((n + 1))
	CP[$w][$n]["kind"]=set; CP[$w][$n]["text"]="Sound Card"
	CP[$w][$n]["val"]="$BX_CARD"; CP[$w][$n]["key"]=card
	n=$((n + 1))
	CP[$w][$n]["kind"]=head; CP[$w][$n]["text"]="MIDI"; n=$((n + 1))
	CP[$w][$n]["kind"]=action; CP[$w][$n]["text"]="Synth Folder${GL[ellipsis]}"
	CP[$w][$n]["val"]="${BX_MIDIDIR:-none}"; CP[$w][$n]["key"]=mididir
	n=$((n + 1))
	CP[$w][$n]["kind"]=set; CP[$w][$n]["text"]="MIDI Output"
	CP[$w][$n]["val"]="$BX_MIDI"; CP[$w][$n]["key"]=midi
	n=$((n + 1))
	ret "$n"
}

fn boxerset_do(int? w = "", k = "", int? dir = "") {
	local v m
	local -a ml

	case $k in
	shelf) bxs_dialog shelf; return 0 ;;
	pic) v := cp_next "$BX_PIC" "$dir" "${BXS_PICS[@]}"; BX_PIC=$v ;;
	aspect) v := cp_next "$BX_ASPECT" "$dir" "${BXS_ASPECTS[@]}"; BX_ASPECT=$v ;;
	border) bxs_colours; return 0 ;;
	relkey) v := cp_next "$BX_RELKEY" "$dir" "${BXS_RELKEYS[@]}"; BX_RELKEY=$v ;;
	hold) v := cp_next "$BX_HOLD" "$dir" "${BXS_HOLDS[@]}"; BX_HOLD=$v ;;
	mouse) v := cp_next "$BX_MOUSE" "$dir" "${BXS_MICE[@]}"; BX_MOUSE=$v ;;
	capture) v := cp_next "$BX_CAPTURE" "$dir" "${BXS_CAPS[@]}"; BX_CAPTURE=$v ;;
	limit) v := cp_next "$BX_LIMIT" "$dir" "${BXS_LIMITS[@]}"; BX_LIMIT=$v ;;
	confirm) [ "$BX_CONFIRM" = on ] && BX_CONFIRM=off || BX_CONFIRM=on ;;
	autoclose) [ "$BX_AUTOCLOSE" = on ] && BX_AUTOCLOSE=off || BX_AUTOCLOSE=on ;;
	art) [ "$BX_ART" = on ] && BX_ART=off || BX_ART=on ;;
	sound) [ "$BX_SOUND" = on ] && BX_SOUND=off || BX_SOUND=on ;;
	card) v := cp_next "$BX_CARD" "$dir" "${BXS_CARDS[@]}"; BX_CARD=$v ;;
	mididir) bxs_dialog midi; return 0 ;;
	search) bxs_dialog search; return 0 ;;
	engine) bxs_dialog engine; return 0 ;;
	midi) m := bxs_midis; read -ra ml <<< "$m"; v := cp_next "$BX_MIDI" "$dir" "${ml[@]}"; BX_MIDI=$v ;;
	esac
	cp_save
}

fn boxerset_drop(int? w = "", int? r = "", int? c = "", k = "") {
	local m
	local -a ml

	case $k in
	pic) dt_droplist "$w" "$r" "$c" cp_set_bxpic "${BXS_PICS[@]}" ;;
	aspect) dt_droplist "$w" "$r" "$c" cp_set_bxaspect "${BXS_ASPECTS[@]}" ;;
	border) bxs_colours ;;
	relkey) dt_droplist "$w" "$r" "$c" cp_set_bxrel "${BXS_RELKEYS[@]}" ;;
	hold) dt_droplist "$w" "$r" "$c" cp_set_bxhold "${BXS_HOLDS[@]}" ;;
	mouse) dt_droplist "$w" "$r" "$c" cp_set_bxmouse "${BXS_MICE[@]}" ;;
	capture) dt_droplist "$w" "$r" "$c" cp_set_bxcap "${BXS_CAPS[@]}" ;;
	limit) dt_droplist "$w" "$r" "$c" cp_set_bxlimit "${BXS_LIMITS[@]}" ;;
	card) dt_droplist "$w" "$r" "$c" cp_set_bxcard "${BXS_CARDS[@]}" ;;
	midi) m := bxs_midis; read -ra ml <<< "$m"; dt_droplist "$w" "$r" "$c" cp_set_bxmidi "${ml[@]}" ;;
	esac
}

# --- the border colour picker --------------------------------------------------

# A window of coloured blocks, four rows of eight: a click, or the arrows and Enter, choose.
fn bxs_colours() {
	local h=14 w=54 r c rid i

	dt_dlgat "$h" "$w"
	r=$DT_DLGR c=$DT_DLGC h=$DT_DLGH w=$DT_DLGW
	rid := dt_new "Full Screen Border" "$h" "$w" "$r" "$c" bxcolour
	BXC[$rid]["sel"]=0
	for i in "${!BXS_COLOURS[@]}"; do
		[ "${BXS_COLOURS[$i]}" = "$BX_BORDER" ] && BXC[$rid]["sel"]=$i
	done
	return 0
}

fn bxcolour_draw(int id, int h, int w, int row, int col) {
	local i r c k fg sel=${BXC[$id]["sel"]}

	dt_wclear "$id"
	console pen "$DT_INK" "$DT_FACE"
	dt_tput "$id" 1 2 "The colour behind the picture in full screen:"
	for i in "${!BXS_COLOURS[@]}"; do
		r=$((3 + (i / 8) * 2))
		c=$((2 + (i % 8) * 6))
		k=${BXS_COLOURS[$i]}
		console pen white "$k"
		console fill -p "w$id" "$r" "$c" 2 6 " "
		if [ "$i" = "$sel" ]; then
			fg=white
			[ "$i" -ge 24 ] || [ "$i" = 7 ] || [ "$i" = 6 ] && fg=black
			console pen "$fg" "$k" bold
			dt_tput "$id" "$r" $((c + 2)) "▐▌"
			dt_tput "$id" $((r + 1)) $((c + 2)) "▐▌"
		fi
		dt_wreg "$id" "$r" "$c" 6 "c$i"
		dt_wreg "$id" $((r + 1)) "$c" 6 "c$i"
	done
	console pen "$DT_DIM" "$DT_FACE"
	dt_tput "$id" 11 2 "${BXS_COLOURS[$sel]}"
	dt_dlgbtns "$id" "$h" "$w" ok ok Choose cancel Cancel
}

fn bxcolour_pick(int id) {
	BX_BORDER=${BXS_COLOURS[${BXC[$id]["sel"]}]}
	cp_save
	dt_del "$id"
}

fn bxcolour_click(int id, int r, int c, btn = "") {
	local tag

	tag := dt_hit "$id" "$r" "$c"
	case $tag in
	c[0-9]*)
		if [ "${BXC[$id]["sel"]}" = "${tag#c}" ]; then bxcolour_pick "$id"; else BXC[$id]["sel"]=${tag#c}; fi
		;;
	ok) bxcolour_pick "$id" ;;
	cancel) dt_del "$id" ;;
	esac
	return 0
}

fn bxcolour_key(int id, key) {
	local s=${BXC[$id]["sel"]} n=${#BXS_COLOURS[@]}

	case $key in
	escape) dt_del "$id"; return 0 ;;
	enter) bxcolour_pick "$id"; return 0 ;;
	left) [ "$s" -gt 0 ] && s=$((s - 1)) ;;
	right) [ $((s + 1)) -lt "$n" ] && s=$((s + 1)) ;;
	up) [ "$s" -ge 8 ] && s=$((s - 8)) ;;
	down) [ $((s + 8)) -lt "$n" ] && s=$((s + 8)) ;;
	*) return 0 ;;
	esac
	BXC[$id]["sel"]=$s
	return 0
}

fn bxcolour_close(int id) {
	unset "BXC[$id]"
}

# --- the shelf folder dialog --------------------------------------------------

# One field: the folder, typed, a ~ meaning the home folder.
fn bxs_dialog(what = shelf) {
	local h=9 w=64 r c rid title="Games Folder"

	dt_dlgat "$h" "$w"
	r=$DT_DLGR c=$DT_DLGC h=$DT_DLGH w=$DT_DLGW
	[ "$what" = midi ] && title="MIDI Synth Folder"
	[ "$what" = search ] && title="Cover Search Text"
	[ "$what" = engine ] && title="Cover Search Engine"
	rid := dt_new "$title" "$h" "$w" "$r" "$c" bxfield
	BXF[$rid]["what"]=$what
	BXF[$rid]["path"]=$BX_SHELF
	[ "$what" = midi ] && BXF[$rid]["path"]=$BX_MIDIDIR
	[ "$what" = search ] && BXF[$rid]["path"]=$BX_SEARCH
	[ "$what" = engine ] && BXF[$rid]["path"]=$BX_ENGINE
	BXF[$rid]["cur"]=${#BXF[$rid]["path"]}
	BXF[$rid]["focus"]=path
}

fn bxfield_draw(int id, int h, int w, int row, int col) {
	local f=${BXF[$id]["focus"]} on=0 cur=0

	dt_wclear "$id"
	console pen "$DT_INK" "$DT_FACE"
	if [ "${BXF[$id]["what"]}" = midi ]; then
		dt_tput "$id" 1 2 "The folder with your SoundFonts (.sf2) and Roland ROMs:"
	elif [ "${BXF[$id]["what"]}" = search ]; then
		dt_tput "$id" 1 2 "What Find Cover searches for, made out of the game:"
	elif [ "${BXF[$id]["what"]}" = engine ]; then
		dt_tput "$id" 1 2 "The web address Find Cover searches the web at:"
	else
		dt_tput "$id" 1 2 "Games are kept in this folder, one NAME.boxer to a game:"
	fi
	[ "$f" = path ] && { on=1; cur=${BXF[$id]["cur"]}; }
	dt_textdraw "$id" 3 2 $((w - 4)) "${BXF[$id]["path"]}" "$cur" "$on"
	dt_wreg "$id" 3 2 $((w - 4)) path
	console pen "$DT_DIM" "$DT_FACE"
	if [ "${BXF[$id]["what"]}" = midi ]; then
		dt_tput "$id" 5 2 "MT32_CONTROL.ROM with MT32_PCM.ROM, ROM1.BIN, or a .sf2. Empty for none."
	elif [ "${BXF[$id]["what"]}" = search ]; then
		dt_tput "$id" 5 2 "{name} {year} {program} are filled in: {name} DOS box art"
	elif [ "${BXF[$id]["what"]}" = engine ]; then
		dt_tput "$id" 5 2 "{q} is where the search goes in the address."
	else
		dt_tput "$id" 5 2 "It is made if it is not there. Games already in the old one stay there."
	fi
	dt_dlgbtns "$id" "$h" "$w" "$f" ok Save cancel Cancel
}

fn bxfield_ok(int id) {
	local p=${BXF[$id]["path"]}

	p=${p//[$'\t\n']/ }
	case ${BXF[$id]["what"]} in
	search | engine)
		if [ -z "${p// /}" ]; then
			[ "${BXF[$id]["what"]}" = search ] && p="{name} box cover" || p="https://duckduckgo.com/?q={q}&iax=images&ia=images"
		fi
		[ "${BXF[$id]["what"]}" = search ] && BX_SEARCH=$p || BX_ENGINE=$p
		cp_save
		dt_del "$id"
		return 0
		;;
	esac
	case $p in "~") p=$HOME ;; "~/"*) p="$HOME/${p#"~/"}" ;; esac
	if [ "${BXF[$id]["what"]}" = midi ]; then
		if [ -n "${p// /}" ] && [ ! -d "$p" ]; then
			dt_notep high "There is no such folder"
			return 0
		fi
		BX_MIDIDIR=$p
		cp_save
		dt_del "$id"
		return 0
	fi
	if [ -z "${p// /}" ]; then
		dt_notep high "A games folder is needed"
		return 0
	fi
	mkdir -p "$p" 2> /dev/null || {
		dt_notep high "Cannot make that folder"
		return 0
	}
	BX_SHELF=$p
	cp_save
	dt_del "$id"
}

fn bxfield_click(int id, int r, int c, btn = "") {
	local tag

	tag := dt_hit "$id" "$r" "$c"
	case $tag in
	path) BXF[$id]["focus"]=path; BXF[$id]["cur"]=${#BXF[$id]["path"]} ;;
	ok) bxfield_ok "$id" ;;
	cancel) dt_del "$id" ;;
	esac
	return 0
}

fn bxfield_key(int id, key) {
	local res f=${BXF[$id]["focus"]} d onb=1
	local -a o=(path ok cancel)

	[ "$f" = path ] && onb=0
	if d := dt_focuskey "$key" "$onb"; then
		BXF[$id]["focus"] := dt_focus "$f" "$d" "${o[@]}"
		[ "${BXF[$id]["focus"]}" = path ] && BXF[$id]["cur"]=${#BXF[$id]["path"]}
		return 0
	fi
	case $key in
	escape) dt_del "$id"; return 0 ;;
	enter)
		case $f in
		cancel) dt_del "$id" ;;
		*) bxfield_ok "$id" ;;
		esac
		return 0
		;;
	esac
	[ "$f" = path ] || return 0
	res := dt_textkey "${BXF[$id]["path"]}" "${BXF[$id]["cur"]}" "$key" || return 1
	BXF[$id]["path"]=${res% *}
	BXF[$id]["cur"]=${res##* }
	return 0
}

fn bxfield_close(int id) {
	unset "BXF[$id]"
}

fn bxfield_copy(int id) {
	local t

	[ "${BXF[$id]["focus"]}" = path ] || return 1
	t := dt_fieldsel || return 1
	ret "$t"
}

fn bxfield_cut(int id) {
	local t

	[ "${BXF[$id]["focus"]}" = path ] || return 1
	t := dt_fieldcut "$id" || return 1
	ret "$t"
}

fn bxfield_paste(int id, text, op = "") {
	local r

	BXF[$id]["focus"]=path
	r := dt_textpaste "${BXF[$id]["path"]}" "${BXF[$id]["cur"]}" "$text"
	BXF[$id]["path"]=${r% *}
	BXF[$id]["cur"]=${r##* }
}
