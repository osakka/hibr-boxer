#!/usr/bin/env hibr
#
# boxerset -- the Control Panel pane for Boxer: where the games are kept,
# how a game is drawn (as pixels, or as half blocks for a slow link), the
# shape of its picture, the key that fills the display, how long a key is
# held, and the sound. These are for every game; a game's own are in the
# Get Info window, and win. Named boxerset, not boxer, because the app
# owns the boxer_ prefix; the dialog is bxfield.

strict

app boxerset "The Control Panel pane for Boxer" 0.5
command -v cp_pane > /dev/null && cp_pane boxerset "Boxer" "▣" app
command -v dt_app > /dev/null &&
	dt_app bxfield "Games Folder" 9 64 "" "" fixed hidden

# The shelf: the person's Dos Games folder in their home, unless a shelf from
# before it was called that is there and the new one is not, which is kept
# in use rather than made to vanish.
fn bxs_defshelf() {
	local old="${XDG_DATA_HOME:-$HOME/.local/share}/hibr/shelf"

	if [ ! -d "$HOME/Dos Games" ] && [ -d "$old" ]; then
		ret "$old"
	else
		ret "$HOME/Dos Games"
	fi
}
BXS_DEF=
[ -n "${BX_SHELF-}" ] || { BXS_DEF := bxs_defshelf; BX_SHELF=$BXS_DEF; }
BX_PIC="${BX_PIC-follow}"
BX_ASPECT="${BX_ASPECT-4:3}"
BX_FULLKEY="${BX_FULLKEY-alt-enter}"
BX_HOLD="${BX_HOLD-120}"
BX_SOUND="${BX_SOUND-on}"
BX_MOUSE="${BX_MOUSE-direct}"
BX_CARD="${BX_CARD-sb16}"
BX_MIDIDIR="${BX_MIDIDIR-}"
BX_MIDI="${BX_MIDI-disabled}"
BX_ART="${BX_ART-off}"
command -v dt_keep > /dev/null && dt_keep BX_ART BX_SHELF BX_PIC BX_ASPECT BX_FULLKEY BX_HOLD BX_SOUND BX_MOUSE BX_CARD BX_MIDIDIR BX_MIDI

# follow is Control Panel > Pictures, as the wallpaper's and YouTube's are.
BXS_PICS=(follow pixels half)
BXS_ASPECTS=(4:3 auto 16:10 16:9 1:1)
BXS_KEYS=(alt-enter f11 f12 ctrl-f none)
BXS_HOLDS=(60 120 200 300 500)
BXS_MICE=(direct relative off)
BXS_CARDS=(sb16 sbpro2 sb1 none)
declare -gA BXF

fn cp_set_bxpic(int? id = "", value = "") { BX_PIC=$value; cp_save; }
fn cp_set_bxaspect(int? id = "", value = "") { BX_ASPECT=$value; cp_save; }
fn cp_set_bxkey(int? id = "", value = "") { BX_FULLKEY=$value; cp_save; }
fn cp_set_bxhold(int? id = "", value = "") { BX_HOLD=$value; cp_save; }
fn cp_set_bxmouse(int? id = "", value = "") { BX_MOUSE=$value; cp_save; }
fn cp_set_bxcard(int? id = "", value = "") { BX_CARD=$value; cp_save; }
fn cp_set_bxmidi(int? id = "", value = "") { BX_MIDI=$value; cp_save; }

# The MIDI outputs on offer: none, and whatever synths the folder holds.
fn bxs_midis() {
	local f
	local l

	l=disabled
	if dt_has bp_midilist; then
		while IFS= read -r f; do
			[ -n "$f" ] && l="$l $f"
		done <<< "$(bp_midilist)"
	fi
	ret "$l"
}

fn boxerset_rows(int w) {
	local n=0

	CP[$w][$n]["kind"]=head; CP[$w][$n]["text"]="Games"; n=$((n + 1))
	CP[$w][$n]["kind"]=action; CP[$w][$n]["text"]="Folder${GL[ellipsis]}"
	CP[$w][$n]["val"]="$BX_SHELF"; CP[$w][$n]["key"]=shelf
	n=$((n + 1))
	CP[$w][$n]["kind"]=set; CP[$w][$n]["text"]="Fetch Box Art"
	CP[$w][$n]["wtype"]=bool
	CP[$w][$n]["val"]=off; [ "$BX_ART" = on ] && CP[$w][$n]["val"]=on
	CP[$w][$n]["key"]=art; n=$((n + 1))
	CP[$w][$n]["kind"]=head; CP[$w][$n]["text"]="Display"; n=$((n + 1))
	CP[$w][$n]["kind"]=set; CP[$w][$n]["text"]="Rendering"
	CP[$w][$n]["val"]="$BX_PIC"; CP[$w][$n]["key"]=pic
	n=$((n + 1))
	CP[$w][$n]["kind"]=set; CP[$w][$n]["text"]="Shape"
	CP[$w][$n]["val"]="$BX_ASPECT"; CP[$w][$n]["key"]=aspect
	n=$((n + 1))
	CP[$w][$n]["kind"]=head; CP[$w][$n]["text"]="Keys"; n=$((n + 1))
	CP[$w][$n]["kind"]=set; CP[$w][$n]["text"]="Full Screen Key"
	CP[$w][$n]["val"]="$BX_FULLKEY"; CP[$w][$n]["key"]=fullkey
	n=$((n + 1))
	CP[$w][$n]["kind"]=set; CP[$w][$n]["text"]="Key Held (ms)"
	CP[$w][$n]["val"]="$BX_HOLD"; CP[$w][$n]["key"]=hold
	n=$((n + 1))
	CP[$w][$n]["kind"]=set; CP[$w][$n]["text"]="Mouse"
	CP[$w][$n]["val"]="$BX_MOUSE"; CP[$w][$n]["key"]=mouse
	n=$((n + 1))
	CP[$w][$n]["kind"]=head; CP[$w][$n]["text"]="Sound"; n=$((n + 1))
	CP[$w][$n]["kind"]=set; CP[$w][$n]["text"]="Sound"
	CP[$w][$n]["wtype"]=bool
	CP[$w][$n]["val"]=off; [ "$BX_SOUND" = on ] && CP[$w][$n]["val"]=on
	CP[$w][$n]["key"]=sound; n=$((n + 1))
	CP[$w][$n]["kind"]=set; CP[$w][$n]["text"]="Sound Card"
	CP[$w][$n]["val"]="$BX_CARD"; CP[$w][$n]["key"]=card
	n=$((n + 1))
	CP[$w][$n]["kind"]=head; CP[$w][$n]["text"]="MIDI"; n=$((n + 1))
	CP[$w][$n]["kind"]=action; CP[$w][$n]["text"]="Synth Folder${GL[ellipsis]}"
	CP[$w][$n]["val"]="${BX_MIDIDIR:-none}"; CP[$w][$n]["key"]=mididir
	n=$((n + 1))
	CP[$w][$n]["kind"]=set; CP[$w][$n]["text"]="MIDI Output"
	CP[$w][$n]["val"]="$BX_MIDI"; CP[$w][$n]["key"]=midi
	n=$((n + 1))
	ret "$n"
}

fn boxerset_do(int? w = "", k = "", int? dir = "") {
	local v m
	local -a ml

	case $k in
	shelf) bxs_dialog shelf; return 0 ;;
	pic) v := cp_next "$BX_PIC" "$dir" "${BXS_PICS[@]}"; BX_PIC=$v ;;
	aspect) v := cp_next "$BX_ASPECT" "$dir" "${BXS_ASPECTS[@]}"; BX_ASPECT=$v ;;
	fullkey) v := cp_next "$BX_FULLKEY" "$dir" "${BXS_KEYS[@]}"; BX_FULLKEY=$v ;;
	hold) v := cp_next "$BX_HOLD" "$dir" "${BXS_HOLDS[@]}"; BX_HOLD=$v ;;
	mouse) v := cp_next "$BX_MOUSE" "$dir" "${BXS_MICE[@]}"; BX_MOUSE=$v ;;
	art) [ "$BX_ART" = on ] && BX_ART=off || BX_ART=on ;;
	sound) [ "$BX_SOUND" = on ] && BX_SOUND=off || BX_SOUND=on ;;
	card) v := cp_next "$BX_CARD" "$dir" "${BXS_CARDS[@]}"; BX_CARD=$v ;;
	mididir) bxs_dialog midi; return 0 ;;
	midi) m := bxs_midis; read -ra ml <<< "$m"; v := cp_next "$BX_MIDI" "$dir" "${ml[@]}"; BX_MIDI=$v ;;
	esac
	cp_save
}

fn boxerset_drop(int? w = "", int? r = "", int? c = "", k = "") {
	local m
	local -a ml

	case $k in
	pic) dt_droplist "$w" "$r" "$c" cp_set_bxpic "${BXS_PICS[@]}" ;;
	aspect) dt_droplist "$w" "$r" "$c" cp_set_bxaspect "${BXS_ASPECTS[@]}" ;;
	fullkey) dt_droplist "$w" "$r" "$c" cp_set_bxkey "${BXS_KEYS[@]}" ;;
	hold) dt_droplist "$w" "$r" "$c" cp_set_bxhold "${BXS_HOLDS[@]}" ;;
	mouse) dt_droplist "$w" "$r" "$c" cp_set_bxmouse "${BXS_MICE[@]}" ;;
	card) dt_droplist "$w" "$r" "$c" cp_set_bxcard "${BXS_CARDS[@]}" ;;
	midi) m := bxs_midis; read -ra ml <<< "$m"; dt_droplist "$w" "$r" "$c" cp_set_bxmidi "${ml[@]}" ;;
	esac
}

# --- the shelf folder dialog --------------------------------------------------

# One field: the folder, typed, a ~ meaning the home folder.
fn bxs_dialog(what = shelf) {
	local h=9 w=64 r c rid title="Games Folder"

	dt_dlgat "$h" "$w"
	r=$DT_DLGR c=$DT_DLGC h=$DT_DLGH w=$DT_DLGW
	[ "$what" = midi ] && title="MIDI Synth Folder"
	rid := dt_new "$title" "$h" "$w" "$r" "$c" bxfield
	BXF[$rid]["what"]=$what
	BXF[$rid]["path"]=$BX_SHELF
	[ "$what" = midi ] && BXF[$rid]["path"]=$BX_MIDIDIR
	BXF[$rid]["cur"]=${#BXF[$rid]["path"]}
	BXF[$rid]["focus"]=path
}

fn bxfield_draw(int id, int h, int w, int row, int col) {
	local f=${BXF[$id]["focus"]} on=0 cur=0

	dt_wclear "$id"
	console pen "$DT_INK" "$DT_FACE"
	if [ "${BXF[$id]["what"]}" = midi ]; then
		dt_tput "$id" 1 2 "The folder with your SoundFonts (.sf2) and Roland ROMs:"
	else
		dt_tput "$id" 1 2 "Games are kept in this folder, one NAME.boxer to a game:"
	fi
	[ "$f" = path ] && { on=1; cur=${BXF[$id]["cur"]}; }
	dt_textdraw "$id" 3 2 $((w - 4)) "${BXF[$id]["path"]}" "$cur" "$on"
	dt_wreg "$id" 3 2 $((w - 4)) path
	console pen "$DT_DIM" "$DT_FACE"
	if [ "${BXF[$id]["what"]}" = midi ]; then
		dt_tput "$id" 5 2 "MT32_CONTROL.ROM with MT32_PCM.ROM, ROM1.BIN, or a .sf2. Empty for none."
	else
		dt_tput "$id" 5 2 "It is made if it is not there. Games already in the old one stay there."
	fi
	dt_dlgbtns "$id" "$h" "$w" "$f" ok Save cancel Cancel
}

fn bxfield_ok(int id) {
	local p=${BXF[$id]["path"]}

	p=${p//[$'\t\n']/ }
	case $p in "~") p=$HOME ;; "~/"*) p="$HOME/${p#"~/"}" ;; esac
	if [ "${BXF[$id]["what"]}" = midi ]; then
		if [ -n "${p// /}" ] && [ ! -d "$p" ]; then
			dt_notep high "There is no such folder"
			return 0
		fi
		BX_MIDIDIR=$p
		cp_save
		dt_del "$id"
		return 0
	fi
	if [ -z "${p// /}" ]; then
		dt_notep high "A games folder is needed"
		return 0
	fi
	mkdir -p "$p" 2> /dev/null || {
		dt_notep high "Cannot make that folder"
		return 0
	}
	BX_SHELF=$p
	cp_save
	dt_del "$id"
}

fn bxfield_click(int id, int r, int c, btn = "") {
	local tag

	tag := dt_hit "$id" "$r" "$c"
	case $tag in
	path) BXF[$id]["focus"]=path; BXF[$id]["cur"]=${#BXF[$id]["path"]} ;;
	ok) bxfield_ok "$id" ;;
	cancel) dt_del "$id" ;;
	esac
	return 0
}

fn bxfield_key(int id, key) {
	local res f=${BXF[$id]["focus"]} d onb=1
	local -a o=(path ok cancel)

	[ "$f" = path ] && onb=0
	if d := dt_focuskey "$key" "$onb"; then
		BXF[$id]["focus"] := dt_focus "$f" "$d" "${o[@]}"
		[ "${BXF[$id]["focus"]}" = path ] && BXF[$id]["cur"]=${#BXF[$id]["path"]}
		return 0
	fi
	case $key in
	escape) dt_del "$id"; return 0 ;;
	enter)
		case $f in
		cancel) dt_del "$id" ;;
		*) bxfield_ok "$id" ;;
		esac
		return 0
		;;
	esac
	[ "$f" = path ] || return 0
	res := dt_textkey "${BXF[$id]["path"]}" "${BXF[$id]["cur"]}" "$key" || return 1
	BXF[$id]["path"]=${res% *}
	BXF[$id]["cur"]=${res##* }
	return 0
}

fn bxfield_close(int id) {
	unset "BXF[$id]"
}

fn bxfield_copy(int id) {
	local t

	[ "${BXF[$id]["focus"]}" = path ] || return 1
	t := dt_fieldsel || return 1
	ret "$t"
}

fn bxfield_cut(int id) {
	local t

	[ "${BXF[$id]["focus"]}" = path ] || return 1
	t := dt_fieldcut "$id" || return 1
	ret "$t"
}

fn bxfield_paste(int id, text, op = "") {
	local r

	BXF[$id]["focus"]=path
	r := dt_textpaste "${BXF[$id]["path"]}" "${BXF[$id]["cur"]}" "$text"
	BXF[$id]["path"]=${r% *}
	BXF[$id]["cur"]=${r##* }
}
